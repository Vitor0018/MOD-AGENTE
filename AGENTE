// JSON mínimo (parser + escape)
// ============================================================================

struct JV {
    enum Type { Null, Bool, Num, Str, Arr, Obj } type = Null;
    bool b = false;
    double n = 0;
    std::string s;
    std::vector<JV> arr;
    std::vector<std::string> keys;
    std::vector<JV> vals;

    const JV* Get(const char* k) const {
        if (type != Obj) return nullptr;
        for (size_t i = 0; i < keys.size(); ++i)
            if (keys[i] == k) return &vals[i];
        return nullptr;
    }
    const JV* At(size_t i) const {
        return (type == Arr && i < arr.size()) ? &arr[i] : nullptr;
    }
    std::string AsStr() const { return type == Str ? s : std::string(); }
};

void AppendUtf8(std::string& o, unsigned cp) {
    if (cp < 0x80) {
        o += static_cast<char>(cp);
    } else if (cp < 0x800) {
        o += static_cast<char>(0xC0 | (cp >> 6));
        o += static_cast<char>(0x80 | (cp & 0x3F));
    } else if (cp < 0x10000) {
        o += static_cast<char>(0xE0 | (cp >> 12));
        o += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
        o += static_cast<char>(0x80 | (cp & 0x3F));
    } else {
        o += static_cast<char>(0xF0 | (cp >> 18));
        o += static_cast<char>(0x80 | ((cp >> 12) & 0x3F));
        o += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
        o += static_cast<char>(0x80 | (cp & 0x3F));
    }
}

class JsonParser {
public:
    explicit JsonParser(const std::string& text) : m_t(text) {}

    bool Parse(JV& out) {
        SkipWs();
        return Value(out, 0);
    }

private:
    const std::string& m_t;
    size_t m_p = 0;

    void SkipWs() {
        while (m_p < m_t.size() &&
               (m_t[m_p] == ' ' || m_t[m_p] == '\n' || m_t[m_p] == '\r' ||
                m_t[m_p] == '\t'))
            ++m_p;
    }

    bool Hex4(unsigned& v) {
        if (m_p + 4 > m_t.size()) return false;
        v = 0;
        for (int i = 0; i < 4; ++i) {
            char c = m_t[m_p++];
            v <<= 4;
            if (c >= '0' && c <= '9') v |= static_cast<unsigned>(c - '0');
            else if (c >= 'a' && c <= 'f') v |= static_cast<unsigned>(c - 'a' + 10);
            else if (c >= 'A' && c <= 'F') v |= static_cast<unsigned>(c - 'A' + 10);
            else return false;
        }
        return true;
    }

    bool String(std::string& out) {
        if (m_p >= m_t.size() || m_t[m_p] != '"') return false;
        ++m_p;
        while (m_p < m_t.size()) {
            char c = m_t[m_p++];
            if (c == '"') return true;
            if (c != '\\') {
                out += c;
                continue;
            }
            if (m_p >= m_t.size()) return false;
            char e = m_t[m_p++];
            switch (e) {
                case '"': out += '"'; break;
                case '\\': out += '\\'; break;
                case '/': out += '/'; break;
                case 'b': out += '\b'; break;
                case 'f': out += '\f'; break;
                case 'n': out += '\n'; break;
                case 'r': out += '\r'; break;
                case 't': out += '\t'; break;
                case 'u': {
                    unsigned cp = 0;
                    if (!Hex4(cp)) return false;
                    if (cp >= 0xD800 && cp < 0xDC00 && m_p + 1 < m_t.size() &&
                        m_t[m_p] == '\\' && m_t[m_p + 1] == 'u') {
                        size_t save = m_p;
                        m_p += 2;
                        unsigned lo = 0;
                        if (Hex4(lo) && lo >= 0xDC00 && lo < 0xE000) {
                            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                        } else {
                            m_p = save;
                        }
                    }
                    AppendUtf8(out, cp);
                    break;
                }
                default: return false;
            }
        }
        return false;
    }

    bool Value(JV& v, int depth) {
        if (depth > 64 || m_p >= m_t.size()) return false;
        char c = m_t[m_p];
        if (c == '{') {
            ++m_p;
            v.type = JV::Obj;
            SkipWs();
            if (m_p < m_t.size() && m_t[m_p] == '}') {
                ++m_p;
                return true;
            }
            for (;;) {
                SkipWs();
                std::string key;
                if (!String(key)) return false;
                SkipWs();
                if (m_p >= m_t.size() || m_t[m_p] != ':') return false;
                ++m_p;
                SkipWs();
                JV child;
                if (!Value(child, depth + 1)) return false;
                v.keys.push_back(std::move(key));
                v.vals.push_back(std::move(child));
                SkipWs();
                if (m_p >= m_t.size()) return false;
                if (m_t[m_p] == ',') { ++m_p; continue; }
                if (m_t[m_p] == '}') { ++m_p; return true; }
                return false;
            }
        }
        if (c == '[') {
            ++m_p;
            v.type = JV::Arr;
            SkipWs();
            if (m_p < m_t.size() && m_t[m_p] == ']') {
                ++m_p;
                return true;
            }
            for (;;) {
                SkipWs();
                JV child;
                if (!Value(child, depth + 1)) return false;
                v.arr.push_back(std::move(child));
                SkipWs();
                if (m_p >= m_t.size()) return false;
                if (m_t[m_p] == ',') { ++m_p; continue; }
                if (m_t[m_p] == ']') { ++m_p; return true; }
                return false;
            }
        }
        if (c == '"') {
            v.type = JV::Str;
            return String(v.s);
        }
        if (m_t.compare(m_p, 4, "true") == 0) {
            v.type = JV::Bool; v.b = true; m_p += 4; return true;
        }
        if (m_t.compare(m_p, 5, "false") == 0) {
            v.type = JV::Bool; v.b = false; m_p += 5; return true;
        }
        if (m_t.compare(m_p, 4, "null") == 0) {
            v.type = JV::Null; m_p += 4; return true;
        }
        if (c == '-' || (c >= '0' && c <= '9')) {
            const char* start = m_t.c_str() + m_p;
            char* end = nullptr;
            double d = strtod(start, &end);
            if (end == start) return false;
            m_p += static_cast<size_t>(end - start);
            v.type = JV::Num;
            v.n = d;
            return true;
        }
        return false;
    }
};

std::string JStr(const std::string& s) {
    std::string o = "\"";
    for (unsigned char c : s) {
        switch (c) {
            case '"': o += "\\\""; break;
            case '\\': o += "\\\\"; break;
            case '\n': o += "\\n"; break;
            case '\r': o += "\\r"; break;
            case '\t': o += "\\t"; break;
            default:
                if (c < 0x20) {
                    char b[8];
                    snprintf(b, sizeof(b), "\\u%04x", c);
                    o += b;
                } else {
                    o += static_cast<char>(c);
                }
        }
    }
    o += '"';
    return o;
}

