bool IsComplexMultiTaskRequest(const std::wstring& raw) {
    const std::wstring t = Lower(Trim(raw));
    if (t.empty()) return false;
    int lineItems = 0;
    size_t start = 0;
    while (start < t.size()) {
        size_t end = t.find(L'\n', start);
        if (end == std::wstring::npos) end = t.size();
        std::wstring line = Trim(t.substr(start, end - start));
        if (StartsWithNoCase(line, L"- ") || StartsWithNoCase(line, L"* ") ||
            StartsWithNoCase(line, L"• ") || StartsWithNoCase(line, L"1. ") ||
            StartsWithNoCase(line, L"2. ") || StartsWithNoCase(line, L"3. ") ||
            StartsWithNoCase(line, L"4. ") || StartsWithNoCase(line, L"5. ")) ++lineItems;
        start = end + 1;
    }
    const std::vector<std::wstring> taskWords = {
        L"depois", L"também", L"tambem", L"além disso", L"alem disso", L"em seguida",
        L"crie", L"construa", L"implemente", L"corrija", L"pesquise", L"abra",
        L"execute", L"gere", L"edite", L"organize", L"analise", L"converta",
        L"salve", L"verifique", L"prepare", L"desenvolva", L"faça", L"faca"
    };
    int taskHits = 0;
    for (const auto& word : taskWords) if (t.find(word) != std::wstring::npos) ++taskHits;
    return t.size() >= 420 || lineItems >= 2 || (t.size() >= 180 && taskHits >= 3);
}

std::vector<const SpecialistProfile*> SelectSpecialists(const std::wstring& userText) {
    const std::wstring t = Lower(userText);
    const auto& profiles = SpecialistProfiles();
    struct ScoredProfile {
        const SpecialistProfile* profile;
        int score;
    };
    std::vector<ScoredProfile> matched;
    const bool requestReview = TextHasAny(t, {
        L"review", L"revisar", L"audite", L"auditoria", L"testar", L"testes",
        L"verifique", L"valide", L"qualidade", L"segurança", L"seguranca"
    });
    for (const auto& profile : profiles) {
        if (std::wstring(profile.id) == L"qa_reviewer" && !requestReview) continue;
        int score = 0;
        for (const auto& trigger : profile.triggers) {
            if (!trigger.empty() && t.find(trigger) != std::wstring::npos) ++score;
        }
        if (score > 0) matched.push_back({&profile, score});
    }
    std::stable_sort(matched.begin(), matched.end(), [](const ScoredProfile& a, const ScoredProfile& b) {
        return a.score > b.score;
    });
    std::vector<const SpecialistProfile*> selected;
    for (const auto& item : matched) {
        bool duplicate = false;
        for (const auto* already : selected) if (std::wstring(already->id) == item.profile->id) duplicate = true;
        if (!duplicate) selected.push_back(item.profile);
        if (selected.size() >= 3) break;
    }
    // For broad lists without obvious domain words, ensure there is still an
    // architecture/planning perspective. The final/main model is the coordinator.
    if (selected.empty()) selected.push_back(&profiles[1]);
    if (selected.size() < 2) {
        const bool alreadyReviewer = std::any_of(selected.begin(), selected.end(), [](const SpecialistProfile* p) {
            return std::wstring(p->id) == L"qa_reviewer";
        });
        if (alreadyReviewer) selected.push_back(&profiles[1]);
        else selected.push_back(&profiles.back()); // QA/reviewer
    }
    if (selected.size() > 3) selected.resize(3);
    return selected;
}

std::vector<Msg> BuildSpecialistHistory(const std::vector<Msg>& hist) {
    std::vector<Msg> focused;
    const size_t keep = 8;
    const size_t first = hist.size() > keep ? hist.size() - keep : 0;
    for (size_t i = first; i < hist.size(); ++i) {
        Msg m = hist[i];
        // Multi-agent consultation is skipped for active visual turns, so remove any
        // stale visual payloads to avoid accidental re-sends from earlier context.
        m.imageBase64.clear();
        m.attachedImageBase64.clear();
        focused.push_back(std::move(m));
    }
    return focused;
}

bool RunOneSpecialist(const Settings& modelCfg, const std::string& system,
                      const std::vector<Msg>& hist, std::string& answer) {
    Request req = BuildRequest(modelCfg, system, hist);
    if (!req.error.empty()) return false;
    HttpResult http = HttpPost(req.url, req.headers, req.body);
    if (!http.ok || http.status < 200 || http.status >= 300) return false;
    std::wstring error;
    std::string raw;
    if (!ExtractReply(modelCfg.provider, http.body, raw, error) || raw.empty()) return false;
    const std::wstring lower = Lower(FromUtf8(raw));
    if (lower.find(L"user safety:") != std::wstring::npos ||
        lower.find(L"assistant safety:") != std::wstring::npos ||
        lower.find(L"safety classification:") != std::wstring::npos) return false;
    // Bound specialist notes so a long response cannot explode the coordinator's
    // context. The cut is at a whitespace boundary to avoid breaking UTF-8 sequences.
    if (raw.size() > 2800) {
        size_t cut = raw.rfind(' ', 2600);
        if (cut == std::string::npos || cut < 1800) cut = 2600;
        raw.resize(cut);
        raw += " ...[resumo limitado]";
    }
    answer = std::move(raw);
    return true;
}

std::string RunMultiAgentConsultation(const Settings& cfg,
                                      const std::vector<Settings>& candidates,
                                      const std::vector<Msg>& history) {
    if (!cfg.multiAgentMode || candidates.empty()) return {};
    const std::wstring userText = LatestUserText(history);
    const bool hasImage = !history.empty() &&
        (!history.back().imageBase64.empty() || !history.back().attachedImageBase64.empty());
    // Avoid multiplying vision calls/quotas. Visual turns go straight to the selected
    // vision-capable model; multi-agent collaboration is reserved for large text tasks.
    if (hasImage || !IsComplexMultiTaskRequest(userText)) return {};

    const auto specialists = SelectSpecialists(userText);
    if (specialists.size() < 2) return {};
    const std::vector<Msg> focusedHistory = BuildSpecialistHistory(history);
    std::string notes;
    int completed = 0;
    for (size_t i = 0; i < specialists.size(); ++i) {
        const SpecialistProfile& sp = *specialists[i];
        // Use the same primary provider/model for all role-specific passes. This keeps
        // the user's manual selection intact and avoids sending the same task to several
        // different cloud providers just because Auto mode is enabled. The main request
        // still uses the normal fallback chain if it fails.
        const Settings& specialistCfg = candidates.front();
        std::string specialistSystem =
            "You are a specialized subagent inside a coordinated desktop assistant team.\n"
            "Your role name is: " + ToUtf8(sp.title) + ".\n"
            "Role-specific mission: " + ToUtf8(sp.persona) + "\n"
            "Analyze the user's COMPLETE request and the recent context. This is a separate consultation, not the final user response. "
            "Return in Portuguese, with at most 6 concise bullets: (1) your concrete contribution, (2) task/dependency order, "
            "(3) prerequisites or tools required, (4) risks/uncertainties, and (5) how success can be verified. "
            "Do not claim to have created files, browsed, clicked, tested, or executed anything. Do not generate executable Windows actions. "
            "Do not replace the user's overall goal with your specialist subgoal. Help the coordinator complete the shared task. "
            "Clearly label anything that cannot be performed with the tools currently available. Keep output under roughly 700 words.";
        std::string answer;
        if (!RunOneSpecialist(specialistCfg, specialistSystem, focusedHistory, answer)) break;
        if (!notes.empty()) notes += "\n\n";
        notes += "[AGENTE ESPECIALISTA: " + ToUtf8(sp.title) + "]\n" + answer;
        ++completed;
    }
    // If fewer than two subagents responded, leave the request to the normal agent
    // instead of presenting the single consultation as multi-agent collaboration.
    if (completed < 2) return {};
    return "MULTI-AGENT TEAM CONSULTATIONS (internal; do not reveal unless asked):\n"
           "The following specialists independently reviewed the same goal. Integrate their useful insights, reconcile disagreements, retain the user's full checklist, and let the main coordinator decide and execute only supported tools. Specialist notes are suggestions, not proof of completed work.\n\n" + notes;
}

DWORD WINAPI AiThread(LPVOID param) {
    std::unique_ptr<Job> job(static_cast<Job*>(param));
    auto* result = new AiResult();

    std::vector<Settings> candidates;
    const bool hasImage = !job->hist.empty() && (!job->hist.back().imageBase64.empty() || !job->hist.back().attachedImageBase64.empty());
    auto addCandidate = [&](Provider provider, const std::wstring& key,
                            const std::wstring& model, const std::wstring& customBase = L"") {
        if (key.empty()) return;
        Settings c = job->cfg;
        c.provider = provider;
        c.apiKey = key;
        c.model = model;
        if (!customBase.empty()) c.customBase = customBase;
        // Do not repeatedly call the exact same provider/key/model tuple.
        for (const auto& existing : candidates) {
            if (existing.provider == c.provider && existing.apiKey == c.apiKey &&
                existing.model == c.model && existing.customBase == c.customBase) return;
        }
        candidates.push_back(std::move(c));
    };

    if (job->cfg.provider == Provider::Auto) {
        // In automatic mode, each provider always receives its own known model ID.
        // A manually entered model belongs to the explicitly selected provider; it
        // must never be sent unchanged to Gemini, OpenAI, NVIDIA and Anthropic alike.
        if (hasImage) {
            addCandidate(Provider::Gemini, job->cfg.geminiKey, L"gemini-3.6-flash");
            addCandidate(Provider::OpenAI, job->cfg.openaiKey, L"gpt-4o-mini");
            addCandidate(Provider::Nvidia, job->cfg.nvidiaKey, L"meta/llama-3.2-11b-vision-instruct");
            addCandidate(Provider::Anthropic, job->cfg.anthropicKey, L"claude-sonnet-5");
            // The free OpenRouter alias is last because its resolved model may not
            // support images; API-side capability errors then fall through safely.
            addCandidate(Provider::Custom, job->cfg.openrouterKey, L"openrouter/free", L"https://openrouter.ai/api/v1");
        } else {
            addCandidate(Provider::Custom, job->cfg.groqKey, L"openai/gpt-oss-120b", L"https://api.groq.com/openai/v1");
            addCandidate(Provider::Custom, job->cfg.openrouterKey, L"openrouter/free", L"https://openrouter.ai/api/v1");
            addCandidate(Provider::OpenAI, job->cfg.openaiKey, L"gpt-4o-mini");
            addCandidate(Provider::Gemini, job->cfg.geminiKey, L"gemini-3.6-flash");
            addCandidate(Provider::Nvidia, job->cfg.nvidiaKey, L"meta/llama-3.2-11b-vision-instruct");
            addCandidate(Provider::Anthropic, job->cfg.anthropicKey, L"claude-sonnet-5");
        }
        // A custom endpoint is only considered when the user configured both its
        // base URL and model ID; it remains an additional candidate, not the default.
        if (!job->cfg.customKey.empty() && !job->cfg.customBase.empty() && !job->cfg.model.empty())
            addCandidate(Provider::Custom, job->cfg.customKey, job->cfg.model, job->cfg.customBase);
    } else {
        candidates.push_back(job->cfg);
    }

    if (job->cfg.autoFallback && job->cfg.provider != Provider::Auto) {
        // Fallback is explicit in settings. For visual requests, only try known
        // multimodal defaults first; do not send screenshots to the text-only Groq default.
        if (hasImage) {
            addCandidate(Provider::Gemini, job->cfg.geminiKey, L"gemini-3.6-flash");
            addCandidate(Provider::OpenAI, job->cfg.openaiKey, L"gpt-4o-mini");
            addCandidate(Provider::Nvidia, job->cfg.nvidiaKey, L"meta/llama-3.2-11b-vision-instruct");
            addCandidate(Provider::Anthropic, job->cfg.anthropicKey, L"claude-sonnet-5");
            addCandidate(Provider::Custom, job->cfg.openrouterKey, L"openrouter/free", L"https://openrouter.ai/api/v1");
        } else {
            addCandidate(Provider::Custom, job->cfg.groqKey, L"openai/gpt-oss-120b", L"https://api.groq.com/openai/v1");
            addCandidate(Provider::Custom, job->cfg.openrouterKey, L"openrouter/free", L"https://openrouter.ai/api/v1");
            addCandidate(Provider::OpenAI, job->cfg.openaiKey, L"gpt-4o-mini");
            addCandidate(Provider::Gemini, job->cfg.geminiKey, L"gemini-3.6-flash");
            addCandidate(Provider::Nvidia, job->cfg.nvidiaKey, L"meta/llama-3.2-11b-vision-instruct");
            addCandidate(Provider::Anthropic, job->cfg.anthropicKey, L"claude-sonnet-5");
        }
    }

    // On complex text-only tasks, consult a small, task-routed team of specialist
    // agents first. The normal model call remains the coordinator and emits the
    // existing JSON reply/actions understood by the Windows executor.
    if (!hasImage && !candidates.empty()) {
        std::string teamNotes = RunMultiAgentConsultation(job->cfg, candidates, job->hist);
        if (!teamNotes.empty()) {
            job->system += "\n\n" + teamNotes +
                "\n\nCOORDINATOR REQUIREMENT: execute the original user's complete request where supported; do not merely summarize the specialists' ideas. Keep all requested subtasks in scope, respect dependencies, batch actions, verify results, and honestly identify unsupported tasks. Return the normal required JSON object.\n";
        }
    }

    std::wstring lastError = L"Nenhum provedor de IA disponível.";
    bool sawVisionDenial = false;
    bool sawImageEncodingFailure = false;

    // In manual-provider mode, do not silently change models when a known text-only
    // model was explicitly selected for a visual task. The error is returned to the
    // user so they can authorize a different model or switch to Automatic mode.
    if (hasImage && job->cfg.provider != Provider::Auto &&
        IsKnownTextOnlyModel(job->cfg)) {
        result->needsVisionFallbackConsent = true;
        result->error = L"O modelo escolhido nas configurações é somente texto e não aceita imagens.";
        if (!PostMessageW(job->hwnd, WM_APP_AI_RESULT, 0, reinterpret_cast<LPARAM>(result)))
            delete result;
        return 0;
    }

    for (size_t i = 0; i < candidates.size(); ++i) {
        const Settings& cfg = candidates[i];
        std::wstring attemptError;
        std::string reply;
        bool ok = false;

        if (hasImage && IsKnownTextOnlyModel(cfg)) {
            attemptError = L"O modelo é somente texto e não pode analisar imagens.";
        } else {
            Request req = BuildRequest(cfg, job->system, job->hist);
            if (!req.error.empty()) {
                attemptError = req.error;
            } else {
                // A screenshot must be encoded as a real image part for the selected API.
                const bool imageEncoded = !hasImage ||
                    (cfg.provider == Provider::Gemini
                        ? req.body.find("\"inline_data\"") != std::string::npos
                        : cfg.provider == Provider::Anthropic
                            ? req.body.find("\"type\":\"image\"") != std::string::npos
                            : req.body.find("\"image_url\"") != std::string::npos ||
                              req.body.find("\"inline_data\"") != std::string::npos);

                if (hasImage && !imageEncoded) {
                    sawImageEncodingFailure = true;
                    attemptError = L"A imagem foi capturada, mas não foi codificada na requisição para este provedor.";
                    if (job->cfg.provider != Provider::Auto && i == 0)
                        result->needsVisionFallbackConsent = true;
                } else {
                    HttpResult http = HttpPost(req.url, req.headers, req.body);
                    if (!http.ok) {
                        attemptError = http.error;
                    } else if (http.status < 200 || http.status >= 300) {
                        std::wstring msg;
                        JV v;
                        JsonParser parser(http.body);
                        if (parser.Parse(v)) msg = ErrorMessage(v);
                        if (msg.empty()) msg = FromUtf8(http.body.substr(0, 300));
                        attemptError = L"HTTP " + std::to_wstring(http.status) + L": " + msg;
                        if (hasImage && job->cfg.provider != Provider::Auto && i == 0 && IsImageCapabilityError(attemptError))
                            result->needsVisionFallbackConsent = true;
                    } else {
                        std::wstring err;
                        if (ExtractReply(cfg.provider, http.body, reply, err)) {
                            if (hasImage && IsVisionAccessDenialPayload(reply)) {
                                sawVisionDenial = true;
                                attemptError = L"O modelo afirmou que não consegue ver a imagem, apesar de ela ter sido enviada.";
                                if (job->cfg.provider != Provider::Auto) result->needsVisionFallbackConsent = true;
                            } else if (HasExpectedAgentPayload(reply)) {
                                ok = true;
                            } else {
                                attemptError = L"O provedor retornou texto fora do formato esperado pelo agente.";
                            }
                        } else {
                            attemptError = err;
                        }
                    }
                }
            }
        }

        if (ok) {
            result->ok = true;
            result->text = std::move(reply);
            break;
        }

        lastError = attemptError.empty() ? L"Falha sem detalhes retornados pelo provedor." : attemptError;
        // In a manually selected mode, do not silently switch models after a visual refusal.
        if (result->needsVisionFallbackConsent) break;
        // The next iteration uses a different, deduplicated candidate.
    }

    if (!result->ok) {
        result->error = lastError;
        if (hasImage && (sawVisionDenial || sawImageEncodingFailure)) {
            result->error = L"A captura foi criada, mas os modelos configurados não conseguiram analisá-la corretamente. Verifique as chaves e escolha um modelo com visão; nenhuma descrição da tela foi inventada.";
        }
    }
    if (!PostMessageW(job->hwnd, WM_APP_AI_RESULT, 0, reinterpret_cast<LPARAM>(result)))
        delete result;
    return 0;
}

