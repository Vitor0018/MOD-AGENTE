// Histórico persistente: registra conversa e ações em Documentos sem depender
// da janela do chat permanecer aberta. O arquivo é texto UTF-8 e recebe novas linhas.
std::wstring HistoryLogPath() {
    // Use SHGetFolderPathW/CSIDL_PERSONAL to avoid a link-time dependency on
    // the external FOLDERID_Documents GUID symbol (which may be unavailable
    // in the Windhawk clang/lld link environment).
    wchar_t docs[MAX_PATH]{};
    if (FAILED(SHGetFolderPathW(nullptr, CSIDL_PERSONAL, nullptr,
                                SHGFP_TYPE_CURRENT, docs)) || !docs[0]) {
        return L"";
    }
    std::wstring path = docs;
    if (!path.empty() && path.back() != L'\\' && path.back() != L'/') path += L'\\';
    path += L"AI-Agent-Bubble-Historico.txt";
    return path;
}

void AppendHistoryLog(const std::wstring& category, const std::wstring& content) {
    const std::wstring path = HistoryLogPath();
    if (path.empty()) return;
    HANDLE file = CreateFileW(path.c_str(), FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE,
                              nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (file == INVALID_HANDLE_VALUE) return;
    LARGE_INTEGER size{};
    const bool emptyFile = GetFileSizeEx(file, &size) && size.QuadPart == 0;
    if (emptyFile) {
        const unsigned char bom[3] = {0xEF, 0xBB, 0xBF};
        DWORD written = 0; WriteFile(file, bom, 3, &written, nullptr);
    }
    SYSTEMTIME st{}; GetLocalTime(&st);
    wchar_t stamp[64]{};
    swprintf_s(stamp, L"\r\n[%04u-%02u-%02u %02u:%02u:%02u] [%s]\r\n",
        st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond, category.c_str());
    std::wstring block = stamp;
    block += content;
    block += L"\r\n";
    const int bytesNeeded = WideCharToMultiByte(CP_UTF8, 0, block.c_str(), (int)block.size(), nullptr, 0, nullptr, nullptr);
    if (bytesNeeded > 0) {
        std::string utf8((size_t)bytesNeeded, '\0');
        WideCharToMultiByte(CP_UTF8, 0, block.c_str(), (int)block.size(), utf8.data(), bytesNeeded, nullptr, nullptr);
        DWORD written = 0; WriteFile(file, utf8.data(), (DWORD)utf8.size(), &written, nullptr);
    }
    CloseHandle(file);
}

void AppendText(const std::wstring& t) {
    if (t.rfind(L"Você: ", 0) == 0) AppendHistoryLog(L"USUÁRIO", t.substr(6));
    if (!g_history) return;
    int len = GetWindowTextLengthW(g_history);
    SendMessageW(g_history, EM_SETSEL, len, len);
    // Plain appends always reset the insertion style so bold Markdown never leaks
    // into later labels, tool notes, or user messages.
    CHARFORMAT2W cf{};
    cf.cbSize = sizeof(cf);
    cf.dwMask = CFM_BOLD | CFM_ITALIC | CFM_UNDERLINE;
    cf.dwEffects = 0;
    SendMessageW(g_history, EM_SETCHARFORMAT, SCF_SELECTION, reinterpret_cast<LPARAM>(&cf));
    SendMessageW(g_history, EM_REPLACESEL, FALSE, reinterpret_cast<LPARAM>(t.c_str()));
    SendMessageW(g_history, EM_SCROLLCARET, 0, 0);
}

void AppendMarkdownText(const std::wstring& text) {
    if (!g_history || text.empty()) return;
    auto appendSegment = [](const std::wstring& segment, bool bold) {
        if (segment.empty()) return;
        int len = GetWindowTextLengthW(g_history);
        SendMessageW(g_history, EM_SETSEL, len, len);
        CHARFORMAT2W cf{};
        cf.cbSize = sizeof(cf);
        cf.dwMask = CFM_BOLD | CFM_ITALIC | CFM_UNDERLINE;
        cf.dwEffects = bold ? CFE_BOLD : 0;
        SendMessageW(g_history, EM_SETCHARFORMAT, SCF_SELECTION, reinterpret_cast<LPARAM>(&cf));
        SendMessageW(g_history, EM_REPLACESEL, FALSE, reinterpret_cast<LPARAM>(segment.c_str()));
    };

    size_t pos = 0;
    while (pos < text.size()) {
        size_t open = text.find(L"**", pos);
        if (open == std::wstring::npos) {
            appendSegment(text.substr(pos), false);
            break;
        }
        appendSegment(text.substr(pos, open - pos), false);
        size_t close = text.find(L"**", open + 2);
        if (close == std::wstring::npos) {
            appendSegment(text.substr(open), false); // unmatched marker stays literal
            break;
        }
        appendSegment(text.substr(open + 2, close - (open + 2)), true);
        pos = close + 2;
    }
    // Reset the insertion point to normal text for all subsequent appends.
    int len = GetWindowTextLengthW(g_history);
    SendMessageW(g_history, EM_SETSEL, len, len);
    CHARFORMAT2W reset{};
    reset.cbSize = sizeof(reset);
    reset.dwMask = CFM_BOLD | CFM_ITALIC | CFM_UNDERLINE;
    reset.dwEffects = 0;
    SendMessageW(g_history, EM_SETCHARFORMAT, SCF_SELECTION, reinterpret_cast<LPARAM>(&reset));
    SendMessageW(g_history, EM_SCROLLCARET, 0, 0);
}

std::wstring StripMarkdownForSpeech(std::wstring text) {
    size_t pos = 0;
    while ((pos = text.find(L"**", pos)) != std::wstring::npos) text.erase(pos, 2);
    pos = 0;
    while ((pos = text.find(L"__", pos)) != std::wstring::npos) text.erase(pos, 2);
    return text;
}

void AppendAssistantReply(const std::wstring& reply) {
