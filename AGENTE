void ApplyBubbleShape() {
    int sz = S(g_cfg.bubbleSize);
    SetWindowPos(g_bubble, nullptr, 0, 0, sz, sz,
                 SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
    SetWindowRgn(g_bubble, CreateEllipticRgn(0, 0, sz + 1, sz + 1), TRUE);
}

void ClampBubble() {
    RECT r;
    GetWindowRect(g_bubble, &r);
    HMONITOR mon = MonitorFromRect(&r, MONITOR_DEFAULTTONEAREST);
    MONITORINFO mi = {sizeof(mi)};
    GetMonitorInfoW(mon, &mi);
    int x = ClampInt(r.left, mi.rcWork.left, mi.rcWork.right - (r.right - r.left));
    int y = ClampInt(r.top, mi.rcWork.top, mi.rcWork.bottom - (r.bottom - r.top));
    SetWindowPos(g_bubble, HWND_TOPMOST, x, y, 0, 0, SWP_NOSIZE | SWP_NOACTIVATE);
}

void SaveBubblePos() {
    RECT r;
    GetWindowRect(g_bubble, &r);
    Wh_SetIntValue(L"bubbleX", r.left);
    Wh_SetIntValue(L"bubbleY", r.top);
}

void PlaceBubbleInitial() {
    int sz = S(g_cfg.bubbleSize);
    int x = Wh_GetIntValue(L"bubbleX", INT_MIN);
    int y = Wh_GetIntValue(L"bubbleY", INT_MIN);
    POINT pt = {x, y};
    if (x == INT_MIN || y == INT_MIN || !MonitorFromPoint(pt, MONITOR_DEFAULTTONULL)) {
        RECT work = {};
        SystemParametersInfoW(SPI_GETWORKAREA, 0, &work, 0);
        x = work.right - sz - S(24);
        y = work.bottom - sz - S(80);
    }
    SetWindowPos(g_bubble, HWND_TOPMOST, x, y, 0, 0, SWP_NOSIZE | SWP_NOACTIVATE);
    ClampBubble();
}

void PaintBubble(HWND h) {
    PAINTSTRUCT ps;
    HDC dc = BeginPaint(h, &ps);
    RECT rc;
    GetClientRect(h, &rc);
    int W = rc.right, H = rc.bottom;
    HDC mem = CreateCompatibleDC(dc);
    HBITMAP bmp = CreateCompatibleBitmap(dc, W, H);
    HGDIOBJ old = SelectObject(mem, bmp);

    COLORREF col = g_listening ? RGB(34, 197, 94) :
                   (g_busy ? RGB(245, 158, 11) :
                   (g_speaking.load() ? RGB(6, 182, 212) :
                   (g_hover ? RGB(129, 140, 248) : kAccent)));
    FillSolid(mem, rc, col);
    RECT avatarRect = {S(2), S(2), W - S(2), H - S(2)};
    bool hasAvatar = DrawAvatar(mem, avatarRect, true);

    int pulse = 1 + static_cast<int>((GetTickCount() / 140) % 3);
    COLORREF ringColor = g_listening ? RGB(187, 247, 208) :
                         (g_busy ? RGB(253, 230, 138) :
                         (g_speaking.load() ? RGB(165, 243, 252) : RGB(199, 210, 254)));
    HPEN pen = CreatePen(PS_SOLID, std::max(1, S(pulse)), ringColor);
    HGDIOBJ op = SelectObject(mem, pen);
    HGDIOBJ ob = SelectObject(mem, GetStockObject(NULL_BRUSH));
    int mg = S(3);
    Ellipse(mem, mg, mg, W - mg, H - mg);
    SelectObject(mem, ob);
    SelectObject(mem, op);
    DeleteObject(pen);

    HFONT f = CreateFontW(-H / 2, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET,
                    OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, ANTIALIASED_QUALITY,
                    DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI Symbol");
    HGDIOBJ of = SelectObject(mem, f);
    SetBkMode(mem, TRANSPARENT);
    SetTextColor(mem, RGB(255, 255, 255));
    if (!hasAvatar)
        DrawTextW(mem, L"\u2726", -1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
    SelectObject(mem, of);
    DeleteObject(f);

    BitBlt(dc, 0, 0, W, H, mem, 0, 0, SRCCOPY);
    SelectObject(mem, old);
    DeleteObject(bmp);
    DeleteDC(mem);
    EndPaint(h, &ps);
}

void ShowBubbleMenu(HWND h) {
    HMENU menu = CreatePopupMenu();
    if (!menu) return;
    AppendMenuW(menu, MF_STRING, 1, IsWindowVisible(g_panel) ? L"Fechar chat" : L"Abrir chat");
    AppendMenuW(menu, MF_STRING, 2, L"Nova conversa");
    AppendMenuW(menu, MF_SEPARATOR, 0, nullptr);
    std::wstring prov = L"Provedor: " + std::wstring(InfoFor(g_cfg.provider).label) +
                        L" (altere nas configurações do mod)";
    AppendMenuW(menu, MF_STRING | MF_GRAYED, 3, prov.c_str());
    POINT pt;
    GetCursorPos(&pt);
    SetForegroundWindow(h);
    UINT cmd = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, pt.x, pt.y, 0, h, nullptr);
    PostMessageW(h, WM_NULL, 0, 0);
    DestroyMenu(menu);
    if (cmd == 1) TogglePanel();
    else if (cmd == 2 && !g_busy) ResetChat();
}

void StartSiteSearchReview();

LRESULT CALLBACK BubbleProc(HWND h, UINT m, WPARAM w, LPARAM l) {
    switch (m) {
        case WM_DROPFILES:
            AddDroppedFilesFromHdrop(reinterpret_cast<HDROP>(w));
            if (g_panel && !IsWindowVisible(g_panel)) ShowPanel();
            return 0;
        case WM_ERASEBKGND:
            return 1;
        case WM_PAINT:
            PaintBubble(h);
            return 0;
        case WM_MOUSEACTIVATE:
            return MA_NOACTIVATE;
        case WM_TIMER:
            if (w == 1) {
                InvalidateRect(h, nullptr, FALSE);
                if (g_panel && IsWindowVisible(g_panel)) InvalidateRect(g_panel, nullptr, FALSE);
            } else if (w == 2) {
                g_listening = false;
                KillTimer(h, 2);
                InvalidateRect(h, nullptr, FALSE);
            } else if (w == 3) {
                KillTimer(h, 3);
                if (g_pendingSiteReview) {
                    if (g_busy) {
                        if (!SetTimer(h, 3, 1500, nullptr)) {
                            g_pendingSiteReview = false;
                            const std::wstring m = L"Não consegui agendar a leitura dos resultados do site.";
                            if (g_actionChainActive) FinishActionChain(m);
                            else AppendText(L"[Busca] " + m + L"\r\n\r\n");
                        }
                    } else StartSiteSearchReview();
                }
            } else if (w == 4) {
                KillTimer(h, 4);
                if (g_pendingScreenReview) {
                    if (g_busy) {
                        if (!SetTimer(h, 4, 1500, nullptr)) {
                            g_pendingScreenReview = false;
                            g_pendingScreenInstruction.clear();
                            const std::wstring m = L"Não consegui agendar a verificação visual da tela.";
                            if (g_actionChainActive) FinishActionChain(m);
                            else AppendText(L"[Visão] " + m + L"\r\n\r\n");
                        }
                    } else StartScreenReview();
                }
            }
            return 0;
        case WM_APP + 3:
            InvalidateRect(h, nullptr, FALSE);
            if (g_panel && IsWindowVisible(g_panel)) InvalidateRect(g_panel, nullptr, FALSE);
            return 0;
        case WM_APP_WAKEWORD: {
            // Ativação totalmente mãos-livres: não envia Win+H e não exige clicar no chat.
            ShowPanel();
            g_listening = true;
            if (g_bubble) SetTimer(g_bubble, 2, 20000, nullptr);
            if (g_bubble) InvalidateRect(g_bubble, nullptr, FALSE);
            const std::wstring greeting = L"Oi, como posso ajudar?";
            AppendAssistantReply(greeting);
            SpeakReply(StripMarkdownForSpeech(greeting));
            return 0;
        }
        case WM_APP_WAKEWORD_STATUS: {
            std::unique_ptr<std::wstring> status(reinterpret_cast<std::wstring*>(l));
            if (status && !status->empty()) {
                ShowPanel();
                AppendAssistantReply(*status);
            }
            return 0;
        }
        case WM_APP_VOICE_COMMAND: {
            std::unique_ptr<std::wstring> command(reinterpret_cast<std::wstring*>(l));
            if (!command || Trim(*command).empty()) return 0;
            g_listening = false;
            KillTimer(h, 2);
            const std::wstring text = Trim(*command);
            ShowPanel();
            if (g_busy) {
                const std::wstring busyReply = L"Ainda estou terminando a tarefa anterior. Diga Bruce novamente quando eu estiver pronta.";
                AppendAssistantReply(busyReply);
                SpeakReply(StripMarkdownForSpeech(busyReply));
                return 0;
            }
            if (g_input) SetWindowTextW(g_input, text.c_str());
            SendFromInput();
            return 0;
        }
        case WM_LBUTTONDBLCLK:
            SetCapture(h);
            g_suppressBubbleDoubleClickUp = true;
            g_dragging = false;
            StartVoiceCommand();
            return 0;
        case WM_LBUTTONDOWN: {
            SetCapture(h);
            g_dragging = false;
            GetCursorPos(&g_downScreen);
            RECT r;
            GetWindowRect(h, &r);
            g_downOrigin = {r.left, r.top};
            return 0;
        }
        case WM_MOUSEMOVE: {
            if (!g_hover) {
                g_hover = true;
                TRACKMOUSEEVENT tme = {sizeof(tme), TME_LEAVE, h, 0};
                TrackMouseEvent(&tme);
                InvalidateRect(h, nullptr, FALSE);
            }
            if (GetCapture() == h) {
                POINT p;
                GetCursorPos(&p);
                int dx = p.x - g_downScreen.x, dy = p.y - g_downScreen.y;
                if (!g_dragging && (abs(dx) > S(4) || abs(dy) > S(4))) g_dragging = true;
                if (g_dragging)
                    SetWindowPos(h, HWND_TOPMOST, g_downOrigin.x + dx, g_downOrigin.y + dy,
                                 0, 0, SWP_NOSIZE | SWP_NOACTIVATE);
            }
            return 0;
        }
        case WM_MOUSELEAVE:
            g_hover = false;
            InvalidateRect(h, nullptr, FALSE);
            return 0;
        case WM_LBUTTONUP: {
            if (g_suppressBubbleDoubleClickUp) {
                g_suppressBubbleDoubleClickUp = false;
                if (GetCapture() == h) ReleaseCapture();
                return 0;
            }
            if (GetCapture() == h) {
                ReleaseCapture();
                if (g_dragging) {
                    ClampBubble();
                    SaveBubblePos();
                    if (IsWindowVisible(g_panel)) PositionPanel();
                } else {
                    TogglePanel();
                }
                g_dragging = false;
            }
            return 0;
        }
        case WM_RBUTTONUP:
            ShowBubbleMenu(h);
            return 0;
        case WM_APP_RELOAD:
            LoadSettings();
            RestartWakeWordListener();
            g_avatarCache.clear();
            ApplyBubbleShape();
            ClampBubble();
            InvalidateRect(h, nullptr, FALSE);
            if (g_panel) InvalidateRect(g_panel, nullptr, FALSE);
            return 0;
        case WM_CLOSE:
            if (g_panel) DestroyWindow(g_panel);
            g_panel = nullptr;
            DestroyWindow(h);
            return 0;
        case WM_DESTROY:
            PostQuitMessage(0);
            return 0;
    }
    return DefWindowProcW(h, m, w, l);
}

