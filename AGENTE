        L"    exit 1\r\n"
        L"  }\r\n"
        L"} finally {\r\n"
        L"  if ($pres -ne $null) { try { $pres.Close() } catch {}; [void][Runtime.InteropServices.Marshal]::ReleaseComObject($pres) }\r\n"
