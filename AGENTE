bool IsSafeBareName(const std::wstring& n) {
    if (n.empty() || n.size() > 60) return false;
    for (wchar_t c : n) {
        bool ok = iswalnum(c) || c == L' ' || c == L'.' || c == L'_' || c == L'-';
        if (!ok) return false;
    }
    std::wstring l = Lower(n);
    static const wchar_t* bad[] = {L".bat", L".cmd", L".ps1", L".vbs", L".vbe", L".js",
                                   L".jse", L".wsf", L".hta", L".scr", L".reg", L".msi",
                                   L".pif", L".jar"};
    for (auto* ext : bad) {
        size_t e = wcslen(ext);
        if (l.size() >= e && l.compare(l.size() - e, e, ext) == 0) return false;
    }
    return true;
}

bool OpenApp(const std::wstring& target, std::wstring& info) {
    std::wstring name = Trim(target);
    std::wstring lower = Lower(name);
    if (lower.empty()) {
        info = L"Nome do app vazio.";
        return false;
    }
    EnsureAppIndex();

    if (const AppEntry* e = FindAppExact(lower)) {
        if (ShellOpen(e->path)) { info = L"Abrindo app: " + e->name; return true; }
    }
    for (const auto& a : kAliases) {
        if (lower == a.name) {
            if (ShellOpen(a.target)) { info = L"Abrindo app: " + name; return true; }
            break;
        }
    }
    if (const AppEntry* e = FindAppFuzzy(lower)) {
        if (ShellOpen(e->path)) { info = L"Abrindo app: " + e->name; return true; }
    }
    if (IsSafeBareName(name) && ShellOpen(name)) {
        info = L"Abrindo app: " + name;
        return true;
    }
    info = L"Não encontrei o app \"" + name + L"\".";
    return false;
}

bool OpenUrl(const std::wstring& raw, std::wstring& info) {
    std::wstring url = Trim(raw);
    if (url.empty() || url.find_first_of(L" \t\r\n\"<>") != std::wstring::npos) {
        info = L"URL inválida.";
        return false;
    }
    if (!StartsWithNoCase(url, L"http://") && !StartsWithNoCase(url, L"https://")) {
        if (url.find(L"://") != std::wstring::npos || StartsWithNoCase(url, L"javascript:") ||
            StartsWithNoCase(url, L"file:") || StartsWithNoCase(url, L"data:")) {
            info = L"Só são permitidos links http/https.";
            return false;
        }
        url = L"https://" + url;
    }
    if (!ShellOpen(url)) {
        info = L"Não consegui abrir o site.";
        return false;
    }
    info = L"Abrindo site: " + url;
    return true;
}

struct SiteSearchEntry {
    const wchar_t* name;
    const wchar_t* aliases; // aliases separated by '|'
    const wchar_t* urlPrefix;
    const wchar_t* urlSuffix;
};

bool AliasMatches(const std::wstring& input, const wchar_t* aliases) {
    const std::wstring normalized = Lower(Trim(input));
    std::wstring a = aliases ? aliases : L"";
    size_t start = 0;
    while (start < a.size()) {
        size_t end = a.find(L'|', start);
        if (end == std::wstring::npos) end = a.size();
        std::wstring token = Lower(Trim(a.substr(start, end - start)));
        if (!token.empty()) {
            size_t pos = normalized.find(token);
            while (pos != std::wstring::npos) {
                const bool leftBoundary = pos == 0 || !std::iswalnum(normalized[pos - 1]);
                const size_t after = pos + token.size();
                const bool rightBoundary = after >= normalized.size() || !std::iswalnum(normalized[after]);
                if (leftBoundary && rightBoundary) return true;
                pos = normalized.find(token, pos + 1);
            }
        }
        start = end + 1;
    }
    return false;
}

