void ScanDir(const std::wstring& dir, std::vector<AppEntry>& out, int depth) {
    WIN32_FIND_DATAW fd;
    HANDLE h = FindFirstFileW((dir + L"\\*").c_str(), &fd);
    if (h == INVALID_HANDLE_VALUE) return;
    do {
        if (fd.cFileName[0] == L'.' &&
            (fd.cFileName[1] == 0 || (fd.cFileName[1] == L'.' && fd.cFileName[2] == 0)))
            continue;
        std::wstring full = dir + L"\\" + fd.cFileName;
        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
            if (depth < 4 && !(fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT))
                ScanDir(full, out, depth + 1);
        } else {
            size_t n = wcslen(fd.cFileName);
            if (n > 4 && _wcsicmp(fd.cFileName + n - 4, L".lnk") == 0) {
                AppEntry e;
                e.name.assign(fd.cFileName, n - 4);
                e.lower = Lower(e.name);
                if (e.lower.find(L"uninstall") != std::wstring::npos ||
                    e.lower.find(L"desinstal") != std::wstring::npos)
                    continue;
                e.path = full;
                out.push_back(std::move(e));
            }
        }
    } while (FindNextFileW(h, &fd));
    FindClose(h);
}

void EnsureAppIndex() {
    ULONGLONG now = GetTickCount64();
    if (!g_apps.empty() && now - g_appsScanTime < 10 * 60 * 1000) return;
    std::vector<AppEntry> found;
    WCHAR path[MAX_PATH];
    int folders[] = {CSIDL_COMMON_PROGRAMS, CSIDL_PROGRAMS};
    for (int csidl : folders) {
        if (SUCCEEDED(SHGetFolderPathW(nullptr, csidl, nullptr, 0, path)))
            ScanDir(path, found, 0);
    }
    std::sort(found.begin(), found.end(), [](const AppEntry& a, const AppEntry& b) {
        return a.lower < b.lower;
    });
    found.erase(std::unique(found.begin(), found.end(),
                            [](const AppEntry& a, const AppEntry& b) {
                                return a.lower == b.lower;
                            }),
                found.end());
    g_apps = std::move(found);
    g_appsScanTime = now;
}

const AppEntry* FindAppExact(const std::wstring& lower) {
    for (const auto& e : g_apps)
        if (e.lower == lower) return &e;
    return nullptr;
}

const AppEntry* FindAppFuzzy(const std::wstring& lower) {
    const AppEntry* best = nullptr;
    for (const auto& e : g_apps) {
        bool hit = e.lower.find(lower) != std::wstring::npos ||
                   (e.lower.size() >= 4 && lower.find(e.lower) != std::wstring::npos);
        if (hit && (!best || e.lower.size() < best->lower.size())) best = &e;
    }
    return best;
}

