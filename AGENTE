DWORD WINAPI UiThread(LPVOID) {
    if (!SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2))
        SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE);
    HRESULT co = CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
    Gdiplus::GdiplusStartupInput uiGdipInput;
    g_uiGdipReady = Gdiplus::GdiplusStartup(&g_uiGdipToken, &uiGdipInput, nullptr) == Gdiplus::Ok;
    g_dpi = static_cast<int>(GetDpiForSystem());
    if (g_dpi <= 0) g_dpi = 96;

    LoadSettings();
    CreateFonts();
    g_panelW = S(400);
    g_panelH = S(540);

    HINSTANCE inst = GetModuleHandleW(nullptr);
    WNDCLASSEXW bc = {};
    bc.cbSize = sizeof(bc);
    bc.style = CS_DBLCLKS;
    bc.lpfnWndProc = BubbleProc;
    bc.hInstance = inst;
    bc.hCursor = LoadCursorW(nullptr, IDC_HAND);
    bc.lpszClassName = kBubbleClass;
    WNDCLASSEXW pc = {};
    pc.cbSize = sizeof(pc);
    pc.lpfnWndProc = PanelProc;
    pc.hInstance = inst;
    pc.hCursor = LoadCursorW(nullptr, IDC_ARROW);
    pc.lpszClassName = kPanelClass;

    bool ok = RegisterClassExW(&bc) && RegisterClassExW(&pc);
    if (ok) {
        int sz = S(g_cfg.bubbleSize);
        g_bubble = CreateWindowExW(WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_NOACTIVATE,
                                   kBubbleClass, L"AI Bubble", WS_POPUP, 0, 0, sz, sz,
                                   nullptr, nullptr, inst, nullptr);
        g_panel = CreateWindowExW(WS_EX_TOOLWINDOW | WS_EX_TOPMOST, kPanelClass, L"AI Panel",
                                  WS_POPUP | WS_CLIPCHILDREN, 0, 0, g_panelW, g_panelH,
                                  nullptr, nullptr, inst, nullptr);
        ok = g_bubble && g_panel;
    }
    if (!ok) {
        Wh_Log(L"AI Agent: falha ao criar janelas (erro %lu)", GetLastError());
        if (g_panel) DestroyWindow(g_panel);
        if (g_bubble) DestroyWindow(g_bubble);
        g_panel = g_bubble = nullptr;
        UnregisterClassW(kBubbleClass, inst);
        UnregisterClassW(kPanelClass, inst);
        DeleteFonts();
        if (g_uiGdipReady) Gdiplus::GdiplusShutdown(g_uiGdipToken);
        g_uiGdipReady = false;
        SetEvent(g_ready);
        if (SUCCEEDED(co)) CoUninitialize();
        return 1;
    }

    DragAcceptFiles(g_panel, TRUE);
    DragAcceptFiles(g_bubble, TRUE);
    ApplyBubbleShape();
    SetTimer(g_bubble, 1, 100, nullptr);
    PlaceBubbleInitial();
    ShowWindow(g_bubble, SW_SHOWNOACTIVATE);
    g_hBubble.store(g_bubble);
    SetEvent(g_ready);
    Wh_Log(L"AI Agent: balão criado");
    RestartWakeWordListener();

    EnsureAppIndex();

    MSG msg;
    BOOL r;
    while ((r = GetMessageW(&msg, nullptr, 0, 0)) != 0) {
        if (r == -1) break;
        if (msg.message == WM_KEYDOWN) {
            bool ctrl = (GetKeyState(VK_CONTROL) & 0x8000) != 0;
            bool shift = (GetKeyState(VK_SHIFT) & 0x8000) != 0;
            if ((msg.hwnd == g_input || msg.hwnd == g_history) && msg.wParam == 'O' && ctrl) {
                OpenAttachmentDialog();
                continue;
            }
            if (msg.hwnd == g_input) {
                if (msg.wParam == VK_RETURN && !shift) {
                    SendFromInput();
                    continue;
                }
                if (msg.wParam == 'A' && ctrl) {
                    SendMessageW(g_input, EM_SETSEL, 0, -1);
                    continue;
                }
            } else if (msg.hwnd == g_history && msg.wParam == 'A' && ctrl) {
                SendMessageW(g_history, EM_SETSEL, 0, -1);
                continue;
            }
            if (msg.wParam == VK_ESCAPE && g_panel && IsWindowVisible(g_panel) &&
                (msg.hwnd == g_input || msg.hwnd == g_history || msg.hwnd == g_panel)) {
                HidePanel();
                continue;
            }
        }
        TranslateMessage(&msg);
        DispatchMessageW(&msg);
    }

    g_hBubble.store(nullptr);
    StopWakeWordListener();
    if (g_panel && IsWindow(g_panel)) DestroyWindow(g_panel);
    if (g_bubble && IsWindow(g_bubble)) DestroyWindow(g_bubble);
    g_panel = g_bubble = nullptr;
    UnregisterClassW(kBubbleClass, inst);
    UnregisterClassW(kPanelClass, inst);
    DeleteFonts();
    g_avatarCache.clear();
    if (g_uiGdipReady) Gdiplus::GdiplusShutdown(g_uiGdipToken);
    g_uiGdipReady = false;
    if (SUCCEEDED(co)) CoUninitialize();
    return 0;
}

