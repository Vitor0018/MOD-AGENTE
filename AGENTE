        L"}\r\n";

    HANDLE sf = CreateFileW(psPath.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS,
                            FILE_ATTRIBUTE_TEMPORARY, nullptr);
    if (sf == INVALID_HANDLE_VALUE) {
        DeleteFileW(psPath.c_str()); DeleteFileW(topicPath); DeleteFileW(statusPath);
