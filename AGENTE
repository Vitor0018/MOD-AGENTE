// Interpretação da resposta do agente
// ============================================================================

std::string StripThink(std::string t) {
    for (;;) {
        size_t a = t.find("<think>");
        size_t b = t.find("</think>");
        if (a != std::string::npos && b != std::string::npos && b > a) {
            t.erase(a, b + 8 - a);
        } else if (a == std::string::npos && b != std::string::npos) {
            t.erase(0, b + 8);
        } else {
            break;
        }
    }
    return t;
}

struct ParsedReply {
    std::string reply;
    std::string mood;
    std::vector<Action> actions;
};

ParsedReply ParseAgentReply(const std::string& text) {
    ParsedReply pr;
    size_t a = text.find('{');
    size_t b = text.rfind('}');
    if (a != std::string::npos && b != std::string::npos && b > a) {
        std::string sub = text.substr(a, b - a + 1);
        JV v;
        JsonParser parser(sub);
        if (parser.Parse(v) && v.type == JV::Obj) {
            const JV* reply = v.Get("reply");
            const JV* acts = v.Get("actions");
            if (reply || acts) {
                if (reply) pr.reply = reply->AsStr();
                if (const JV* mood = v.Get("mood")) pr.mood = mood->AsStr();
                if (acts && acts->type == JV::Arr) {
                    static const struct { const char* type; const char* field; } kMap[] = {
                        {"open_app", "target"}, {"open_url", "url"},
                        {"web_search", "query"}, {"open_folder", "path"},
                        {"copy_text", "text"}, {"create_presentation", "topic"},
                        {"open_latest_presentation", "target"}, {"run_command", "command"},
                        {"ask_user", "message"},
                        {"window_control", "target"}, {"organize_desktop", "target"},
                        {"wallpaper_rotate", "direction"}, {"wallpaper_set", "path"},
                        {"media_control", "command"}, {"volume_control", "command"}, {"voice_control", "voice"},
                    };
                    for (size_t i = 0; i < acts->arr.size() && pr.actions.size() < 32; ++i) {
                        const JV& o = acts->arr[i];
                        const JV* t = o.Get("type");
                        if (!t) continue;
                        std::string type = t->AsStr();
                        if (type == "mouse_control") {
                            const JV* command = o.Get("command");
                            if (!command || command->type != JV::Str) continue;
                            Action mouse;
                            mouse.type = L"mouse_control";
                            mouse.arg = FromUtf8(command->AsStr());
                            auto readInt = [](const JV* v) -> int {
                                if (!v) return -1;
                                if (v->type == JV::Num) return static_cast<int>(v->n);
                                if (v->type == JV::Str && !v->s.empty()) {
                                    char* end = nullptr;
                                    long value = std::strtol(v->s.c_str(), &end, 10);
                                    if (end && *end == '\0') return static_cast<int>(value);
                                }
                                return -1;
                            };
                            mouse.x = readInt(o.Get("x"));
                            mouse.y = readInt(o.Get("y"));
                            mouse.x2 = readInt(o.Get("x2"));
                            mouse.y2 = readInt(o.Get("y2"));
                            const JV* payload = o.Get("text");
                            if (!payload) payload = o.Get("keys");
                            if (!payload) payload = o.Get("button");
                            if (payload && payload->type == JV::Str) mouse.detail = FromUtf8(payload->AsStr());
                            if (mouse.arg == L"type_text" && mouse.detail.empty()) continue;
                            if (mouse.arg == L"key" && mouse.detail.empty()) continue;
                            if ((mouse.arg == L"click" || mouse.arg == L"double_click" || mouse.arg == L"right_click" || mouse.arg == L"middle_click" || mouse.arg == L"move" || mouse.arg == L"scroll_up" || mouse.arg == L"scroll_down" || mouse.arg == L"drag") && (mouse.x < 0 || mouse.y < 0)) continue;
                            pr.actions.push_back(mouse);
                            continue;
                        }
                        if (type == "inspect_screen") {
                            pr.actions.push_back({L"inspect_screen", L"current"});
                            continue;
                        }
                        if (type == "crop_image") {
                            const JV* pathValue = o.Get("path");
                            const JV* boxesValue = o.Get("boxes");
                            if (!pathValue || pathValue->type != JV::Str || !boxesValue || boxesValue->type != JV::Arr) continue;
                            Action crop{};
                            crop.type = L"crop_image";
                            crop.arg = FromUtf8(pathValue->AsStr());
                            auto readCropInt = [](const JV* v, int& out) -> bool {
                                if (!v) return false;
                                if (v->type == JV::Num) { out = static_cast<int>(v->n); return true; }
                                if (v->type == JV::Str && !v->s.empty()) {
                                    char* end = nullptr;
                                    long n = std::strtol(v->s.c_str(), &end, 10);
                                    if (end && *end == '\0') { out = static_cast<int>(n); return true; }
                                }
                                return false;
                            };
                            for (size_t bi = 0; bi < boxesValue->arr.size() && crop.cropBoxes.size() < 20; ++bi) {
                                const JV& box = boxesValue->arr[bi];
                                int x = 0, y = 0, w = 0, h = 0;
                                if (box.type != JV::Obj ||
                                    !readCropInt(box.Get("x"), x) || !readCropInt(box.Get("y"), y) ||
                                    !readCropInt(box.Get("width"), w) || !readCropInt(box.Get("height"), h)) continue;
                                x = std::clamp(x, 0, 1000);
                                y = std::clamp(y, 0, 1000);
                                w = std::clamp(w, 0, 1000);
                                h = std::clamp(h, 0, 1000);
                                if (w < 5 || h < 5 || x + w > 1000 || y + h > 1000) continue;
                                RECT r{};
                                r.left = x; r.top = y; r.right = x + w; r.bottom = y + h;
                                crop.cropBoxes.push_back(r);
                            }
                            if (!Trim(crop.arg).empty() && !crop.cropBoxes.empty()) pr.actions.push_back(std::move(crop));
                            continue;
                        }
                        if (type == "site_search" || type == "app_search") {
                            const bool siteMode = type == "site_search";
                            const JV* destination = o.Get(siteMode ? "site" : "app");
                            const JV* query = o.Get("query");
                            std::wstring targetArg = destination ? FromUtf8(destination->AsStr()) : L"";
                            std::wstring queryArg = query ? FromUtf8(query->AsStr()) : L"";
                            if (!Trim(targetArg).empty() && !Trim(queryArg).empty())
                                pr.actions.push_back({FromUtf8(type), targetArg, queryArg});
                            continue;
                        }
                        for (const auto& m : kMap) {
                            if (type != m.type) continue;
                            const JV* f = o.Get(m.field);
                            std::wstring arg = f ? FromUtf8(f->AsStr()) : L"";
                            if (!Trim(arg).empty())
                                pr.actions.push_back({FromUtf8(type), arg});
                            break;
                        }
                    }
                }
                return pr;
            }
        }
    }
    pr.reply = text;  // Texto simples (o modelo não seguiu o formato JSON).
    return pr;
}

// ============================================================================
// Avatar por estado: imagens locais PNG/JPG/BMP e GIFs animados.
// Arquivos esperados na pasta configurada: idle, thinking, listening, speaking,
// happy, curious, confused, sad, surprised e error (com .png/.jpg/.bmp/.gif).
// ============================================================================

std::wstring ExpandEnvironment(const std::wstring& raw) {
    DWORD needed = ExpandEnvironmentStringsW(raw.c_str(), nullptr, 0);
    if (!needed) return raw;
    std::wstring out(needed, L'\0');
    DWORD written = ExpandEnvironmentStringsW(raw.c_str(), &out[0], needed);
    if (!written || written > needed) return raw;
    out.resize(written - 1);
    return out;
}

std::wstring CurrentAvatarState() {
    if (g_listening) return L"listening";
    if (g_busy) return L"thinking";
    if (g_speaking.load()) return L"speaking";
    DWORD now = GetTickCount();
    if (g_avatarMoodUntil && static_cast<LONG>(g_avatarMoodUntil - now) > 0)
        return g_avatarMood;
    if (g_hover) return L"curious";
    return L"idle";
}

std::wstring AvatarDirectory() {
    std::wstring dir = ExpandEnvironment(g_cfg.avatarFolder);
    while (!dir.empty() && (dir.back() == L'\\' || dir.back() == L'/')) dir.pop_back();
    return dir;
}

AvatarAsset* LoadAvatarAsset(const std::wstring& path) {
    auto found = g_avatarCache.find(path);
    if (found != g_avatarCache.end()) return found->second.get();
    if (!g_uiGdipReady) return nullptr;
    if (GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES) {
        g_avatarCache.emplace(path, nullptr);
        return nullptr;
    }
    auto asset = std::make_unique<AvatarAsset>();
    asset->image.reset(Gdiplus::Image::FromFile(path.c_str(), FALSE));
    if (!asset->image || asset->image->GetLastStatus() != Gdiplus::Ok) {
        g_avatarCache.emplace(path, nullptr);
        return nullptr;
    }
    UINT dimensionCount = asset->image->GetFrameDimensionsCount();
    if (dimensionCount > 0) {
        std::vector<GUID> dimensions(dimensionCount);
        if (asset->image->GetFrameDimensionsList(dimensions.data(), dimensionCount) == Gdiplus::Ok) {
            asset->frameDimension = dimensions[0];
            asset->frameCount = std::max<UINT>(1, asset->image->GetFrameCount(&asset->frameDimension));
        }
    }
    asset->lastFrameTick = GetTickCount();
    AvatarAsset* result = asset.get();
    g_avatarCache.emplace(path, std::move(asset));
    return result;
}

AvatarAsset* FindAvatarAsset(const std::wstring& state) {
    const std::wstring folder = AvatarDirectory();
    if (folder.empty()) return nullptr;
    const wchar_t* ext[] = {L".gif", L".png", L".jpg", L".jpeg", L".bmp"};
    std::vector<std::wstring> names;
    names.push_back(state);
    if (state != L"idle") names.push_back(L"idle");
    names.push_back(L"avatar");
    names.push_back(L"default");
    for (const auto& name : names) {
        for (const auto* e : ext) {
            std::wstring path = folder + L"\\" + name + e;
            if (auto* asset = LoadAvatarAsset(path)) return asset;
        }
    }
    return nullptr;
}

bool DrawAvatar(HDC dc, const RECT& rect, bool clipCircle) {
    AvatarAsset* asset = FindAvatarAsset(CurrentAvatarState());
    if (!asset || !asset->image) return false;
    DWORD now = GetTickCount();
    if (asset->frameCount > 1 && now - asset->lastFrameTick >= 100) {
        asset->frame = (asset->frame + 1) % asset->frameCount;
        asset->image->SelectActiveFrame(&asset->frameDimension, asset->frame);
        asset->lastFrameTick = now;
    }
    Gdiplus::Graphics graphics(dc);
    graphics.SetInterpolationMode(Gdiplus::InterpolationModeHighQualityBicubic);
    graphics.SetPixelOffsetMode(Gdiplus::PixelOffsetModeHighQuality);
    Gdiplus::GraphicsPath clip;
    if (clipCircle) {
        clip.AddEllipse(static_cast<Gdiplus::REAL>(rect.left), static_cast<Gdiplus::REAL>(rect.top),
                        static_cast<Gdiplus::REAL>(rect.right - rect.left),
                        static_cast<Gdiplus::REAL>(rect.bottom - rect.top));
        graphics.SetClip(&clip);
    }
    Gdiplus::Status status = graphics.DrawImage(asset->image.get(),
        Gdiplus::Rect(rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top));
    if (clipCircle) graphics.ResetClip();
    return status == Gdiplus::Ok;
}

