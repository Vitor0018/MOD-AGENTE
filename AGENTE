// Visão da tela: captura a área de trabalho virtual, reduz para no máximo 1280 px
// e comprime em JPEG antes de anexar à mensagem enviada ao provedor escolhido.
// A imagem não é salva em disco.
// ============================================================================

std::string Base64Encode(const unsigned char* data, size_t len) {
    static const char tbl[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    std::string out;
    out.reserve(((len + 2) / 3) * 4);
    for (size_t i = 0; i < len; i += 3) {
        unsigned int n = static_cast<unsigned int>(data[i]) << 16;
        if (i + 1 < len) n |= static_cast<unsigned int>(data[i + 1]) << 8;
        if (i + 2 < len) n |= static_cast<unsigned int>(data[i + 2]);
        out.push_back(tbl[(n >> 18) & 63]);
        out.push_back(tbl[(n >> 12) & 63]);
        out.push_back(i + 1 < len ? tbl[(n >> 6) & 63] : '=');
        out.push_back(i + 2 < len ? tbl[n & 63] : '=');
    }
    return out;
}

bool GetJpegEncoder(CLSID* clsid) {
    UINT count = 0, bytes = 0;
    if (Gdiplus::GetImageEncodersSize(&count, &bytes) != Gdiplus::Ok || !bytes) return false;
    std::vector<BYTE> mem(bytes);
    auto* codecs = reinterpret_cast<Gdiplus::ImageCodecInfo*>(mem.data());
    if (Gdiplus::GetImageEncoders(count, bytes, codecs) != Gdiplus::Ok) return false;
    for (UINT i = 0; i < count; ++i) {
        if (codecs[i].MimeType && wcscmp(codecs[i].MimeType, L"image/jpeg") == 0) {
            *clsid = codecs[i].Clsid;
            return true;
        }
    }
    return false;
}

std::string CaptureScreenJpegBase64() {
    HRESULT comHr = CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
    Gdiplus::GdiplusStartupInput gdipInput;
    ULONG_PTR gdipToken = 0;
    if (Gdiplus::GdiplusStartup(&gdipToken, &gdipInput, nullptr) != Gdiplus::Ok) {
        if (SUCCEEDED(comHr)) CoUninitialize();
        return {};
    }

    std::string encoded;
    const int left = GetSystemMetrics(SM_XVIRTUALSCREEN);
    const int top = GetSystemMetrics(SM_YVIRTUALSCREEN);
    const int width = GetSystemMetrics(SM_CXVIRTUALSCREEN);
    const int height = GetSystemMetrics(SM_CYVIRTUALSCREEN);
    HDC screen = GetDC(nullptr);
    HDC memory = screen ? CreateCompatibleDC(screen) : nullptr;
    HBITMAP bitmap = (screen && memory && width > 0 && height > 0)
        ? CreateCompatibleBitmap(screen, width, height) : nullptr;
    HGDIOBJ old = bitmap && memory ? SelectObject(memory, bitmap) : nullptr;
    bool copied = bitmap && memory && screen &&
        BitBlt(memory, 0, 0, width, height, screen, left, top, SRCCOPY | CAPTUREBLT);
    if (old && memory) SelectObject(memory, old);
    if (memory) DeleteDC(memory);
    if (screen) ReleaseDC(nullptr, screen);

    if (copied) {
        {
            Gdiplus::Bitmap source(bitmap, nullptr);
            if (source.GetLastStatus() == Gdiplus::Ok) {
                double scale = std::min(1.0, 1280.0 / static_cast<double>(std::max(width, height)));
                UINT outW = static_cast<UINT>(std::max(1.0, width * scale));
                UINT outH = static_cast<UINT>(std::max(1.0, height * scale));
                Gdiplus::Bitmap resized(outW, outH, PixelFormat24bppRGB);
                Gdiplus::Graphics graphics(&resized);
                graphics.SetInterpolationMode(Gdiplus::InterpolationModeHighQualityBicubic);
                if (graphics.DrawImage(&source, 0, 0, outW, outH) == Gdiplus::Ok) {
                    CLSID jpegClsid{};
                    IStream* stream = nullptr;
                    if (GetJpegEncoder(&jpegClsid) && SUCCEEDED(CreateStreamOnHGlobal(nullptr, TRUE, &stream))) {
                        Gdiplus::EncoderParameters ep{};
                        ULONG quality = 68;
                        ep.Count = 1;
                        ep.Parameter[0].Guid = Gdiplus::EncoderQuality;
                        ep.Parameter[0].Type = Gdiplus::EncoderParameterValueTypeLong;
                        ep.Parameter[0].NumberOfValues = 1;
                        ep.Parameter[0].Value = &quality;
                        if (resized.Save(stream, &jpegClsid, &ep) == Gdiplus::Ok) {
                            HGLOBAL hglob = nullptr;
                            if (SUCCEEDED(GetHGlobalFromStream(stream, &hglob)) && hglob) {
                                STATSTG st{};
                                ULONG stOk = stream->Stat(&st, STATFLAG_NONAME);
                                SIZE_T n = (stOk == S_OK && st.cbSize.QuadPart > 0)
                                    ? static_cast<SIZE_T>(st.cbSize.QuadPart) : 0;
                                const auto* bytes = static_cast<const unsigned char*>(GlobalLock(hglob));
                                if (bytes && n) encoded = Base64Encode(bytes, static_cast<size_t>(n));
                                if (bytes) GlobalUnlock(hglob);
                            }
                        }
                        stream->Release();
                    }
                }
            }
        }
        DeleteObject(bitmap);
    } else if (bitmap) {
        DeleteObject(bitmap);
    }
    Gdiplus::GdiplusShutdown(gdipToken);
    if (SUCCEEDED(comHr)) CoUninitialize();
    return encoded;
}

// Capture the screen for AI inspection without the always-on-top assistant UI obscuring content.
std::string CaptureScreenForVisionJpegBase64() {
    const bool panelExists = g_panel && IsWindow(g_panel);
    const bool bubbleExists = g_bubble && IsWindow(g_bubble);
    const bool panelWasVisible = panelExists && IsWindowVisible(g_panel);
    const bool bubbleWasVisible = bubbleExists && IsWindowVisible(g_bubble);
    const bool panelWasMinimized = panelExists && IsIconic(g_panel);
    const bool bubbleWasMinimized = bubbleExists && IsIconic(g_bubble);
    if (panelWasVisible) ShowWindow(g_panel, SW_HIDE);
    if (bubbleWasVisible) ShowWindow(g_bubble, SW_HIDE);
    Sleep(120);
    std::string image = CaptureScreenJpegBase64();
    // Restore the prior state exactly enough to avoid undoing WIN+M when the user
    // deliberately asked to inspect the desktop. Never resurrect a minimized
    // topmost chat panel over the wallpaper just to finish a screenshot.
    if (bubbleWasVisible && !bubbleWasMinimized) ShowWindow(g_bubble, SW_SHOWNOACTIVATE);
    else if (bubbleWasMinimized) ShowWindow(g_bubble, SW_SHOWMINNOACTIVE);
    if (panelWasVisible && !panelWasMinimized) ShowWindow(g_panel, SW_SHOWNOACTIVATE);
    else if (panelWasMinimized) ShowWindow(g_panel, SW_SHOWMINNOACTIVE);
    if (panelWasVisible && !panelWasMinimized && g_panel) SetWindowPos(g_panel, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
    if (bubbleWasVisible && !bubbleWasMinimized && g_bubble) SetWindowPos(g_bubble, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
    return image;
}

// Salva em disco a captura JPEG que já foi gerada pelo capturador da tela.
// O arquivo é guardado numa pasta fácil de encontrar dentro de Imagens.
bool SaveScreenshotJpegBase64(const std::string& encoded, std::wstring* savedFile, std::wstring* savedFolder) {
    if (encoded.empty()) return false;
    static const std::string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    std::vector<unsigned char> bytes;
    bytes.reserve((encoded.size() * 3) / 4);
    unsigned int accumulator = 0;
    int bits = -8;
    for (unsigned char c : encoded) {
        if (c == '=') break;
        const size_t value = alphabet.find(static_cast<char>(c));
        if (value == std::string::npos) continue;
        accumulator = (accumulator << 6) | static_cast<unsigned int>(value);
        bits += 6;
        if (bits >= 0) {
            bytes.push_back(static_cast<unsigned char>((accumulator >> bits) & 0xFF));
            bits -= 8;
        }
    }
    if (bytes.empty()) return false;

    WCHAR pictures[MAX_PATH] = {};
    if (FAILED(SHGetFolderPathW(nullptr, CSIDL_MYPICTURES, nullptr, SHGFP_TYPE_CURRENT, pictures)))
        return false;
    std::wstring folder = std::wstring(pictures) + L"\\AI-Agent-Bubble-Screenshots";
    if (!CreateDirectoryW(folder.c_str(), nullptr) && GetLastError() != ERROR_ALREADY_EXISTS)
        return false;

    std::wstring file = folder + L"\\print_" + std::to_wstring(GetTickCount64()) + L".jpg";
    HANDLE h = CreateFileW(file.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW,
                           FILE_ATTRIBUTE_NORMAL, nullptr);
    if (h == INVALID_HANDLE_VALUE) return false;
    DWORD written = 0;
    const DWORD expected = static_cast<DWORD>(std::min<size_t>(bytes.size(), 0xFFFFFFFFu));
    const BOOL ok = WriteFile(h, bytes.data(), expected, &written, nullptr);
    CloseHandle(h);
    if (!ok || written != expected) {
        DeleteFileW(file.c_str());
        return false;
    }
    if (savedFile) *savedFile = file;
    if (savedFolder) *savedFolder = folder;
    return true;
}

