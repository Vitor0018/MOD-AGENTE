        L"  $pres.SaveAs($out, 24)\r\n"
        L"  $pres.Close(); $pres = $null\r\n"
        L"  $ppt.Quit(); $ppt = $null\r\n"
        L"  if (!(Test-Path -LiteralPath $out -PathType Leaf)) { throw 'O PowerPoint não criou o arquivo esperado.' }\r\n"
        L"  if ((Get-Item -LiteralPath $out).Length -le 0) { throw 'O arquivo da apresentação está vazio.' }\r\n"
        L"  [IO.File]::WriteAllText($status, 'OK', [Text.Encoding]::UTF8)\r\n"
        L"  exit 0\r\n"
        L"} catch {\r\n"
        L"  $comError = $_.Exception.Message\r\n"
        L"  try { New-NativePptx $out $topic $bodyText; [IO.File]::WriteAllText($status, 'OK_NATIVE', [Text.Encoding]::UTF8); exit 0 } catch {\r\n"
