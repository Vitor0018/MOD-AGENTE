void NotifyWakeWordDetected() {
    HWND h = g_hBubble.load();
    if (!h) return;
    const DWORD now = GetTickCount();
    DWORD previous = g_lastWakeWordTick.load();
    for (;;) {
        if (previous != 0 && static_cast<DWORD>(now - previous) < 3500) return;
        if (g_lastWakeWordTick.compare_exchange_weak(previous, now)) break;
    }
    if (!PostMessageW(h, WM_APP_WAKEWORD, 0, 0)) {
        Wh_Log(L"AI Agent: não foi possível notificar a ativação por voz (erro %lu)", GetLastError());
    }
}

void NotifyWakeWordStatus(const std::wstring& status) {
    HWND h = g_hBubble.load();
    if (!h) return;
    auto* payload = new (std::nothrow) std::wstring(status);
    if (!payload) return;
    if (!PostMessageW(h, WM_APP_WAKEWORD_STATUS, 0, reinterpret_cast<LPARAM>(payload))) delete payload;
}

void NotifyVoiceCommand(const std::wstring& rawCommand) {
    std::wstring command = Trim(rawCommand);
    if (command.empty()) return;
    HWND h = g_hBubble.load();
    if (!h) return;
    auto* payload = new (std::nothrow) std::wstring(std::move(command));
    if (!payload) {
        Wh_Log(L"AI Agent: sem memória para encaminhar o comando de voz.");
        return;
    }
    if (!PostMessageW(h, WM_APP_VOICE_COMMAND, 0, reinterpret_cast<LPARAM>(payload))) {
        delete payload;
        Wh_Log(L"AI Agent: não foi possível encaminhar o comando reconhecido (erro %lu)", GetLastError());
    }
}

std::wstring NormalizeSpeechForMatch(std::wstring text) {
    text = Lower(std::move(text));
    std::wstring out;
    out.reserve(text.size());
    bool lastWasSpace = true;
    for (wchar_t ch : text) {
        if (iswalnum(ch)) {
            out.push_back(ch);
            lastWasSpace = false;
        } else if (!lastWasSpace) {
            out.push_back(L' ');
            lastWasSpace = true;
        }
    }
    while (!out.empty() && out.back() == L' ') out.pop_back();
    return out;
}

bool SpeechContainsWakeWord(const std::wstring& recognized, const std::wstring& wakeWord) {
    const std::wstring phrase = NormalizeSpeechForMatch(recognized);
    const std::wstring target = NormalizeSpeechForMatch(wakeWord);
    if (phrase.empty() || target.empty()) return false;
    // Primeiro tenta a frase exata por palavra inteira.
    const std::wstring paddedPhrase = L" " + phrase + L" ";
    const std::wstring paddedTarget = L" " + target + L" ";
    if (paddedPhrase.find(paddedTarget) != std::wstring::npos) return true;

    // O reconhecimento em português pode transcrever o nome inglês "Bruce"
    // como "brus" ou "bruise". Aceita apenas estas variantes para a palavra
    // padrão; palavras de ativação personalizadas continuam usando igualdade exata.
    if (target == L"bruce") {
        size_t pos = 0;
        while (pos < phrase.size()) {
            while (pos < phrase.size() && phrase[pos] == L' ') ++pos;
            size_t end = phrase.find(L' ', pos);
            if (end == std::wstring::npos) end = phrase.size();
            const std::wstring token = phrase.substr(pos, end - pos);
            if (token == L"brus" || token == L"bruise" || token == L"brucee" || token == L"bruc") return true;
            pos = end + 1;
        }
    }
    return false;
}

void ReleaseWakeRecognizer(ISpRecognizer*& recognizer, ISpAudio*& audio,
                           ISpRecoContext*& context, ISpRecoGrammar*& wakeGrammar,
                           ISpRecoGrammar*& commandGrammar) {
    if (commandGrammar) { commandGrammar->Release(); commandGrammar = nullptr; }
    if (wakeGrammar) { wakeGrammar->Release(); wakeGrammar = nullptr; }
    if (context) { context->Release(); context = nullptr; }
    if (recognizer) { recognizer->Release(); recognizer = nullptr; }
    if (audio) { audio->Release(); audio = nullptr; }
}

HRESULT CreateWakeRecognizer(bool shared, ISpRecognizer** recognizerOut, ISpAudio** audioOut,
                             ISpRecoContext** contextOut, ISpRecoGrammar** wakeGrammarOut,
                             ISpRecoGrammar** commandGrammarOut) {
    *recognizerOut = nullptr;
    *audioOut = nullptr;
    *contextOut = nullptr;
    *wakeGrammarOut = nullptr;
    *commandGrammarOut = nullptr;

    HRESULT hr = CoCreateInstance(shared ? CLSID_SpSharedRecognizer : CLSID_SpInprocRecognizer,
                                  nullptr, CLSCTX_INPROC_SERVER, IID_ISpRecognizer,
                                  reinterpret_cast<void**>(recognizerOut));
    if (SUCCEEDED(hr) && !shared) {
        hr = CoCreateInstance(CLSID_SpMMAudioIn, nullptr, CLSCTX_INPROC_SERVER,
                              IID_ISpAudio, reinterpret_cast<void**>(audioOut));
        if (SUCCEEDED(hr)) hr = (*recognizerOut)->SetInput(*audioOut, TRUE);
    }
    // O reconhecedor compartilhado do Windows já escolhe o dispositivo de entrada padrão.
    // No in-process, SetInput acima é obrigatório para que a captura realmente comece.
    if (SUCCEEDED(hr)) hr = (*recognizerOut)->CreateRecoContext(contextOut);
    if (SUCCEEDED(hr)) hr = (*contextOut)->SetNotifyWin32Event();
    if (SUCCEEDED(hr)) hr = (*contextOut)->SetInterest(SPFEI(SPEI_RECOGNITION), SPFEI(SPEI_RECOGNITION));
    if (SUCCEEDED(hr)) hr = (*contextOut)->CreateGrammar(1, wakeGrammarOut);
    if (SUCCEEDED(hr)) hr = (*wakeGrammarOut)->LoadDictation(nullptr, SPLO_STATIC);
    if (SUCCEEDED(hr)) hr = (*wakeGrammarOut)->SetDictationState(SPRS_ACTIVE);
    if (SUCCEEDED(hr)) hr = (*contextOut)->CreateGrammar(2, commandGrammarOut);
    if (SUCCEEDED(hr)) hr = (*commandGrammarOut)->LoadDictation(nullptr, SPLO_STATIC);
    if (SUCCEEDED(hr)) hr = (*commandGrammarOut)->SetDictationState(SPRS_INACTIVE);
    if (SUCCEEDED(hr)) hr = (*recognizerOut)->SetRecoState(SPRST_ACTIVE);
    if (FAILED(hr)) {
        ReleaseWakeRecognizer(*recognizerOut, *audioOut, *contextOut, *wakeGrammarOut, *commandGrammarOut);
    }
    return hr;
}

struct LocalVoskPaths {
    std::wstring root;
    std::wstring python;
    std::wstring script;
    std::wstring model;
};

bool GetLocalVoskPaths(LocalVoskPaths& p) {
    wchar_t localAppData[MAX_PATH * 4] = {};
    DWORD n = GetEnvironmentVariableW(L"LOCALAPPDATA", localAppData, ARRAYSIZE(localAppData));
    if (!n || n >= ARRAYSIZE(localAppData)) return false;
    p.root = std::wstring(localAppData) + L"\\AI Agent Bubble\\voice";
    p.python = p.root + L"\\venv\\Scripts\\python.exe";
    p.script = p.root + L"\\bruce_voice.py";
    p.model = p.root + L"\\vosk-model-small-pt-0.3";
    auto isFile = [](const std::wstring& path) {
        DWORD a = GetFileAttributesW(path.c_str());
        return a != INVALID_FILE_ATTRIBUTES && !(a & FILE_ATTRIBUTE_DIRECTORY);
    };
    auto isDir = [](const std::wstring& path) {
        DWORD a = GetFileAttributesW(path.c_str());
        return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY);
    };
    return isFile(p.python) && isFile(p.script) && isDir(p.model) &&
           (isDir(p.model + L"\\am") || isFile(p.model + L"\\final.mdl"));
}

bool WriteVoiceHelperCommand(HANDLE pipe, const char* command) {
    if (!pipe || pipe == INVALID_HANDLE_VALUE) return false;
    DWORD written = 0;
    const DWORD bytes = static_cast<DWORD>(std::strlen(command));
    return WriteFile(pipe, command, bytes, &written, nullptr) && written == bytes;
}

DWORD WINAPI RunLocalVoskVoiceHelper(WakeWordThreadArgs& args) {
    LocalVoskPaths paths;
    if (!GetLocalVoskPaths(paths)) {
        const std::wstring message =
            L"O Windows não tem um mecanismo SAPI instalado (0x80045077) e o reconhecimento offline pt-BR do Bruce ainda não foi instalado. "
            L"Extraia os arquivos do pacote de voz e execute instalar-bruce-voz-local.ps1 uma vez. "
            L"Isso instala o modelo Vosk no computador; depois, recarregue o mod. O áudio continuará local, sem nuvem.";
        Wh_Log(L"AI Agent: fallback Vosk não está instalado em %%LOCALAPPDATA%%\\AI Agent Bubble\\voice.");
        NotifyWakeWordStatus(message);
        return 1;
    }

    SECURITY_ATTRIBUTES sa{};
    sa.nLength = sizeof(sa);
    sa.bInheritHandle = TRUE;
    HANDLE childOutRead = nullptr, childOutWrite = nullptr;
    HANDLE childInRead = nullptr, childInWrite = nullptr;
    if (!CreatePipe(&childOutRead, &childOutWrite, &sa, 0) ||
        !CreatePipe(&childInRead, &childInWrite, &sa, 0)) {
        if (childOutRead) CloseHandle(childOutRead);
        if (childOutWrite) CloseHandle(childOutWrite);
        if (childInRead) CloseHandle(childInRead);
        if (childInWrite) CloseHandle(childInWrite);
        NotifyWakeWordStatus(L"Não consegui criar os canais do reconhecedor offline do Bruce.");
        return 1;
    }
    SetHandleInformation(childOutRead, HANDLE_FLAG_INHERIT, 0);
    SetHandleInformation(childInWrite, HANDLE_FLAG_INHERIT, 0);

    std::wstring commandLine = L"\"" + paths.python + L"\" \"" + paths.script + L"\" --model \"" + paths.model + L"\" --wake \"" + args.word + L"\"";
    std::vector<wchar_t> mutableCommand(commandLine.begin(), commandLine.end());
    mutableCommand.push_back(L'\0');
    STARTUPINFOW si{};
    si.cb = sizeof(si);
    si.dwFlags = STARTF_USESTDHANDLES;
    si.hStdInput = childInRead;
    si.hStdOutput = childOutWrite;
    si.hStdError = childOutWrite;
    PROCESS_INFORMATION pi{};
    BOOL created = CreateProcessW(nullptr, mutableCommand.data(), nullptr, nullptr, TRUE,
                                  CREATE_NO_WINDOW, nullptr, paths.root.c_str(), &si, &pi);
    CloseHandle(childOutWrite); childOutWrite = nullptr;
    CloseHandle(childInRead); childInRead = nullptr;
    if (!created) {
        CloseHandle(childOutRead); CloseHandle(childInWrite);
        wchar_t err[32]{};
        swprintf_s(err, L"%lu", GetLastError());
        NotifyWakeWordStatus(L"Não consegui iniciar o reconhecedor offline local do Bruce (erro do Windows " + std::wstring(err) + L"). Execute o instalador de voz novamente.");
        return 1;
    }

    Wh_Log(L"AI Agent: iniciado o reconhecedor Vosk pt-BR local.");
    std::string pending;
    bool gotReady = false;
    bool helperError = false;
    DWORD lastOutputTick = GetTickCount();
    bool stopRequested = false;
    while (!stopRequested) {
        if (WaitForSingleObject(args.stopEvent, 0) == WAIT_OBJECT_0) {
            stopRequested = true;
            break;
        }
        DWORD available = 0;
        if (PeekNamedPipe(childOutRead, nullptr, 0, nullptr, &available, nullptr) && available > 0) {
            char buffer[4096];
            DWORD readBytes = 0;
            const DWORD toRead = (std::min<DWORD>)(available, sizeof(buffer));
            if (ReadFile(childOutRead, buffer, toRead, &readBytes, nullptr) && readBytes) {
                pending.append(buffer, readBytes);
                lastOutputTick = GetTickCount();
                size_t nl = std::string::npos;
                while ((nl = pending.find('\n')) != std::string::npos) {
                    std::string line = pending.substr(0, nl);
                    pending.erase(0, nl + 1);
                    if (!line.empty() && line.back() == '\r') line.pop_back();
                    if (line == "READY") {
                        gotReady = true;
                        Wh_Log(L"AI Agent: microfone pronto; aguardando palavra de ativação '%s'.", args.word.c_str());
                    } else if (line == "WAKE") {
                        NotifyWakeWordDetected();
                        bool speakingObserved = false;
                        const DWORD waitStart = GetTickCount();
                        if (g_cfg.voiceReplies) {
                            while (GetTickCount() - waitStart < 3000 && WaitForSingleObject(args.stopEvent, 50) != WAIT_OBJECT_0) {
                                if (g_speaking.load()) { speakingObserved = true; break; }
                            }
                            if (speakingObserved) {
                                while (GetTickCount() - waitStart < 15000 && g_speaking.load() &&
                                       WaitForSingleObject(args.stopEvent, 50) != WAIT_OBJECT_0) {}
                            } else Sleep(350);
                        } else {
                            Sleep(350);
                        }
                        if (WaitForSingleObject(args.stopEvent, 0) != WAIT_OBJECT_0) {
                            if (!WriteVoiceHelperCommand(childInWrite, "COMMAND\n")) {
                                Wh_Log(L"AI Agent: não consegui habilitar o ditado local depois da saudação.");
                            }
                        }
                    } else if (line.rfind("WAKE_COMMAND|", 0) == 0) {
                        std::wstring command = Trim(FromUtf8(line.substr(13)));
                        if (!command.empty()) NotifyVoiceCommand(command);
                    } else if (line.rfind("CMD|", 0) == 0) {
                        std::wstring command = Trim(FromUtf8(line.substr(4)));
                        if (!command.empty()) NotifyVoiceCommand(command);
                    } else if (line.rfind("STATUS|", 0) == 0) {
                        Wh_Log(L"AI Agent Voice: %s", FromUtf8(line.substr(7)).c_str());
                    } else if (line.rfind("ERROR|", 0) == 0) {
                        helperError = true;
                        NotifyWakeWordStatus(L"Falha no reconhecimento local do Bruce: " + FromUtf8(line.substr(6)));
                    }
                }
            }
        } else {
            DWORD procState = WaitForSingleObject(pi.hProcess, 0);
            if (procState == WAIT_OBJECT_0) break;
            Sleep(35);
        }
        if (g_voiceCommandRequest.exchange(0) != 0 &&
            !WriteVoiceHelperCommand(childInWrite, "COMMAND\n")) {
            NotifyWakeWordStatus(L"Não consegui iniciar o ditado por voz. Tente novamente.");
        }
        if (WaitForSingleObject(pi.hProcess, 0) == WAIT_OBJECT_0) {
            DWORD availableAfterExit = 0;
            if (!PeekNamedPipe(childOutRead, nullptr, 0, nullptr, &availableAfterExit, nullptr) || availableAfterExit == 0) break;
        }
        (void)lastOutputTick;
    }

    WriteVoiceHelperCommand(childInWrite, "STOP\n");
    CloseHandle(childInWrite);
    if (WaitForSingleObject(pi.hProcess, 1500) != WAIT_OBJECT_0) TerminateProcess(pi.hProcess, 1);
    WaitForSingleObject(pi.hProcess, 1000);
    CloseHandle(pi.hThread);
    CloseHandle(pi.hProcess);
    CloseHandle(childOutRead);
    if (!stopRequested && !helperError) {
        NotifyWakeWordStatus(gotReady
            ? L"O reconhecedor offline do Bruce foi encerrado inesperadamente. Recarregue o mod para tentar novamente."
            : L"O reconhecedor offline não conseguiu iniciar o microfone. Confira o dispositivo de entrada do Windows e execute o instalador novamente.");
    }
    return 0;
}

DWORD WINAPI WakeWordListenerThread(LPVOID opaque) {
    std::unique_ptr<WakeWordThreadArgs> args(static_cast<WakeWordThreadArgs*>(opaque));
    if (!args || !args->stopEvent) return 1;
    // Se o modelo Vosk pt-BR foi instalado, preferimos ele ao SAPI: ele reconhece
    // português localmente, sem abrir o serviço de digitação por voz na nuvem.
    LocalVoskPaths localVoicePaths;
    if (GetLocalVoskPaths(localVoicePaths)) return RunLocalVoskVoiceHelper(*args);
    HRESULT co = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
    if (FAILED(co)) {
        Wh_Log(L"AI Agent: COM não iniciou para reconhecimento da palavra de voz (0x%08X)", static_cast<unsigned>(co));
        NotifyWakeWordStatus(L"Não consegui iniciar o reconhecimento de voz do Bruce (falha ao iniciar COM do Windows).");
        return 1;
    }

    ISpRecognizer* recognizer = nullptr;
    ISpAudio* audio = nullptr;
    ISpRecoContext* context = nullptr;
    ISpRecoGrammar* wakeGrammar = nullptr;
    ISpRecoGrammar* commandGrammar = nullptr;
    HRESULT hr = CreateWakeRecognizer(false, &recognizer, &audio, &context, &wakeGrammar, &commandGrammar);
    bool usingSharedRecognizer = false;
    if (FAILED(hr)) {
        Wh_Log(L"AI Agent: reconhecedor local falhou (0x%08X); tentando reconhecedor compartilhado do Windows.", static_cast<unsigned>(hr));
        ReleaseWakeRecognizer(recognizer, audio, context, wakeGrammar, commandGrammar);
        hr = CreateWakeRecognizer(true, &recognizer, &audio, &context, &wakeGrammar, &commandGrammar);
        usingSharedRecognizer = SUCCEEDED(hr);
    }

    if (FAILED(hr)) {
        Wh_Log(L"AI Agent: ativação por voz indisponível (0x%08X). Verifique microfone, mecanismo de reconhecimento instalado e idioma de fala do Windows.", static_cast<unsigned>(hr));
        // SAPI não inclui um motor de reconhecimento em todos os idiomas/instalações.
        // Tenta o motor offline Vosk em pt-BR; se não estiver instalado, orienta a instalação.
        CoUninitialize();
        return RunLocalVoskVoiceHelper(*args);
    }

    Wh_Log(L"AI Agent: aguardando a palavra '%s' com ditado local (%s).",
           args->word.c_str(), usingSharedRecognizer ? L"reconhecedor compartilhado" : L"reconhecedor local");
    HANDLE handles[2] = {args->stopEvent, context->GetNotifyEventHandle()};
    bool running = true;
    bool commandMode = false;
    DWORD commandModeStarted = 0;
    while (running) {
        DWORD timeout = INFINITE;
        if (commandMode) {
            const DWORD elapsed = GetTickCount() - commandModeStarted;
            constexpr DWORD kCommandListenTimeoutMs = 30000;
            timeout = elapsed >= kCommandListenTimeoutMs ? 0 : kCommandListenTimeoutMs - elapsed;
        }
        DWORD wait = WaitForMultipleObjects(2, handles, FALSE, timeout);
        if (wait == WAIT_OBJECT_0) break;
        if (wait == WAIT_TIMEOUT && commandMode) {
            commandGrammar->SetDictationState(SPRS_INACTIVE);
            recognizer->SetRecoState(SPRST_INACTIVE);
            wakeGrammar->SetDictationState(SPRS_ACTIVE);
            recognizer->SetRecoState(SPRST_ACTIVE);
            commandMode = false;
            commandModeStarted = 0;
            Wh_Log(L"AI Agent: tempo para falar o comando expirou; palavra de ativação rearmada.");
            continue;
        }
        if (wait == WAIT_OBJECT_0 + 1) {
            for (;;) {
                SPEVENT ev = {};
                ULONG fetched = 0;
                HRESULT eventHr = context->GetEvents(1, &ev, &fetched);
                if (FAILED(eventHr) || fetched == 0) break;
                if (ev.eEventId == SPEI_RECOGNITION && ev.elParamType == SPET_LPARAM_IS_OBJECT && ev.lParam) {
                    ISpRecoResult* reco = reinterpret_cast<ISpRecoResult*>(ev.lParam);
                    WCHAR* phraseText = nullptr;
                    std::wstring recognized;
                    HRESULT textHr = reco->GetText(SP_GETWHOLEPHRASE, SP_GETWHOLEPHRASE, TRUE, &phraseText, nullptr);
                    if (SUCCEEDED(textHr) && phraseText) recognized = Trim(phraseText);
                    if (phraseText) CoTaskMemFree(phraseText);

                    if (!commandMode) {
                        // Usa ditado local e compara o texto reconhecido. Isso evita depender
                        // de o nome "Bruce" existir no dicionário lexical da gramática SAPI.
                        if (SpeechContainsWakeWord(recognized, args->word)) {
                            Wh_Log(L"AI Agent: palavra de ativação reconhecida como '%s'.", recognized.c_str());
                            wakeGrammar->SetDictationState(SPRS_INACTIVE);
                            recognizer->SetRecoState(SPRST_INACTIVE);
                            NotifyWakeWordDetected();

                            DWORD startTick = GetTickCount();
                            bool greetingStarted = false;
                            if (g_cfg.voiceReplies) {
                                while (GetTickCount() - startTick < 3000 && WaitForSingleObject(args->stopEvent, 50) != WAIT_OBJECT_0) {
                                    if (g_speaking.load()) { greetingStarted = true; break; }
                                }
                                if (greetingStarted) {
                                    while (GetTickCount() - startTick < 15000 && g_speaking.load() &&
                                           WaitForSingleObject(args->stopEvent, 50) != WAIT_OBJECT_0) {}
                                } else {
                                    Sleep(400);
                                }
                            } else {
                                Sleep(400);
                            }
                            if (WaitForSingleObject(args->stopEvent, 0) == WAIT_OBJECT_0) {
                                running = false;
                            } else {
                                HRESULT modeHr = commandGrammar->SetDictationState(SPRS_ACTIVE);
                                if (SUCCEEDED(modeHr)) modeHr = recognizer->SetRecoState(SPRST_ACTIVE);
                                if (SUCCEEDED(modeHr)) {
                                    commandMode = true;
                                    commandModeStarted = GetTickCount();
                                    Wh_Log(L"AI Agent: ouvindo comando de voz após a ativação.");
                                } else {
                                    Wh_Log(L"AI Agent: não consegui iniciar o ditado de comando (0x%08X).", static_cast<unsigned>(modeHr));
                                    commandGrammar->SetDictationState(SPRS_INACTIVE);
                                    wakeGrammar->SetDictationState(SPRS_ACTIVE);
                                    recognizer->SetRecoState(SPRST_ACTIVE);
                                }
                            }
                        }
                    } else if (!recognized.empty()) {
                        Wh_Log(L"AI Agent: comando de voz reconhecido (%u caracteres).", static_cast<unsigned>(recognized.size()));
                        commandGrammar->SetDictationState(SPRS_INACTIVE);
                        recognizer->SetRecoState(SPRST_INACTIVE);
                        NotifyVoiceCommand(recognized);
                        commandMode = false;
                        commandModeStarted = 0;
                        wakeGrammar->SetDictationState(SPRS_ACTIVE);
                        recognizer->SetRecoState(SPRST_ACTIVE);
                    }
                }
                if (ev.elParamType == SPET_LPARAM_IS_OBJECT && ev.lParam) {
                    reinterpret_cast<IUnknown*>(ev.lParam)->Release();
                }
                if (!running) break;
            }
        } else if (wait == WAIT_FAILED) {
            Wh_Log(L"AI Agent: erro aguardando palavra de ativação por voz (erro %lu).", GetLastError());
            NotifyWakeWordStatus(L"A escuta do Bruce foi interrompida pelo Windows. Recarregue o mod e confira o microfone.");
            running = false;
        }
    }

    ReleaseWakeRecognizer(recognizer, audio, context, wakeGrammar, commandGrammar);
    CoUninitialize();
    return 0;
}

bool StopWakeWordListener() {
    if (g_wakeWordStopEvent) SetEvent(g_wakeWordStopEvent);
    if (g_wakeWordThread) {
        DWORD wait = WaitForSingleObject(g_wakeWordThread, 6000);
        if (wait != WAIT_OBJECT_0) {
            // Não fecha nem substitui handles ainda usados pela thread, para evitar use-after-close.
            Wh_Log(L"AI Agent: a thread de voz demorou para encerrar; a reinicialização foi cancelada por segurança.");
            return false;
        }
        CloseHandle(g_wakeWordThread);
        g_wakeWordThread = nullptr;
    }
    if (g_wakeWordStopEvent) {
        CloseHandle(g_wakeWordStopEvent);
        g_wakeWordStopEvent = nullptr;
    }
    return true;
}

void RestartWakeWordListener() {
    if (!StopWakeWordListener()) return;
    g_voiceCommandRequest.store(0);
    if (g_cfg.wakeWord.empty() || !g_hBubble.load()) return;
    HANDLE stop = CreateEventW(nullptr, TRUE, FALSE, nullptr);
    if (!stop) {
        Wh_Log(L"AI Agent: não foi possível criar evento da ativação por voz (erro %lu)", GetLastError());
        return;
    }
    auto* args = new (std::nothrow) WakeWordThreadArgs{stop, g_cfg.wakeWord};
    if (!args) { CloseHandle(stop); return; }
    HANDLE thread = CreateThread(nullptr, 0, WakeWordListenerThread, args, 0, nullptr);
    if (!thread) {
        delete args;
        CloseHandle(stop);
        Wh_Log(L"AI Agent: não foi possível iniciar a ativação por voz (erro %lu)", GetLastError());
        return;
    }
    g_wakeWordStopEvent = stop;
    g_wakeWordThread = thread;
}

void StartVoiceCommand() {
    LocalVoskPaths paths;
    if (!GetLocalVoskPaths(paths)) {
        AppendText(L"[Voz] O reconhecimento offline não está instalado. Execute instalar-bruce-voz-local.ps1 e recarregue o mod.\r\n\r\n");
        return;
    }
    g_voiceCommandRequest.store(1);
    g_listening = true;
    if (g_bubble) SetTimer(g_bubble, 2, 30000, nullptr);
    AppendText(L"[Voz] Fale agora; vou enviar quando você terminar e fizer uma pausa.\r\n");
    if (g_bubble) InvalidateRect(g_bubble, nullptr, FALSE);
}

bool IsApplyWallpaperRequest(const std::wstring& raw) {
    const std::wstring s = Lower(Trim(raw));
    const bool mentions = s.find(L"wallpaper") != std::wstring::npos ||
        s.find(L"wallpeper") != std::wstring::npos || s.find(L"papel de parede") != std::wstring::npos ||
        s.find(L"fundo da área de trabalho") != std::wstring::npos || s.find(L"fundo da area de trabalho") != std::wstring::npos;
    if (!mentions) return false;
    const wchar_t* verbs[] = {L"coloque", L"colocar", L"defina", L"definir", L"aplique", L"aplicar", L"use como", L"usar como", L"troque por", L"coloca essa", L"coloque esse", L"coloque esta", L"coloque essa imagem"};
    bool verb = false;
    for (const auto* v : verbs) if (s.find(v) != std::wstring::npos) { verb = true; break; }
    if (!verb) return false;
    const wchar_t* neg[] = {L"não coloque", L"nao coloque", L"não aplique", L"nao aplique", L"não defina", L"nao defina", L"não quero colocar", L"nao quero colocar"};
    for (const auto* n : neg) if (s.find(n) != std::wstring::npos) return false;
    return true;
}

std::wstring ExtractExistingImagePathFromText(const std::wstring& raw) {
    // Accept an explicitly supplied Windows drive path; do not guess a filename from Explorer.
    size_t pos = std::wstring::npos;
    for (size_t i = 0; i + 2 < raw.size(); ++i) {
        if (((raw[i] >= L'A' && raw[i] <= L'Z') || (raw[i] >= L'a' && raw[i] <= L'z')) &&
            raw[i + 1] == L':' && (raw[i + 2] == L'\\' || raw[i + 2] == L'/')) { pos = i; break; }
    }
    if (pos == std::wstring::npos) return L"";
    size_t end = pos;
    bool quotedPath = pos > 0 && raw[pos - 1] == L'\"';
    if (quotedPath) {
        size_t closeQuote = raw.find(L'\"', pos);
        if (closeQuote != std::wstring::npos) end = closeQuote;
        else quotedPath = false;
    }
    if (!quotedPath) {
        while (end < raw.size() && raw[end] != L'\r' && raw[end] != L'\n' && raw[end] != L'\"' && raw[end] != L'<' && raw[end] != L'>' && raw[end] != L'|') {
            if (iswspace(raw[end])) break;
            ++end;
        }
    }
    std::wstring path = raw.substr(pos, end - pos);
    while (!path.empty() && (path.back() == L'.' || path.back() == L',' || path.back() == L';' || path.back() == L')')) path.pop_back();
    DWORD attr = path.empty() ? INVALID_FILE_ATTRIBUTES : GetFileAttributesW(path.c_str());
    if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY)) return L"";
    std::wstring low = Lower(path);
    const wchar_t* ext[] = {L".jpg", L".jpeg", L".png", L".bmp", L".gif", L".webp", L".tif", L".tiff"};
    for (const auto* e : ext) if (low.size() >= wcslen(e) && low.compare(low.size() - wcslen(e), wcslen(e), e) == 0) return path;
    return L"";
}

