    const std::wstring t = Lower(Trim(raw));
    return t.find(L"recort") != std::wstring::npos ||
           t.find(L"corte os rostos") != std::wstring::npos ||
           t.find(L"cortar os rostos") != std::wstring::npos ||
           t.find(L"separe os rostos") != std::wstring::npos ||
           t.find(L"divida a imagem") != std::wstring::npos ||
           t.find(L"cada rosto") != std::wstring::npos ||
           t.find(L"rostos separadamente") != std::wstring::npos;
}

bool MostRecentUserTurnWasImageCropRequest(const std::vector<Msg>& hist) {
    for (auto it = hist.rbegin(); it != hist.rend(); ++it) {
        if (it->user) return IsImageCropRequestText(FromUtf8(it->text));
    }
    return false;
}

void OnAiResult(AiResult& r) {
    const bool thisWasCropRetry = g_cropRetryInProgress;
    g_cropRetryInProgress = false;
    g_busy = false;
    InvalidateRect(g_panel, nullptr, FALSE);
    InvalidateRect(g_bubble, nullptr, FALSE);

    if (!r.ok) {
        g_avatarMood = L"error";
        g_avatarMoodUntil = GetTickCount() + 3500;
        // Consent takes priority over the scroll-failure message. This matters when
        // a manually selected model cannot process the before/after screenshots.
        if (r.needsVisionFallbackConsent && !g_hist.empty() && g_hist.back().user) {
            g_pendingVisionFallbackMessage = g_hist.back();
            g_hist.pop_back();
            g_pendingVisionFallbackConsent = true;
            const std::wstring ask = L"O modelo escolhido não conseguiu analisar a imagem. Quer que eu tente outro modelo com visão nesta tarefa? Responda **sim** ou **não**.";
            AppendAssistantReply(ask);
            SpeakReply(L"O modelo escolhido não conseguiu analisar a imagem. Quer que eu tente outro modelo com visão? Responda sim ou não.");
            return;
        }
        if (thisWasCropRetry) {
            const std::wstring failure = L"Não consegui concluir o recorte: a tentativa automática de recuperação falhou ao processar a imagem. Nenhum recorte foi confirmado como salvo. Verifique a conexão e selecione um modelo com visão habilitada.";
            if (!g_hist.empty() && g_hist.back().user) g_hist.pop_back();
            g_hist.push_back({false, ToUtf8(failure)});
            AppendAssistantReply(failure);
            SpeakReply(StripMarkdownForSpeech(failure));
            return;
        }
        if (g_scrollVerificationChainActive && g_actionChainActive) {
            g_scrollVerificationChainActive = false;
            g_scrollVerificationDirection = 0;
            if (!g_hist.empty() && !g_hist.back().user) g_hist.pop_back();
            if (!g_hist.empty() && g_hist.back().user) g_hist.pop_back(); // internal verification turn
            g_hist.push_back({false, ToUtf8(L"Enviei a rolagem, mas não consegui confirmar visualmente a mudança.")});
            FinishActionChain(L"Enviei a rolagem, mas não consegui confirmar visualmente a mudança.");
            return;
        }
        if (!g_hist.empty() && g_hist.back().user) g_hist.pop_back();
        std::wstring errLower = Lower(r.error);
        const bool quota = errLower.find(L"429") != std::wstring::npos ||
                           errLower.find(L"quota") != std::wstring::npos ||
                           errLower.find(L"rate limit") != std::wstring::npos ||
                           errLower.find(L"exceeded") != std::wstring::npos;
        if (g_actionChainActive) {
            std::wstring finalText;
            if (quota) {
                finalText = L"Executei as ações anteriores, mas não consegui verificar ou continuar porque a API atingiu o limite de uso. Não vou repetir ações automaticamente para evitar duplicações. Tente novamente mais tarde ou troque de provedor.";
            } else {
                finalText = L"A tarefa foi interrompida porque a IA não conseguiu processar a próxima etapa. As ações anteriores podem ter sido executadas, mas o resultado final não está confirmado.";
            }
            FinishActionChain(finalText);
        } else {
            if (quota) {
                AppendText(L"[Erro] A API atingiu o limite de uso. Nenhuma nova tentativa automática será feita. Aguarde a renovação da quota ou troque de provedor.\r\n\r\n");
            } else {
                AppendText(L"[Erro] " + ToCRLF(r.error) + L"\r\n\r\n");
            }
        }
        return;
    }

    std::wstring currentUserText;
    if (!g_hist.empty() && g_hist.back().user) currentUserText = FromUtf8(g_hist.back().text);
    std::string text = StripThink(r.text);
    ParsedReply pr = ParseAgentReply(text);

    const std::wstring lowerCropRequest = Lower(currentUserText);
    const bool explicitImageCropRequest = IsImageCropRequestText(currentUserText);
    const bool hasRealCropAction = std::any_of(pr.actions.begin(), pr.actions.end(),
        [](const Action& action) { return action.type == L"crop_image" && !action.cropBoxes.empty(); });
    const bool hasAttachedLocalImage =
        lowerCropRequest.find(L"[arquivo anexado:") != std::wstring::npos &&
        lowerCropRequest.find(L"caminho local:") != std::wstring::npos &&
        !g_hist.empty() && g_hist.back().user && !g_hist.back().attachedImageBase64.empty();

    // Models sometimes return only "Salvando recortes...". Do not show that as a
    // final answer: retry once with the same attached image and an explicit tool task.
    if (explicitImageCropRequest && !hasRealCropAction && !thisWasCropRetry && hasAttachedLocalImage) {
        EnsureAppIndex();
        std::vector<Msg> retryHistory = g_hist;
        Msg retryTurn = retryHistory.back();
        retryTurn.text += ToUtf8(
            L"\n\n[CONTINUAÇÃO AUTOMÁTICA OBRIGATÓRIA: a resposta anterior não iniciou nenhuma ferramenta. "
            L"Analise a imagem anexada nesta mesma mensagem agora. Retorne um JSON válido no formato normal do agente, "
            L"com reply curto ou vazio e actions contendo exatamente uma ação crop_image com path igual ao caminho local "
            L"da imagem anexada e boxes para cada rosto visível. Cada box deve ter x,y,width,height inteiros normalizados "
            L"de 0 a 1000, sem ultrapassar a imagem. NÃO responda 'estou recortando', 'salvando recortes' nem apenas texto; "
            L"gere a ação executável. Se não conseguir ver a imagem, retorne uma falha explícita sem inventar coordenadas.]");
        retryHistory.back() = std::move(retryTurn);
        auto* retryJob = new Job{g_panel, g_cfg,
            BuildSystemPrompt(g_cfg, g_apps) +
            "\n\nMANDATORY CROP TOOL RECOVERY: This is one automatic recovery call. The previous model response did not issue crop_image. You must return a valid JSON tool action crop_image using the attached image and its exact local path marker, with one normalized bounding box per visible face. No progress narration, no other actions, no false completion.",
            std::move(retryHistory)};
        g_busy = true;
        g_cropRetryInProgress = true;
        AppendText(L"[Tarefa] A resposta inicial não iniciou o recorte. Estou retomando a análise da imagem automaticamente.\r\n");
        InvalidateRect(g_panel, nullptr, FALSE);
        InvalidateRect(g_bubble, nullptr, FALSE);
        HANDLE retryThread = CreateThread(nullptr, 0, AiThread, retryJob, 0, nullptr);
        if (retryThread) {
            CloseHandle(retryThread);
            return;
        }
        delete retryJob;
        g_busy = false;
        g_cropRetryInProgress = false;
        InvalidateRect(g_panel, nullptr, FALSE);
        InvalidateRect(g_bubble, nullptr, FALSE);
        const std::wstring failure = L"Não consegui retomar a tarefa de recorte porque não foi possível iniciar a tentativa automática. Nenhum arquivo foi confirmado como salvo.";
        g_hist.push_back({false, ToUtf8(failure)});
        AppendAssistantReply(failure);
        SpeakReply(StripMarkdownForSpeech(failure));
        return;
    }

    // A textual progress sentence is never accepted as a completed crop operation.
    if (explicitImageCropRequest && !hasRealCropAction) {
        const std::wstring honestReply = hasAttachedLocalImage
            ? L"Não recortei a imagem: mesmo após tentar novamente, o modelo não forneceu coordenadas confiáveis para os rostos. Nenhum recorte foi confirmado como salvo. Tente com um modelo de visão habilitado."
            : L"Ainda não recortei a imagem porque não tenho o arquivo original disponível nesta solicitação. Anexe a imagem como arquivo e peça novamente; só confirmarei quando os arquivos existirem.";
        g_hist.push_back({false, ToUtf8(honestReply)});
        AppendAssistantReply(honestReply);
        SpeakReply(StripMarkdownForSpeech(honestReply));
        return;
    }

    g_hist.push_back({false, text});
    std::wstring generatedCode = ExtractCodeCandidate(FromUtf8(pr.reply));
    if (!generatedCode.empty()) g_lastSourceCandidate = std::move(generatedCode);

    // A simple scroll is executed once locally. The follow-up vision request is only
    // allowed to verify the two frames; it must never initiate a second scroll.
    if (g_scrollVerificationChainActive && g_actionChainActive) {
        g_scrollVerificationChainActive = false;
        const std::wstring verify = Lower(Trim(FromUtf8(pr.reply)));
        const int verifiedDirection = g_scrollVerificationDirection;
        const bool verified = verify.find(L"rolagem_verificada:") == 0;
        const bool explicitlyUnconfirmed = verify.find(L"rolagem_nao_confirmada:") == 0 ||
            verify.find(L"não foi possível confirmar") != std::wstring::npos ||
            verify.find(L"nao foi possivel confirmar") != std::wstring::npos ||
            verify.find(L"não consegui confirmar") != std::wstring::npos ||
            verify.find(L"nao consegui confirmar") != std::wstring::npos ||
            verify.find(L"não houve mudança") != std::wstring::npos ||
            verify.find(L"nao houve mudanca") != std::wstring::npos ||
            verify.find(L"no visible change") != std::wstring::npos ||
            verify.find(L"cannot confirm") != std::wstring::npos;
        const bool unexpectedActions = !pr.actions.empty();
        g_scrollVerificationDirection = 0;
        const std::wstring finalScrollReply = (verified && !explicitlyUnconfirmed && !unexpectedActions)
            ? (verifiedDirection < 0
                ? L"**Pronto! Rolei a página para baixo.**"
                : L"**Pronto! Rolei a página para cima.**")
            : L"Enviei a rolagem, mas não consegui confirmar visualmente a mudança.";
        // Do not retain the internal verification prompt or the model's protocol
        // marker in the visible conversation context. Keep only the real user task
        // and the concise, user-facing outcome.
        if (!g_hist.empty() && !g_hist.back().user) g_hist.pop_back();
        if (!g_hist.empty() && g_hist.back().user) g_hist.pop_back();
        g_hist.push_back({false, ToUtf8(finalScrollReply)});
        FinishActionChain(finalScrollReply);
        return;
    }

    // These common desktop intents are deterministic. Do not trust a model-generated
    // unrelated shortcut for them (e.g. WIN+D for wallpaper rotation).
    if (IsExplicitWallpaperRotateRequest(currentUserText)) {
        pr.actions.clear();
        pr.actions.push_back({L"wallpaper_rotate", L"clockwise"});
        pr.reply.clear();
    } else if (IsMinimizeAllWindowsRequest(currentUserText)) {
        pr.actions.clear();
        Action minimizeAll;
        minimizeAll.type = L"mouse_control";
        minimizeAll.arg = L"key";
        minimizeAll.detail = L"WIN+M";
        pr.actions.push_back(minimizeAll);
        pr.reply.clear();
    }
    {
        std::wstring mood = Lower(FromUtf8(pr.mood));
        const wchar_t* allowed[] = {L"idle", L"happy", L"curious", L"confused", L"sad", L"surprised", L"error"};
        bool validMood = false;
        for (const auto* value : allowed) if (mood == value) { validMood = true; break; }
        g_avatarMood = validMood ? mood : L"happy";
        g_avatarMoodUntil = GetTickCount() + 3500;
    }

    if (!pr.actions.empty()) {
        if (!g_actionChainActive) {
            g_actionChainActive = true;
            g_actionChainAuthorized = false;
            g_actionChainCancelled = false;
            g_actionSuccessCount = 0;
            g_actionFailureCount = 0;
            g_actionResultNotes.clear();
        }
        // Não mostrar nem falar a mensagem de intenção do modelo: primeiro executar.
        bool deferred = ExecuteActions(pr.actions);
        if (!deferred) FinishActionChain();
        return;
    }

    std::wstring reply = Trim(FromUtf8(pr.reply));
    if (g_actionChainActive) {
        // Não reproduz uma resposta que ainda esteja narrando intenção no futuro.
        std::wstring lowReply = Lower(reply);
        const wchar_t* futurePhrases[] = {
            L"vou ", L"agora vou", L"estou abrindo", L"estou clicando",
            L"vou clicar", L"vou tentar", L"irei ", L"estou tentando",
            L"em seguida vou", L"vou continuar"
        };
        for (const auto* phrase : futurePhrases) {
            if (lowReply.find(phrase) != std::wstring::npos) { reply.clear(); break; }
        }
        if (reply.empty()) reply = BuildLocalActionSummary();
        FinishActionChain(reply);
        return;
    }

    if (!reply.empty()) {
        AppendAssistantReply(reply);
        SpeakReply(StripMarkdownForSpeech(reply));
    } else {
        AppendText(L"IA: Não recebi uma resposta utilizável do modelo.\r\n\r\n");
    }
}

bool MentionsWallpaper(const std::wstring& s) {
    return s.find(L"wallpaper") != std::wstring::npos ||
           s.find(L"wallpeper") != std::wstring::npos ||
           s.find(L"walpeper") != std::wstring::npos ||
           s.find(L"papel de parede") != std::wstring::npos ||
           s.find(L"fundo da área de trabalho") != std::wstring::npos ||
           s.find(L"fundo da area de trabalho") != std::wstring::npos;
}

bool IsWallpaperInspectionRequest(const std::wstring& raw) {
    const std::wstring s = Lower(Trim(raw));
    if (!MentionsWallpaper(s) || IsExplicitWallpaperRotateRequest(raw)) return false;
    static const wchar_t* intent[] = {
        L"o que achou", L"oq achou", L"que achou", L"gostou", L"opinião", L"opiniao",
        L"avalie", L"analise", L"analisa", L"veja", L"ve", L"olhe", L"olha",
        L"mostre", L"como está", L"como esta", L"o que você acha", L"oq vc acha"
    };
    for (const auto* term : intent) if (s.find(term) != std::wstring::npos) return true;
    return false;
}

// Follow-ups such as “tem certeza?” refer to the last wallpaper review even when
// the user does not repeat the word wallpaper. They must trigger a fresh image,
// not ask a text-only model to defend or revise its prior guess.
bool IsVisualChallengeFollowUp(const std::wstring& raw) {
    const std::wstring s = Lower(Trim(raw));
    static const wchar_t* terms[] = {
        L"certeza", L"tem certeza", L"não é isso", L"nao e isso",
        L"não tem nada disso", L"nao tem nada disso", L"n tem nd disso",
        L"não tem nada", L"nao tem nada", L"você errou", L"voce errou",
        L"está errado", L"esta errado", L"tá errado", L"ta errado",
        L"olhe de novo", L"olha de novo", L"veja de novo", L"analise novamente",
        L"analisa de novo", L"isso não", L"isso nao", L"nada disso", L"confere de novo"
    };
    for (const auto* term : terms) {
        if (s.find(term) != std::wstring::npos) return true;
    }
    return false;
}

bool IsCurrentAppInspectionRequest(const std::wstring& raw) {
    const std::wstring s = Lower(Trim(raw));
    const bool namesApp = s.find(L"claude") != std::wstring::npos ||
        s.find(L"chrome") != std::wstring::npos || s.find(L"navegador") != std::wstring::npos ||
        s.find(L"edge") != std::wstring::npos || s.find(L"firefox") != std::wstring::npos ||
        s.find(L"aplicativo aberto") != std::wstring::npos || s.find(L"janela ativa") != std::wstring::npos;
    const bool asksState = s.find(L"fazendo") != std::wstring::npos || s.find(L"faz ") != std::wstring::npos ||
        s.find(L"está aberto") != std::wstring::npos || s.find(L"esta aberto") != std::wstring::npos ||
        s.find(L"está acontecendo") != std::wstring::npos || s.find(L"esta acontecendo") != std::wstring::npos ||
        s.find(L"o que") != std::wstring::npos || s.find(L"oq ") != std::wstring::npos ||
        s.find(L"mostra") != std::wstring::npos || s.find(L"aparece") != std::wstring::npos;
    return namesApp && asksState;
}

// Deterministic simple scrolling avoids relying on the model to invent an action
// JSON for an obvious command like "role a tela pra baixo".
int GetDirectScrollDirection(const std::wstring& raw) {
    const std::wstring s = Lower(Trim(raw));
    static const wchar_t* down[] = {
        L"role a tela para baixo", L"role a tela pra baixo", L"rola a tela para baixo", L"rola a tela pra baixo",
        L"rolar a tela para baixo", L"rolar a tela pra baixo", L"role para baixo", L"rola para baixo",
        L"rolar para baixo", L"desça a página", L"desca a pagina", L"desce a página", L"desce a pagina",
        L"vá para baixo na página", L"va para baixo na pagina", L"scroll down", L"page down", L"pagedown"
    };
    for (const auto* term : down) if (s.find(term) != std::wstring::npos) return -1;
    static const wchar_t* up[] = {
        L"role a tela para cima", L"role a tela pra cima", L"rola a tela para cima", L"rola a tela pra cima",
        L"rolar a tela para cima", L"rolar a tela pra cima", L"role para cima", L"rola para cima",
        L"rolar para cima", L"suba a página", L"suba a pagina", L"sobe a página", L"sobe a pagina",
        L"vá para cima na página", L"va para cima na pagina", L"scroll up", L"page up", L"pageup"
    };
    for (const auto* term : up) if (s.find(term) != std::wstring::npos) return 1;
    return 0;
}

bool IsDesktopInspectionRequest(const std::wstring& raw) {
    const std::wstring s = Lower(Trim(raw));
    const bool desktop = s.find(L"área de trabalho") != std::wstring::npos ||
        s.find(L"area de trabalho") != std::wstring::npos || s.find(L"desktop") != std::wstring::npos;
    if (!desktop || IsWallpaperInspectionRequest(raw) || IsExplicitWallpaperRotateRequest(raw)) return false;
    static const wchar_t* intents[] = {L"veja", L"ver", L"ve ", L"olhe", L"olha", L"observe", L"mostre", L"mostrar", L"analise", L"analisa", L"o que aparece", L"oq aparece", L"o que tem", L"como está", L"como esta"};
    for (const auto* term : intents) if (s.find(term) != std::wstring::npos) return true;
    return false;
}

bool ExplicitlyRequestsCurrentScreen(const std::wstring& raw) {
    const std::wstring s = Lower(Trim(raw));
    return s.find(L"tela") != std::wstring::npos ||
           s.find(L"área de trabalho") != std::wstring::npos ||
           s.find(L"area de trabalho") != std::wstring::npos ||
           s.find(L"desktop") != std::wstring::npos ||
           s.find(L"janela ativa") != std::wstring::npos ||
           s.find(L"aba ativa") != std::wstring::npos ||
           IsDesktopInspectionRequest(raw) || IsCurrentAppInspectionRequest(raw) || IsWallpaperInspectionRequest(raw);
}

std::string CaptureCurrentWallpaperJpegBase64() {
    wchar_t path[MAX_PATH] = {};
    if (!SystemParametersInfoW(SPI_GETDESKWALLPAPER, ARRAYSIZE(path), path, 0) || !path[0]) return {};
    return ImageFileToJpegBase64(path);
}

