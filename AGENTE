    if (a.type == L"ask_user") return L"Aguardar intervenção do usuário: " + a.arg;
    if (a.type == L"create_presentation") return L"Criar apresentação PowerPoint alternativa sobre: " + a.arg;
    if (a.type == L"open_latest_presentation") return L"Abrir a apresentação PowerPoint mais recente";
    if (a.type == L"window_control") return L"Controlar janela: " + a.arg;
    if (a.type == L"wallpaper_rotate") return L"Girar a imagem do papel de parede e aplicar uma cópia girada";
    if (a.type == L"wallpaper_set") return L"Definir imagem como papel de parede: " + a.arg;
    if (a.type == L"crop_image") return L"Recortar imagem em " + std::to_wstring(a.cropBoxes.size()) + L" partes: " + FileNameOnly(a.arg);
    if (a.type == L"mouse_control") {
