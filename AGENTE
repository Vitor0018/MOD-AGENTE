bool WebSearch(const std::wstring& query, std::wstring& info) {
    std::wstring q = Trim(query);
    if (q.empty()) {
        info = L"Pesquisa vazia.";
        return false;
    }
    bool siteActionResult = false;
    if (TryExplicitSiteSearch(q, info, siteActionResult)) return siteActionResult;
    std::wstring base = L"https://www.google.com/search?q=";
    if (g_cfg.searchEngine == L"bing") base = L"https://www.bing.com/search?q=";
    else if (g_cfg.searchEngine == L"duckduckgo") base = L"https://duckduckgo.com/?q=";
    std::wstring url = base + FromUtf8(UrlEncode(ToUtf8(q)));
    if (!ShellOpen(url)) {
        info = L"Não consegui abrir o navegador.";
        return false;
    }
    info = L"Pesquisando: " + q;
    return true;
}

void ScheduleSiteSearchReview(const std::wstring& site, const std::wstring& query) {
    // Only inspect the page after navigation when the user explicitly enabled screen vision.
    if (!g_cfg.screenVision || !g_bubble || !IsWindow(g_bubble)) {
        g_pendingSiteReview = false;
        return;
    }
    g_pendingSiteName = site;
    g_pendingSiteQuery = query;
    KillTimer(g_bubble, 3);
    g_pendingSiteReview = SetTimer(g_bubble, 3, 3800, nullptr) != 0;
}

void ScheduleScreenReview(const std::wstring& instruction, UINT delayMs = 1300) {
    if (!g_cfg.screenVision || !g_bubble || !IsWindow(g_bubble)) {
        g_pendingScreenReview = false;
        g_pendingScreenInstruction.clear();
        return;
    }
    KillTimer(g_bubble, 4);
    g_pendingScreenInstruction = instruction;
    g_pendingScreenReview = SetTimer(g_bubble, 4, delayMs, nullptr) != 0;
    if (!g_pendingScreenReview) g_pendingScreenInstruction.clear();
}

bool SiteSearch(const std::wstring& rawSite, const std::wstring& rawQuery,
                std::wstring& info) {
    const std::wstring site = Lower(Trim(rawSite));
    const std::wstring query = Trim(rawQuery);
    if (site.empty() || query.empty()) {
        info = L"A pesquisa no site precisa de um site e de um termo.";
        return false;
    }
    // Search URLs are deliberately site-specific. We never silently redirect this
    // action to Google/Bing when a user named a particular service.

    const SiteSearchEntry* match = nullptr;
    for (const auto& entry : kSiteSearchSites) {
        if (AliasMatches(site, entry.aliases)) { match = &entry; break; }
    }
    if (!match) {
        // Unknown site: open that site, but do not falsely claim an internal search
        // or secretly replace the destination with a general search engine.
        std::wstring url = Trim(rawSite);
        if (url.find(L".") == std::wstring::npos || url.find_first_of(L" \t\r\n") != std::wstring::npos) {
            info = L"Ainda não tenho uma rota de busca interna configurada para '" + rawSite +
                   L"'. Não substituí pelo Google. Informe o domínio/URL do site para eu tentar a busca dentro dele.";
            return false;
        }
        if (!StartsWithNoCase(url, L"http://") && !StartsWithNoCase(url, L"https://"))
            url = L"https://" + url;
        size_t authorityStart = StartsWithNoCase(url, L"https://") ? 8 : 7;
        size_t pathStart = url.find(L'/', authorityStart);
        std::wstring origin = pathStart == std::wstring::npos ? url : url.substr(0, pathStart);
        std::wstring encoded = FromUtf8(UrlEncode(ToUtf8(query)));
        std::wstring searchUrl = origin + L"/search?q=" + encoded;
        if (!ShellOpen(searchUrl)) {
            info = L"Não consegui abrir a tentativa de busca interna em " + origin + L".";
            return false;
        }
        info = L"O site não tem um modelo de busca conhecido. Tentei a rota interna comum em " + searchUrl +
               L"; vou verificar os resultados visíveis se a Visão da tela estiver ativada. Não usei o Google.";
        ScheduleSiteSearchReview(rawSite, query);
        return true;
    }
    std::wstring encoded = FromUtf8(UrlEncode(ToUtf8(query)));
    std::wstring url = std::wstring(match->urlPrefix) + encoded + match->urlSuffix;
    // Entries that are destinations rather than search endpoints should not be
    // reported as a search. They intentionally open only the exact requested site.
    if (std::wstring(match->name) == L"MapChart" || std::wstring(match->name) == L"Wayback Machine" ||
        std::wstring(match->name) == L"Portal de Periódicos CAPES") {
        url = match->urlPrefix;
        if (!ShellOpen(url)) { info = L"Não consegui abrir " + std::wstring(match->name) + L"."; return false; }
        info = L"Abri " + std::wstring(match->name) + L". Não há uma rota de busca direta configurada para esse site; não usei o Google.";
        return true;
    }
    if (!ShellOpen(url)) {
        info = L"Não consegui abrir a busca interna de " + std::wstring(match->name) + L".";
        return false;
    }
    info = L"Pesquisando diretamente em " + std::wstring(match->name) + L": " + query;
    ScheduleSiteSearchReview(match->name, query);
    return true;
}

bool TryExplicitSiteSearch(const std::wstring& fallbackQuery, std::wstring& info,
                           bool& actionResult) {
    std::wstring request;
    for (auto it = g_hist.rbegin(); it != g_hist.rend(); ++it) {
        if (it->user) { request = Lower(FromUtf8(it->text)); break; }
    }
    if (request.empty()) return false;
    const wchar_t* searchVerbs[] = {L"pesquis", L"busc", L"procur", L"encontr", L"ache", L"search", L"find"};
    bool hasSearchVerb = false;
    for (const auto* verb : searchVerbs) if (request.find(verb) != std::wstring::npos) { hasSearchVerb = true; break; }
    if (!hasSearchVerb) return false;

    auto endsWith = [](const std::wstring& text, const wchar_t* suffix) {
        const size_t n = wcslen(suffix);
        return text.size() >= n && text.compare(text.size() - n, n, suffix) == 0;
    };
    for (const auto& entry : kSiteSearchSites) {
        std::wstring aliases = entry.aliases ? entry.aliases : L"";
        size_t aliasStart = 0;
        while (aliasStart < aliases.size()) {
            size_t aliasEnd = aliases.find(L'|', aliasStart);
            if (aliasEnd == std::wstring::npos) aliasEnd = aliases.size();
            std::wstring alias = Lower(Trim(aliases.substr(aliasStart, aliasEnd - aliasStart)));
            aliasStart = aliasEnd + 1;
            if (alias.empty()) continue;
            size_t pos = request.find(alias);
            while (pos != std::wstring::npos) {
                const bool leftBoundary = pos == 0 || !std::iswalnum(request[pos - 1]);
                const size_t after = pos + alias.size();
                const bool rightBoundary = after >= request.size() || !std::iswalnum(request[after]);
                if (leftBoundary && rightBoundary) {
                    std::wstring prefix = Trim(request.substr(0, pos));
                    while (!prefix.empty() && (prefix.back() == L',' || prefix.back() == L':' || prefix.back() == L'!' || prefix.back() == L'.')) prefix.pop_back();
                    prefix = Trim(prefix);
                    const wchar_t* destinationEnds[] = {
                        L" no", L" na", L" em", L" dentro do", L" dentro da", L" dentro de",
                        L" no site", L" na plataforma", L" no aplicativo", L" no app", L" no programa",
                        L" do site", L" da plataforma", L" do aplicativo", L" do app", L" do programa",
                        L" on", L" in", L" inside", L" within", L" abra o", L" abrir o", L" abre o",
                        L" abra a", L" abrir a", L" abre a", L" acessa o", L" acessar o"
                    };
                    bool explicitDestination = false;
                    for (const auto* suffix : destinationEnds) if (endsWith(prefix, suffix)) { explicitDestination = true; break; }
                    // Also accept formulations like "open Pinterest and search..." where
                    // the site appears before the search verb rather than after "on/in".
                    bool opensThenSearch = false;
                    if (!explicitDestination) {
                        size_t openPos = prefix.find(L"abre ");
                        if (openPos == std::wstring::npos) openPos = prefix.find(L"abra ");
                        if (openPos == std::wstring::npos) openPos = prefix.find(L"abrir ");
                        opensThenSearch = openPos != std::wstring::npos && request.find(L"pesquis", after) != std::wstring::npos;
                    }
                    if (explicitDestination || opensThenSearch) {
                        actionResult = SiteSearch(entry.name, fallbackQuery, info);
                        return true;
                    }
                }
                pos = request.find(alias, pos + 1);
            }
        }
    }
    return false;
}

bool AppSearch(const std::wstring& rawApp, const std::wstring& rawQuery,
               std::wstring& info) {
    const std::wstring app = Lower(Trim(rawApp));
    const std::wstring query = Trim(rawQuery);
    if (app.empty() || query.empty()) {
        info = L"A pesquisa no aplicativo precisa de um nome e de um termo.";
        return false;
    }
    const std::wstring encoded = FromUtf8(UrlEncode(ToUtf8(query)));
    std::wstring uri;
    std::wstring displayName = rawApp;
    // Only use documented, app-specific URI handlers. No global web-search fallback.
    if (app.find(L"spotify") != std::wstring::npos) {
        uri = L"spotify:search:" + encoded;
        displayName = L"Spotify";
    } else if (app.find(L"steam") != std::wstring::npos) {
        uri = L"steam://store/search/" + encoded;
        displayName = L"Steam";
    } else if (app.find(L"microsoft store") != std::wstring::npos || app == L"store") {
        uri = L"ms-windows-store://search/?query=" + encoded;
        displayName = L"Microsoft Store";
    } else {
        info = L"Ainda não tenho um atalho de busca nativa confiável para " + rawApp +
               L". Não vou trocar isso por uma busca no Google. Posso abrir o app, mas a pesquisa precisa ser automatizada especificamente para ele.";
        return false;
    }
    if (!ShellOpen(uri)) {
        info = L"Não consegui encaminhar a busca para o aplicativo " + displayName +
               L". Verifique se ele está instalado e se o protocolo está registrado.";
        return false;
    }
    info = L"Enviando a busca para o aplicativo " + displayName + L": " + query;
    return true;
}

bool OpenFolder(const std::wstring& raw, std::wstring& info) {
    std::wstring p = Trim(raw);
    std::wstring l = Lower(p);
    // Resolve common relative aliases for the screenshot folder to the exact
    // absolute location used by SaveScreenshotJpegBase64. Never validate these
    // aliases as relative paths against the process working directory.
    std::replace(p.begin(), p.end(), L'/', L'\\');
    l = Lower(p);
    const std::wstring screenshotFolderName = L"ai-agent-bubble-screenshots";
    const bool screenshotFolderAlias =
        l == screenshotFolderName ||
        l == L"pictures\\ai-agent-bubble-screenshots" ||
        l == L"imagens\\ai-agent-bubble-screenshots" ||
        l == L"fotos\\ai-agent-bubble-screenshots" ||
        l == L"shell:mypictures\\ai-agent-bubble-screenshots";
    if (screenshotFolderAlias) {
        if (!g_lastScreenshotFolder.empty()) {
            p = g_lastScreenshotFolder;
        } else {
            WCHAR pictures[MAX_PATH] = {};
            if (SUCCEEDED(SHGetFolderPathW(nullptr, CSIDL_MYPICTURES, nullptr, SHGFP_TYPE_CURRENT, pictures)))
                p = std::wstring(pictures) + L"\\AI-Agent-Bubble-Screenshots";
        }
        l = Lower(p);
    }
    const wchar_t* shell = nullptr;
    if (l == L"downloads" || l == L"download") shell = L"shell:Downloads";
    else if (l == L"documents" || l == L"documentos") shell = L"shell:Personal";
    else if (l == L"desktop" || l == L"área de trabalho" || l == L"area de trabalho")
        shell = L"shell:Desktop";
    else if (l == L"pictures" || l == L"imagens" || l == L"fotos") shell = L"shell:My Pictures";
    else if (l == L"music" || l == L"músicas" || l == L"musicas") shell = L"shell:My Music";
    else if (l == L"videos" || l == L"vídeos") shell = L"shell:My Video";
    if (shell) {
        if (!ShellOpen(shell)) { info = L"Não consegui abrir a pasta."; return false; }
        info = L"Abrindo pasta: " + p;
        return true;
    }
    DWORD attr = GetFileAttributesW(p.c_str());
    if (p.empty() || attr == INVALID_FILE_ATTRIBUTES || !(attr & FILE_ATTRIBUTE_DIRECTORY)) {
        info = L"Pasta não encontrada: " + p;
        return false;
    }
    if (!ShellOpen(p)) { info = L"Não consegui abrir a pasta."; return false; }
    info = L"Abrindo pasta: " + p;
    return true;
}

bool CopyText(const std::wstring& text, std::wstring& info) {
    if (!OpenClipboard(g_panel)) {
        info = L"Não consegui acessar a área de transferência.";
        return false;
    }
    EmptyClipboard();
    size_t bytes = (text.size() + 1) * sizeof(wchar_t);
    HGLOBAL mem = GlobalAlloc(GMEM_MOVEABLE, bytes);
    bool ok = false;
    if (mem) {
        void* ptr = GlobalLock(mem);
        if (ptr) {
            memcpy(ptr, text.c_str(), bytes);
            GlobalUnlock(mem);
            ok = SetClipboardData(CF_UNICODETEXT, mem) != nullptr;
        }
        if (!ok) GlobalFree(mem);
    }
    CloseClipboard();
    info = ok ? L"Texto copiado para a área de transferência."
              : L"Falha ao copiar o texto.";
    return ok;
}

bool RunCommand(const std::wstring& cmd, std::wstring& info) {
    std::wstring params = L"/k " + cmd;
    if (!ShellOpen(L"cmd.exe", params.c_str())) {
        info = L"Não consegui executar o comando.";
        return false;
    }
    info = L"Executando comando no cmd.";
    return true;
}


std::wstring PowerShellQuote(const std::wstring& value) {
    std::wstring out = L"'";
    for (wchar_t ch : value) {
        if (ch == L'\'') out += L"''";
        else out += ch;
    }
    out += L"'";
    return out;
}

std::wstring PowerShellDoubleQuote(const std::wstring& value) {
    std::wstring out = L"\"";
    for (size_t i = 0; i < value.size(); ++i) {
        wchar_t ch = value[i];
        if (ch == L'\r') {
            if (i + 1 < value.size() && value[i + 1] == L'\n') ++i;
            out += L"`r`n";
        } else if (ch == L'\n') {
            out += L"`n";
        } else {
            if (ch == L'`' || ch == L'\"' || ch == L'$') out += L'`';
            out += ch;
        }
    }
    out += L"\"";
    return out;
}

