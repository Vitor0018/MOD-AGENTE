// Detecta um pedido explícito para configurar a pasta de avatares. Esse pedido é
// tratado localmente: nunca deve ser convertido em cliques/digitação no Explorer.
bool TryConfigureAvatarFolderRequest(const std::wstring& raw, std::wstring& reply) {
    const std::wstring low = Lower(raw);
    const bool mentionsAvatar = low.find(L"avatar") != std::wstring::npos ||
        low.find(L"avatares") != std::wstring::npos || low.find(L"expressões") != std::wstring::npos ||
        low.find(L"expressoes") != std::wstring::npos;
    const bool isInstruction = low.find(L"use este caminho") != std::wstring::npos ||
        low.find(L"usar este caminho") != std::wstring::npos ||
        low.find(L"colocar os seus avatares") != std::wstring::npos ||
        low.find(L"pasta dos avatares") != std::wstring::npos ||
        low.find(L"caminho dos avatares") != std::wstring::npos ||
        low.find(L"configure a pasta") != std::wstring::npos;
    if (!mentionsAvatar || !isInstruction) return false;

    std::wstring path;
    // Prioriza caminho entre aspas; depois procura um caminho absoluto com letra de unidade.
    size_t q1 = raw.find(L'"');
    if (q1 != std::wstring::npos) {
        size_t q2 = raw.find(L'"', q1 + 1);
        if (q2 != std::wstring::npos && q2 > q1 + 1) path = raw.substr(q1 + 1, q2 - q1 - 1);
    }
    if (path.empty()) {
        for (size_t i = 0; i + 2 < raw.size(); ++i) {
            if (((raw[i] >= L'A' && raw[i] <= L'Z') || (raw[i] >= L'a' && raw[i] <= L'z')) &&
                raw[i + 1] == L':' && (raw[i + 2] == L'\\' || raw[i + 2] == L'/')) {
                size_t end = i;
                while (end < raw.size() && raw[end] != L'\r' && raw[end] != L'\n' && raw[end] != L'"' && raw[end] != L'\'') ++end;
                path = Trim(raw.substr(i, end - i));
                while (!path.empty() && (path.back() == L'.' || path.back() == L',' || path.back() == L';')) path.pop_back();
                break;
            }
        }
    }
    path = Trim(path);
    std::replace(path.begin(), path.end(), L'/', L'\\');
    if (path.empty()) {
        reply = L"Não encontrei um caminho absoluto na mensagem. Envie, por exemplo: use este caminho para os avatares \"C:\\Users\\SeuNome\\Pictures\\AI-Agent-Avatars\".";
        return true;
    }
    // Expandir variáveis de ambiente e criar a pasta sem abrir o Explorer.
    path = ExpandEnvironment(path);
    DWORD attr = GetFileAttributesW(path.c_str());
    if (attr == INVALID_FILE_ATTRIBUTES) {
        int rc = SHCreateDirectoryExW(nullptr, path.c_str(), nullptr);
        if (rc != ERROR_SUCCESS && rc != ERROR_ALREADY_EXISTS && rc != ERROR_FILE_EXISTS) {
            reply = L"Não consegui criar a pasta de avatares. Verifique o caminho e as permissões.";
            return true;
        }
    } else if (!(attr & FILE_ATTRIBUTE_DIRECTORY)) {
        reply = L"O caminho informado existe, mas não é uma pasta. Escolha uma pasta para os avatares.";
        return true;
    }
    g_cfg.avatarFolder = path;
    g_avatarCache.clear(); // permite carregar imediatamente os arquivos da nova pasta
    if (g_panel) InvalidateRect(g_panel, nullptr, FALSE);
    if (g_bubble) InvalidateRect(g_bubble, nullptr, FALSE);
    reply = L"**Pasta de avatares configurada!** Coloque nela `idle.png` ou `avatar.png`. A configuração vale para esta sessão; se o Windhawk não persistir essa opção, informe o caminho em Configurações do mod também.";
    return true;
}

