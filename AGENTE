// Converte coordenadas normalizadas (0..1000) da captura para coordenadas reais
// do desktop virtual. Assim funciona também quando a captura foi reduzida para a IA.
bool MoveCursorNormalized(int nx, int ny, std::wstring& info) {
    if (nx < 0 || nx > 1000 || ny < 0 || ny > 1000) {
        info = L"Coordenadas inválidas. Use x e y entre 0 e 1000 relativos à captura.";
        return false;
    }
    const int left = GetSystemMetrics(SM_XVIRTUALSCREEN);
    const int top = GetSystemMetrics(SM_YVIRTUALSCREEN);
    const int width = GetSystemMetrics(SM_CXVIRTUALSCREEN);
    const int height = GetSystemMetrics(SM_CYVIRTUALSCREEN);
    if (width <= 0 || height <= 0) {
        info = L"Não consegui determinar o tamanho da área de trabalho.";
        return false;
    }
    const int px = left + MulDiv(nx, width - 1, 1000);
    const int py = top + MulDiv(ny, height - 1, 1000);
    if (!SetCursorPos(px, py)) {
        info = L"O Windows não permitiu mover o cursor.";
        return false;
    }
    return true;
}

WORD VirtualKeyForName(std::wstring key) {
    key = Lower(Trim(key));
    if (key.size() == 1) {
        wchar_t c = towupper(key[0]);
        SHORT vk = VkKeyScanW(c);
        return vk == -1 ? 0 : LOBYTE(vk);
    }
    if (key == L"enter" || key == L"return") return VK_RETURN;
    if (key == L"tab") return VK_TAB;
    if (key == L"esc" || key == L"escape") return VK_ESCAPE;
    if (key == L"space" || key == L"espaço") return VK_SPACE;
    if (key == L"backspace") return VK_BACK;
    if (key == L"delete" || key == L"del") return VK_DELETE;
    if (key == L"home") return VK_HOME;
    if (key == L"end") return VK_END;
    if (key == L"pageup") return VK_PRIOR;
    if (key == L"pagedown") return VK_NEXT;
    if (key == L"up" || key == L"arrowup") return VK_UP;
    if (key == L"down" || key == L"arrowdown") return VK_DOWN;
    if (key == L"left" || key == L"arrowleft") return VK_LEFT;
    if (key == L"right" || key == L"arrowright") return VK_RIGHT;
    if (key == L"f1") return VK_F1;
    if (key == L"f2") return VK_F2;
    if (key == L"f3") return VK_F3;
    if (key == L"f4") return VK_F4;
    if (key == L"f5") return VK_F5;
    if (key == L"f6") return VK_F6;
    if (key == L"f7") return VK_F7;
    if (key == L"f8") return VK_F8;
    if (key == L"f9") return VK_F9;
    if (key == L"f10") return VK_F10;
    if (key == L"f11") return VK_F11;
    if (key == L"f12") return VK_F12;
    return 0;
}

bool SendKeyCombo(const std::wstring& combo, std::wstring& info) {
    std::vector<std::wstring> parts;
    size_t start = 0;
    while (start <= combo.size()) {
        size_t pos = combo.find(L'+', start);
        if (pos == std::wstring::npos) pos = combo.size();
        parts.push_back(Trim(combo.substr(start, pos - start)));
        if (pos == combo.size()) break;
        start = pos + 1;
    }
    if (parts.empty() || parts.size() > 4) {
        info = L"Atalho não reconhecido.";
        return false;
    }
    std::vector<WORD> mods;
    WORD mainKey = 0;
    for (const auto& part : parts) {
        std::wstring l = Lower(part);
        if (l == L"ctrl" || l == L"control") mods.push_back(VK_CONTROL);
        else if (l == L"shift") mods.push_back(VK_SHIFT);
        else if (l == L"alt") mods.push_back(VK_MENU);
        else if (l == L"win" || l == L"windows") mods.push_back(VK_LWIN);
        else mainKey = VirtualKeyForName(part);
    }
    if (!mainKey) {
        info = L"Tecla não reconhecida. Exemplos: ENTER, TAB, ESC, CTRL+L, CTRL+T, CTRL+W ou CTRL+R.";
        return false;
    }
    std::vector<INPUT> inputs;
    auto keyInput = [](WORD vk, bool up) {
        INPUT in{}; in.type = INPUT_KEYBOARD; in.ki.wVk = vk;
        if (up) in.ki.dwFlags = KEYEVENTF_KEYUP;
        return in;
    };
    for (WORD m : mods) inputs.push_back(keyInput(m, false));
    inputs.push_back(keyInput(mainKey, false));
    inputs.push_back(keyInput(mainKey, true));
    for (auto it = mods.rbegin(); it != mods.rend(); ++it) inputs.push_back(keyInput(*it, true));
    UINT sent = SendInput(static_cast<UINT>(inputs.size()), inputs.data(), sizeof(INPUT));
    if (sent != inputs.size()) {
        info = L"O Windows não aceitou o atalho de teclado.";
        return false;
    }
    info = L"Atalho de teclado enviado: " + combo;
    return true;
}

bool TypeUnicodeText(const std::wstring& text, std::wstring& info) {
    if (text.empty()) { info = L"O texto está vazio."; return false; }
    if (text.size() > 1200) { info = L"Por segurança, digite no máximo 1200 caracteres por ação."; return false; }
    std::vector<INPUT> inputs;
    inputs.reserve(text.size() * 2);
    for (wchar_t ch : text) {
        INPUT down{}; down.type = INPUT_KEYBOARD; down.ki.wScan = ch;
        down.ki.dwFlags = KEYEVENTF_UNICODE;
        INPUT up = down; up.ki.dwFlags = KEYEVENTF_UNICODE | KEYEVENTF_KEYUP;
        inputs.push_back(down); inputs.push_back(up);
    }
    UINT sent = SendInput(static_cast<UINT>(inputs.size()), inputs.data(), sizeof(INPUT));
    if (sent != inputs.size()) { info = L"O Windows aceitou apenas parte do texto."; return false; }
    info = L"Texto digitado na janela/campo que estava em foco.";
    return true;
}

bool MouseControl(const Action& a, std::wstring& info) {
    const std::wstring cmd = Lower(Trim(a.arg));
    if (cmd == L"key" || cmd == L"press_key") return SendKeyCombo(a.detail, info);
    if (cmd == L"type_text" || cmd == L"type") return TypeUnicodeText(a.detail, info);
    const bool isScroll = cmd == L"scroll_up" || cmd == L"scroll_down";
    if (cmd == L"move" || cmd == L"click" || cmd == L"double_click" ||
        cmd == L"right_click" || cmd == L"middle_click" || isScroll || cmd == L"drag") {
        if (!MoveCursorNormalized(a.x, a.y, info)) {
            if (isScroll) { g_scrollVerificationPending = false; g_scrollBeforeScreenshot.clear(); }
            return false;
        }
    }
    if (isScroll && g_cfg.screenVision) {
        // Move first and remove the agent overlay before capturing the baseline.
        Sleep(120);
        g_scrollBeforeScreenshot = CaptureScreenForVisionJpegBase64();
        g_scrollVerificationPending = !g_scrollBeforeScreenshot.empty();
    }
    if (cmd == L"move") {
        info = L"Cursor movido para a posição identificada na captura.";
        return true;
    }
    if (cmd == L"drag") {
        if (a.x2 < 0 || a.y2 < 0 || a.x2 > 1000 || a.y2 > 1000) {
            info = L"Arrastar exige x2 e y2 entre 0 e 1000."; return false;
        }
        INPUT down{}; down.type = INPUT_MOUSE; down.mi.dwFlags = MOUSEEVENTF_LEFTDOWN;
        if (SendInput(1, &down, sizeof(INPUT)) != 1) { info = L"Não consegui iniciar o arrasto."; return false; }
        int sx = a.x, sy = a.y;
        for (int i = 1; i <= 12; ++i) {
            int nx = sx + MulDiv(a.x2 - sx, i, 12);
            int ny = sy + MulDiv(a.y2 - sy, i, 12);
            std::wstring ignored;
            MoveCursorNormalized(nx, ny, ignored);
            Sleep(12);
        }
        INPUT up{}; up.type = INPUT_MOUSE; up.mi.dwFlags = MOUSEEVENTF_LEFTUP;
        SendInput(1, &up, sizeof(INPUT));
        info = L"Arrasto do ponto inicial ao final enviado.";
        return true;
    }
    if (isScroll) {
        // The cursor can be over the always-on-top agent panel. Hide the agent for
        // the actual wheel event as well as for the screenshot, so the underlying
        // browser/document receives the scroll instead of the assistant UI.
        const bool panelWasVisible = g_panel && IsWindow(g_panel) && IsWindowVisible(g_panel);
        const bool bubbleWasVisible = g_bubble && IsWindow(g_bubble) && IsWindowVisible(g_bubble);
        if (panelWasVisible) ShowWindow(g_panel, SW_HIDE);
        if (bubbleWasVisible) ShowWindow(g_bubble, SW_HIDE);
        Sleep(70);
        INPUT wheel{};
        wheel.type = INPUT_MOUSE;
        wheel.mi.dwFlags = MOUSEEVENTF_WHEEL;
        wheel.mi.mouseData = cmd == L"scroll_up"
            ? static_cast<DWORD>(WHEEL_DELTA * 3)
            : static_cast<DWORD>(-WHEEL_DELTA * 3);
        const UINT sent = SendInput(1, &wheel, sizeof(INPUT));
        Sleep(80);
        if (bubbleWasVisible) ShowWindow(g_bubble, SW_SHOWNOACTIVATE);
        if (panelWasVisible) ShowWindow(g_panel, SW_SHOWNOACTIVATE);
        if (panelWasVisible && g_panel) SetWindowPos(g_panel, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
        if (bubbleWasVisible && g_bubble) SetWindowPos(g_bubble, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
        if (sent != 1) {
            g_scrollVerificationPending = false;
            g_scrollBeforeScreenshot.clear();
            g_scrollVerificationChainActive = false;
            g_scrollVerificationDirection = 0;
            info = L"O Windows não aceitou a rolagem da página.";
            return false;
        }
        info = cmd == L"scroll_up" ? L"Rolagem para cima enviada; aguardando verificação visual." :
                                      L"Rolagem para baixo enviada; aguardando verificação visual.";
        return true;
    }
    DWORD downFlag = 0, upFlag = 0;
    if (cmd == L"click" || cmd == L"double_click") { downFlag = MOUSEEVENTF_LEFTDOWN; upFlag = MOUSEEVENTF_LEFTUP; }
    else if (cmd == L"right_click") { downFlag = MOUSEEVENTF_RIGHTDOWN; upFlag = MOUSEEVENTF_RIGHTUP; }
    else if (cmd == L"middle_click") { downFlag = MOUSEEVENTF_MIDDLEDOWN; upFlag = MOUSEEVENTF_MIDDLEUP; }
    else {
        info = L"Comando de mouse não reconhecido. Use move, click, double_click, right_click, middle_click, scroll_up, scroll_down, drag, key ou type_text.";
        return false;
    }
    INPUT clicks[2]{};
    clicks[0].type = INPUT_MOUSE; clicks[0].mi.dwFlags = downFlag;
    clicks[1].type = INPUT_MOUSE; clicks[1].mi.dwFlags = upFlag;
    if (SendInput(2, clicks, sizeof(INPUT)) != 2) { info = L"O Windows não aceitou o clique."; return false; }
    if (cmd == L"double_click") {
        Sleep(80);
        SendInput(2, clicks, sizeof(INPUT));
        info = L"Duplo clique enviado na posição selecionada.";
    } else if (cmd == L"right_click") info = L"Clique com o botão direito enviado.";
    else if (cmd == L"middle_click") info = L"Clique com o botão do meio enviado.";
    else info = L"Clique esquerdo enviado.";
    return true;
}

bool RotateCurrentWallpaper(const std::wstring& rawDirection, std::wstring& info) {
    wchar_t current[MAX_PATH] = {};
    if (!SystemParametersInfoW(SPI_GETDESKWALLPAPER, MAX_PATH, current, 0) || !current[0]) {
        info = L"Não consegui localizar o arquivo do papel de parede atual. Se o Windows estiver usando um plano de fundo dinâmico, escolha uma imagem estática primeiro.";
        return false;
    }
    const std::wstring direction = Lower(Trim(rawDirection));
    Gdiplus::RotateFlipType rotate = Gdiplus::Rotate90FlipNone;
    std::wstring suffix = L"clockwise";
    if (direction == L"counterclockwise" || direction == L"anti-horário" || direction == L"anti-horario" || direction == L"esquerda" || direction == L"left") {
        rotate = Gdiplus::Rotate270FlipNone;
        suffix = L"counterclockwise";
    } else if (direction == L"180" || direction == L"half" || direction == L"meia-volta") {
        rotate = Gdiplus::Rotate180FlipNone;
        suffix = L"180";
    }

    wchar_t localAppData[MAX_PATH] = {};
    DWORD envLen = GetEnvironmentVariableW(L"LOCALAPPDATA", localAppData, MAX_PATH);
    if (!envLen || envLen >= MAX_PATH) {
        info = L"Não consegui acessar a pasta local do usuário para salvar uma cópia girada.";
        return false;
    }
    std::wstring outDir = std::wstring(localAppData) + L"\\AI-Agent-Bubble";
    if (!CreateDirectoryW(outDir.c_str(), nullptr) && GetLastError() != ERROR_ALREADY_EXISTS) {
        info = L"Não consegui criar a pasta para salvar a cópia do papel de parede.";
        return false;
    }
    std::wstring outPath = outDir + L"\\wallpaper_rotated_" + suffix + L"_" + std::to_wstring(GetTickCount64()) + L".jpg";

    Gdiplus::GdiplusStartupInput startup;
    ULONG_PTR token = 0;
    if (Gdiplus::GdiplusStartup(&token, &startup, nullptr) != Gdiplus::Ok) {
        info = L"Não consegui inicializar o processamento de imagens do Windows.";
        return false;
    }

    bool saved = false;
    {
        Gdiplus::Image image(current, FALSE);
        if (image.GetLastStatus() == Gdiplus::Ok) {
            image.RotateFlip(rotate);
            CLSID jpeg{};
            if (image.GetLastStatus() == Gdiplus::Ok && GetJpegEncoder(&jpeg)) {
                Gdiplus::EncoderParameters ep{};
                ULONG quality = 94;
                ep.Count = 1;
                ep.Parameter[0].Guid = Gdiplus::EncoderQuality;
                ep.Parameter[0].Type = Gdiplus::EncoderParameterValueTypeLong;
                ep.Parameter[0].NumberOfValues = 1;
                ep.Parameter[0].Value = &quality;
                saved = image.Save(outPath.c_str(), &jpeg, &ep) == Gdiplus::Ok;
            }
        }
    }
    Gdiplus::GdiplusShutdown(token);
    if (!saved || GetFileAttributesW(outPath.c_str()) == INVALID_FILE_ATTRIBUTES) {
        info = L"Não consegui gerar a cópia girada. O arquivo original foi mantido intacto.";
        return false;
    }

    if (!SystemParametersInfoW(SPI_SETDESKWALLPAPER, 0, const_cast<LPWSTR>(outPath.c_str()), SPIF_UPDATEINIFILE | SPIF_SENDCHANGE)) {
        info = L"A cópia girada foi salva em " + outPath + L", mas o Windows não aceitou aplicá-la como papel de parede.";
        return false;
    }
    info = L"Papel de parede girado com sucesso.";
    return true;
}

bool CropImageFile(const std::wstring& sourcePath, const std::vector<RECT>& normalizedBoxes, std::wstring& info) {
    const std::wstring path = Trim(sourcePath);
    if (path.empty() || normalizedBoxes.empty()) {
        info = L"Não recebi o caminho da imagem e as coordenadas dos recortes. Nenhum arquivo foi criado.";
        return false;
    }
    const DWORD sourceAttr = GetFileAttributesW(path.c_str());
    if (sourceAttr == INVALID_FILE_ATTRIBUTES || (sourceAttr & FILE_ATTRIBUTE_DIRECTORY)) {
        info = L"O arquivo de imagem anexado não foi encontrado no caminho informado. Nenhum recorte foi criado.";
        return false;
    }
    if (normalizedBoxes.size() > 20) {
        info = L"Recebi mais de 20 áreas para recortar. Para evitar arquivos acidentais, limitei a operação a 20 recortes.";
        return false;
    }

    wchar_t pictures[MAX_PATH] = {};
    if (FAILED(SHGetFolderPathW(nullptr, CSIDL_MYPICTURES, nullptr, SHGFP_TYPE_CURRENT, pictures)) || !pictures[0]) {
        info = L"Não consegui localizar a pasta Imagens do Windows. Nenhum recorte foi criado.";
        return false;
    }
    const std::wstring outDir = std::wstring(pictures) + L"\\AI-Agent-Bubble-Recortes";
    if (!CreateDirectoryW(outDir.c_str(), nullptr) && GetLastError() != ERROR_ALREADY_EXISTS) {
        info = L"Não consegui criar a pasta para os recortes dentro de Imagens.";
        return false;
    }
    DWORD outAttr = GetFileAttributesW(outDir.c_str());
    if (outAttr == INVALID_FILE_ATTRIBUTES || !(outAttr & FILE_ATTRIBUTE_DIRECTORY)) {
        info = L"O caminho de destino dos recortes não é uma pasta válida.";
        return false;
    }

    Gdiplus::GdiplusStartupInput startup;
    ULONG_PTR token = 0;
    if (Gdiplus::GdiplusStartup(&token, &startup, nullptr) != Gdiplus::Ok) {
        info = L"Não consegui inicializar o mecanismo de processamento de imagens do Windows.";
        return false;
    }

    std::vector<std::wstring> savedPaths;
    std::wstring failure;
    {
        Gdiplus::Bitmap source(path.c_str(), FALSE);
        if (source.GetLastStatus() != Gdiplus::Ok || source.GetWidth() == 0 || source.GetHeight() == 0) {
            failure = L"O Windows não conseguiu decodificar o arquivo de imagem original.";
        } else {
            const UINT imageW = source.GetWidth();
            const UINT imageH = source.GetHeight();
            CLSID jpeg{};
            if (!GetJpegEncoder(&jpeg)) {
                failure = L"Não encontrei o codificador JPEG do Windows.";
            } else {
                static std::atomic<unsigned long long> cropSerial{0};
                const size_t count = std::min<size_t>(normalizedBoxes.size(), 20);
                for (size_t i = 0; i < count; ++i) {
                    const RECT& b = normalizedBoxes[i];
                    int nx = std::clamp<LONG>(b.left, 0, 1000);
                    int ny = std::clamp<LONG>(b.top, 0, 1000);
                    int nr = std::clamp<LONG>(b.right, 0, 1000);
                    int nb = std::clamp<LONG>(b.bottom, 0, 1000);
                    if (nr <= nx || nb <= ny) continue;

                    // Convert normalized coordinates back to original image pixels.
                    int x = static_cast<int>((static_cast<unsigned long long>(nx) * imageW) / 1000ull);
                    int y = static_cast<int>((static_cast<unsigned long long>(ny) * imageH) / 1000ull);
                    int r = static_cast<int>((static_cast<unsigned long long>(nr) * imageW) / 1000ull);
                    int bot = static_cast<int>((static_cast<unsigned long long>(nb) * imageH) / 1000ull);
                    x = std::clamp(x, 0, static_cast<int>(imageW) - 1);
                    y = std::clamp(y, 0, static_cast<int>(imageH) - 1);
                    r = std::clamp(r, x + 1, static_cast<int>(imageW));
                    bot = std::clamp(bot, y + 1, static_cast<int>(imageH));
                    int w = r - x;
                    int h = bot - y;
                    if (w < 8 || h < 8) continue;

                    // Add a small margin around model-proposed boxes without crossing image bounds.
                    int padX = std::max(2, w / 12);
                    int padY = std::max(2, h / 12);
                    x = std::max(0, x - padX);
                    y = std::max(0, y - padY);
                    r = std::min(static_cast<int>(imageW), r + padX);
                    bot = std::min(static_cast<int>(imageH), bot + padY);
                    w = r - x;
                    h = bot - y;
                    if (w < 8 || h < 8) continue;

                    Gdiplus::Bitmap crop(static_cast<UINT>(w), static_cast<UINT>(h), PixelFormat24bppRGB);
                    if (crop.GetLastStatus() != Gdiplus::Ok) continue;
                    Gdiplus::Graphics g(&crop);
                    g.SetInterpolationMode(Gdiplus::InterpolationModeHighQualityBicubic);
                    g.SetPixelOffsetMode(Gdiplus::PixelOffsetModeHighQuality);
                    Gdiplus::Rect dest(0, 0, w, h);
                    if (g.DrawImage(&source, dest, x, y, w, h, Gdiplus::UnitPixel) != Gdiplus::Ok) continue;

                    const auto serial = cropSerial.fetch_add(1, std::memory_order_relaxed);
                    std::wstring filename = L"rosto_" + std::to_wstring(i + 1) + L"_" +
                        std::to_wstring(GetTickCount64()) + L"_" + std::to_wstring(serial) + L".jpg";
                    std::wstring outPath = outDir + L"\\" + filename;
                    Gdiplus::EncoderParameters ep{};
                    ULONG quality = 94;
                    ep.Count = 1;
                    ep.Parameter[0].Guid = Gdiplus::EncoderQuality;
                    ep.Parameter[0].Type = Gdiplus::EncoderParameterValueTypeLong;
                    ep.Parameter[0].NumberOfValues = 1;
                    ep.Parameter[0].Value = &quality;
                    if (crop.Save(outPath.c_str(), &jpeg, &ep) != Gdiplus::Ok) continue;

                    HANDLE check = CreateFileW(outPath.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
                    bool verified = false;
                    if (check != INVALID_HANDLE_VALUE) {
                        LARGE_INTEGER sz{};
                        verified = GetFileSizeEx(check, &sz) && sz.QuadPart > 128;
                        CloseHandle(check);
                    }
                    if (verified) savedPaths.push_back(outPath);
                    else DeleteFileW(outPath.c_str());
                }
            }
        }
    }
    Gdiplus::GdiplusShutdown(token);

    if (savedPaths.empty()) {
        info = failure.empty()
            ? L"Não consegui salvar nenhum recorte válido. Verifique se as caixas de recorte correspondem à imagem anexada; nenhum sucesso foi registrado."
            : failure + L" Nenhum recorte foi salvo.";
        return false;
    }

    info = L"Recortes criados e verificados: " + std::to_wstring(savedPaths.size()) + L" arquivo(s). Pasta: " + outDir;
    if (savedPaths.size() < normalizedBoxes.size())
        info += L". Alguns recortes foram ignorados porque as coordenadas eram inválidas ou a gravação falhou.";
    // Open the exact output folder so the user can immediately see the files.
    ShellOpen(outDir);
    return true;
}

bool RunAction(const Action& a, std::wstring& info) {
    if (a.type == L"open_app") return OpenApp(a.arg, info);
    if (a.type == L"open_url") return OpenUrl(a.arg, info);
    if (a.type == L"web_search") return WebSearch(a.arg, info);
    if (a.type == L"site_search") return SiteSearch(a.arg, a.detail, info);
    if (a.type == L"app_search") return AppSearch(a.arg, a.detail, info);
    if (a.type == L"open_folder") return OpenFolder(a.arg, info);
    if (a.type == L"copy_text") return CopyText(a.arg, info);
    if (a.type == L"create_presentation") return CreatePresentationFallback(a.arg, info);
    if (a.type == L"open_latest_presentation") return OpenLatestPresentation(info);
    if (a.type == L"run_command") return RunCommand(a.arg, info);
    if (a.type == L"window_control") return ControlWindow(a.arg, info);
    if (a.type == L"wallpaper_rotate") return RotateCurrentWallpaper(a.arg, info);
    if (a.type == L"crop_image") return CropImageFile(a.arg, a.cropBoxes, info);
    if (a.type == L"wallpaper_set") {
        const std::wstring path = Trim(a.arg);
        DWORD attr = path.empty() ? INVALID_FILE_ATTRIBUTES : GetFileAttributesW(path.c_str());
        if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY)) {
            info = L"Não encontrei um arquivo de imagem válido nesse caminho. Nenhuma alteração foi feita.";
            return false;
        }
        if (!SystemParametersInfoW(SPI_SETDESKWALLPAPER, 0, const_cast<LPWSTR>(path.c_str()), SPIF_UPDATEINIFILE | SPIF_SENDCHANGE)) {
            info = L"O Windows recusou a aplicação da imagem como papel de parede.";
            return false;
        }
        wchar_t applied[MAX_PATH] = {};
        if (!SystemParametersInfoW(SPI_GETDESKWALLPAPER, ARRAYSIZE(applied), applied, 0) || !applied[0]) {
            info = L"O comando foi enviado, mas não consegui verificar qual imagem ficou aplicada.";
            return false;
        }
        auto normalizePath = [](std::wstring x) { for (auto& c : x) { if (c == L'/') c = L'\\'; c = towlower(c); } return x; };
        if (normalizePath(applied) != normalizePath(path)) {
            info = L"O Windows aceitou a solicitação, mas o caminho ativo não corresponde ao arquivo pedido. Não vou marcar como concluído.";
            return false;
        }
        info = L"Papel de parede aplicado e confirmado pelo Windows.";
        return true;
    }
    if (a.type == L"organize_desktop") return OrganizeDesktop(info);
    if (a.type == L"media_control") return ControlMedia(a.arg, info);
    if (a.type == L"volume_control") return ControlVolume(a.arg, info);
    if (a.type == L"voice_control") return ControlVoice(a.arg, info);
    if (a.type == L"mouse_control") {
        const std::wstring command = Lower(Trim(a.arg));
        const bool isScroll = command == L"scroll_up" || command == L"scroll_down";
        const bool ok = MouseControl(a, info);
        if (ok && isScroll) {
            if (!g_cfg.screenVision) {
                g_scrollVerificationChainActive = false;
                info = command == L"scroll_down"
                    ? L"Rolagem para baixo enviada; a verificação visual está desativada."
                    : L"Rolagem para cima enviada; a verificação visual está desativada.";
                return true;
            }
            if (g_scrollVerificationPending) {
                ScheduleScreenReview(
                    L"VERIFICAÇÃO OBRIGATÓRIA DA ROLAGEM. Foram anexadas duas imagens: a primeira ANTES e a segunda DEPOIS da rolagem. Compare a mesma área da página/documento. Não execute nenhuma ação nesta etapa. Retorne JSON válido no formato do agente, sem ações, e faça o campo reply começar EXATAMENTE com ROLAGEM_VERIFICADA: se houver mudança visual compatível; caso contrário, comece com ROLAGEM_NAO_CONFIRMADA:. Não use uma resposta genérica como 'Pronto' sem comparar as duas imagens. Nunca alegue mudança sem evidência e não repita a rolagem.",
                    850);
                if (!g_pendingScreenReview) {
                    g_scrollVerificationPending = false;
                    g_scrollBeforeScreenshot.clear();
                    g_scrollVerificationChainActive = false;
                    info = L"Rolagem enviada, mas não consegui agendar a verificação visual.";
                    return true;
                }
                g_scrollVerificationChainActive = true;
                g_scrollVerificationDirection = command == L"scroll_down" ? -1 : 1;
            } else {
                g_scrollVerificationChainActive = false;
                info = L"Rolagem enviada, mas a captura anterior falhou; não consegui verificar a mudança.";
                return true;
            }
        }
        return ok;
    }
    if (a.type == L"inspect_screen") {
        if (!g_cfg.screenVision) { info = L"Ative Visão da tela para eu analisar o resultado."; return false; }
        std::wstring instruction = g_pendingScreenInstruction;
        if (instruction.empty()) instruction = L"Observe a tela atualizada depois da última ação de mouse/teclado. Descreva o que mudou. Se a tarefa solicitada ainda não terminou, proponha a próxima ação concreta com mouse_control e depois peça inspect_screen para verificar; não invente resultados e não faça compras, exclusões, publicações ou envios sem confirmação explícita.";
        ScheduleScreenReview(instruction, 1300);
        if (!g_pendingScreenReview) { info = L"Não consegui agendar a captura de verificação."; return false; }
        info = L"Agendei uma nova captura da tela para verificar o resultado.";
        return true;
    }
    info = L"Ação desconhecida: " + a.type;
    return false;
}

// ============================================================================
// Rede (WinHTTP) e provedores
// ============================================================================

struct HttpResult {
    bool ok = false;
    DWORD status = 0;
    std::string body;
    std::wstring error;
};

HttpResult HttpPost(const std::wstring& url, const std::wstring& headers,
                    const std::string& body) {
    HttpResult res;
    wchar_t host[256] = {};
    wchar_t path[2048] = {};
    wchar_t extra[2048] = {};
    URL_COMPONENTS uc = {};
    uc.dwStructSize = sizeof(uc);
    uc.dwSchemeLength = static_cast<DWORD>(-1);
    uc.lpszHostName = host;
    uc.dwHostNameLength = ARRAYSIZE(host);
    uc.lpszUrlPath = path;
    uc.dwUrlPathLength = ARRAYSIZE(path);
    uc.lpszExtraInfo = extra;
    uc.dwExtraInfoLength = ARRAYSIZE(extra);
    if (!WinHttpCrackUrl(url.c_str(), static_cast<DWORD>(url.size()), 0, &uc)) {
        res.error = L"URL inválida: " + url;
        return res;
    }
    bool secure = uc.nScheme == INTERNET_SCHEME_HTTPS;
    std::wstring objectPath = std::wstring(path) + extra;
    if (objectPath.empty()) objectPath = L"/";

    HINTERNET session = WinHttpOpen(L"WindhawkAiAgent/1.0",
                                    WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
                                    WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
    if (!session)
        session = WinHttpOpen(L"WindhawkAiAgent/1.0", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY,
                              WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
    if (!session) {
        res.error = L"Falha ao iniciar WinHTTP.";
        return res;
    }
    WinHttpSetTimeouts(session, 10000, 15000, 30000, 120000);

    HINTERNET conn = WinHttpConnect(session, host, uc.nPort, 0);
    HINTERNET req = conn ? WinHttpOpenRequest(conn, L"POST", objectPath.c_str(), nullptr,
                                              WINHTTP_NO_REFERER,
                                              WINHTTP_DEFAULT_ACCEPT_TYPES,
                                              secure ? WINHTTP_FLAG_SECURE : 0)
                         : nullptr;
    if (!req) {
        res.error = L"Não consegui conectar a " + std::wstring(host) + L".";
    } else if (!WinHttpSendRequest(req, headers.c_str(), static_cast<DWORD>(-1),
                                   const_cast<char*>(body.data()),
                                   static_cast<DWORD>(body.size()),
                                   static_cast<DWORD>(body.size()), 0) ||
               !WinHttpReceiveResponse(req, nullptr)) {
        res.error = L"Falha de conexão com " + std::wstring(host) + L" (erro " +
                    std::to_wstring(GetLastError()) + L").";
    } else {
        DWORD status = 0, size = sizeof(status);
        WinHttpQueryHeaders(req, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
                            WINHTTP_HEADER_NAME_BY_INDEX, &status, &size,
                            WINHTTP_NO_HEADER_INDEX);
        res.status = status;
        for (;;) {
            DWORD avail = 0;
            if (!WinHttpQueryDataAvailable(req, &avail) || avail == 0) break;
            std::string chunk(avail, '\0');
            DWORD read = 0;
            if (!WinHttpReadData(req, &chunk[0], avail, &read) || read == 0) break;
            res.body.append(chunk, 0, read);
            if (res.body.size() > 8u * 1024 * 1024) break;
        }
        res.ok = true;
    }
    if (req) WinHttpCloseHandle(req);
    if (conn) WinHttpCloseHandle(conn);
    WinHttpCloseHandle(session);
    return res;
}

std::string BuildSystemPrompt(const Settings& cfg, const std::vector<AppEntry>& apps) {
    std::string p =
        "You are a desktop assistant that lives in a floating bubble on the user's "
        "Windows 10 PC. You can chat and you can control the computer by asking the "
        "host program to perform actions.\n"
        "ALWAYS answer with a single JSON object and nothing else (no markdown, no code "
        "fences): {\"reply\": \"short message shown to the user\", \"mood\": \"idle|happy|curious|confused|sad|surprised|error\", \"actions\": [ ... ]}\n"
        "Allowed actions:\n"
        "- {\"type\":\"open_app\",\"target\":\"app name\"} open an installed application "
        "(use the exact name from the app list when possible)\n"
        "- {\"type\":\"open_url\",\"url\":\"https://...\"} open a website in the default "
        "browser\n"
        "- {\"type\":\"web_search\",\"query\":\"...\"} generic web search only when the user did not name a site\n"
        "- {\"type\":\"site_search\",\"site\":\"Pinterest|YouTube|Spotify|GitHub|PubMed|Canva|...\",\"query\":\"...\"} open the named site's OWN search results page\n"
        "- {\"type\":\"app_search\",\"app\":\"Spotify|Steam|Microsoft Store\",\"query\":\"...\"} use an app-specific search link for supported desktop apps\n"
        "- {\"type\":\"open_folder\",\"path\":\"downloads|documents|desktop|pictures|music|"
        "videos or a full path\"}\n"
        "- {\"type\":\"copy_text\",\"text\":\"...\"} copy text to the clipboard\n"
        "- {\"type\":\"create_presentation\",\"topic\":\"subject\"} create a real .pptx locally as a fallback if website automation cannot create the design; report success only if the file is verified and opened\n"
        "- {\"type\":\"open_latest_presentation\",\"target\":\"latest\"} open the generated/latest PowerPoint file directly, do not merely open Documents\n"
        "- {\"type\":\"ask_user\",\"message\":\"...\"} pause and request a manual step from the user; after confirmation, verify the actual requested result and never infer success from the OK click alone\n"
        "- {\"type\":\"media_control\",\"command\":\"next|previous|play_pause|stop\"} control system media playback; use next for requests like skip/advance the current song\n"
        "- {\"type\":\"volume_control\",\"command\":\"up|down|mute\"} adjust Windows master volume by one step or toggle mute; for a small increase use up once\n"
        "- {\"type\":\"voice_control\",\"voice\":\"male|female|system\"} choose the voice used to read future replies when a matching Windows SAPI voice is installed\n"
        "- {\"type\":\"crop_image\",\"path\":\"absolute path from an attached image\",\"boxes\":[{\"x\":100,\"y\":100,\"width\":200,\"height\":250}]} crop each specified area from the original image, with coordinates normalized 0..1000 relative to the full image; use one box per face/object and never claim success without verified saved files\n"
        "- {\"type\":\"wallpaper_set\",\"path\":\"full path to an existing image file\"} apply an existing local image as the Windows wallpaper; verify the file and API result first\n"
