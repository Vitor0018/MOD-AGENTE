struct WindowSearch {
    std::wstring needle;
    HWND found = nullptr;
};

BOOL CALLBACK FindTopWindowProc(HWND hwnd, LPARAM param) {
    auto* search = reinterpret_cast<WindowSearch*>(param);
    if (!IsWindowVisible(hwnd) || GetWindow(hwnd, GW_OWNER)) return TRUE;
    int len = GetWindowTextLengthW(hwnd);
    if (len <= 0 || len > 2048) return TRUE;
    std::wstring title(static_cast<size_t>(len) + 1, L'\0');
    GetWindowTextW(hwnd, &title[0], len + 1);
    title.resize(static_cast<size_t>(len));
    if (Lower(title).find(search->needle) != std::wstring::npos) {
        search->found = hwnd;
        return FALSE;
    }
    return TRUE;
}

bool ControlWindow(const std::wstring& raw, std::wstring& info) {
    // Formato: "minimizar chrome", "maximizar bloco de notas",
    // "restaurar explorer", "focar discord" ou "fechar janela do paint".
    std::wstring cmd = Lower(Trim(raw));
    std::wstring verb;
    const std::pair<const wchar_t*, const wchar_t*> verbs[] = {
        {L"minimizar ", L"minimizar"}, {L"minimize ", L"minimizar"},
        {L"maximizar ", L"maximizar"}, {L"maximize ", L"maximizar"},
        {L"restaurar ", L"restaurar"}, {L"restore ", L"restaurar"},
        {L"focar ", L"focar"}, {L"foco ", L"focar"}, {L"focus ", L"focar"},
        {L"fechar ", L"fechar"}, {L"close ", L"fechar"}
    };
    for (const auto& v : verbs) {
        size_t n = wcslen(v.first);
        if (cmd.compare(0, n, v.first) == 0) {
            verb = v.second;
            cmd = Trim(cmd.substr(n));
            break;
        }
    }
    const std::wstring prefix = L"janela do ";
    if (cmd.compare(0, prefix.size(), prefix) == 0) cmd = Trim(cmd.substr(prefix.size()));
    if (verb.empty() || cmd.empty()) {
        info = L"Use: minimizar/maximizar/restaurar/focar/fechar + nome da janela.";
        return false;
    }
    WindowSearch search{cmd, nullptr};
    EnumWindows(FindTopWindowProc, reinterpret_cast<LPARAM>(&search));
    if (!search.found) {
        info = L"Não encontrei uma janela visível com o título correspondente a: " + cmd;
        return false;
    }
    if (verb == L"minimizar") ShowWindow(search.found, SW_MINIMIZE);
    else if (verb == L"maximizar") ShowWindow(search.found, SW_MAXIMIZE);
    else if (verb == L"restaurar") ShowWindow(search.found, SW_RESTORE);
    else if (verb == L"focar") {
        ShowWindow(search.found, SW_RESTORE);
        SetForegroundWindow(search.found);
    } else if (verb == L"fechar") {
        PostMessageW(search.found, WM_CLOSE, 0, 0);
    }
    info = L"Ação de janela enviada: " + verb + L" — " + cmd;
    return true;
}

std::wstring DesktopPath() {
    WCHAR path[MAX_PATH] = {};
    if (FAILED(SHGetFolderPathW(nullptr, CSIDL_DESKTOPDIRECTORY, nullptr, SHGFP_TYPE_CURRENT, path)))
        return {};
    return path;
}

bool OpenLatestPresentation(std::wstring& info) {
    if (!g_lastPresentationPath.empty() &&
        GetFileAttributesW(g_lastPresentationPath.c_str()) != INVALID_FILE_ATTRIBUTES) {
        if (!ShellOpen(g_lastPresentationPath)) {
            info = L"Encontrei a apresentação, mas não consegui abri-la: " + g_lastPresentationPath;
            return false;
        }
        info = L"Abrindo a apresentação gerada: " + g_lastPresentationPath;
        return true;
    }

    wchar_t documents[MAX_PATH] = {};
    SHGetFolderPathW(nullptr, CSIDL_PERSONAL, nullptr, SHGFP_TYPE_CURRENT, documents);
    std::vector<std::wstring> dirs;
    std::wstring desktop = DesktopPath();
    if (!desktop.empty()) dirs.push_back(desktop);
    if (documents[0]) dirs.push_back(documents);
    wchar_t profile[MAX_PATH] = {};
    DWORD nProfile = GetEnvironmentVariableW(L"USERPROFILE", profile, ARRAYSIZE(profile));
    if (nProfile > 0 && nProfile < ARRAYSIZE(profile)) dirs.push_back(std::wstring(profile) + L"\\Downloads");

    std::wstring bestPath;
    FILETIME bestTime{};
    for (const auto& dir : dirs) {
        WIN32_FIND_DATAW fd{};
        HANDLE h = FindFirstFileW((dir + L"\\*.pptx").c_str(), &fd);
        if (h == INVALID_HANDLE_VALUE) continue;
        do {
            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
            if (bestPath.empty() || CompareFileTime(&fd.ftLastWriteTime, &bestTime) > 0) {
                bestTime = fd.ftLastWriteTime;
                bestPath = dir + L"\\" + fd.cFileName;
            }
        } while (FindNextFileW(h, &fd));
        FindClose(h);
    }
    if (bestPath.empty()) {
        info = L"Não encontrei nenhum arquivo .pptx na Área de Trabalho, Documentos ou Downloads. Crie uma apresentação primeiro.";
        return false;
    }
    if (!ShellOpen(bestPath)) {
        info = L"Encontrei a apresentação, mas não consegui abri-la: " + bestPath;
        return false;
    }
    g_lastPresentationPath = bestPath;
    info = L"Abrindo a apresentação mais recente: " + bestPath;
    return true;
}

bool OrganizeDesktop(std::wstring& info) {
    const std::wstring desktop = DesktopPath();
    if (desktop.empty()) {
        info = L"Não consegui localizar a Área de Trabalho.";
        return false;
    }
    struct Category { const wchar_t* folder; const wchar_t* exts; };
    const Category categories[] = {
        {L"Documentos", L"|.pdf|.doc|.docx|.txt|.rtf|.odt|.xls|.xlsx|.csv|.ppt|.pptx|.md|"},
        {L"Imagens", L"|.png|.jpg|.jpeg|.gif|.bmp|.webp|.svg|.ico|.heic|"},
        {L"Vídeos", L"|.mp4|.mkv|.mov|.avi|.wmv|.webm|"},
        {L"Áudios", L"|.mp3|.wav|.flac|.aac|.ogg|.m4a|"},
        {L"Compactados", L"|.zip|.7z|.rar|.tar|.gz|"},
        {L"Instaladores", L"|.exe|.msi|.msix|"},
        {L"Código", L"|.cpp|.c|.h|.hpp|.py|.js|.ts|.html|.css|.json|.ino|.java|.cs|"}
    };
    WIN32_FIND_DATAW fd;
    HANDLE h = FindFirstFileW((desktop + L"\\*").c_str(), &fd);
    if (h == INVALID_HANDLE_VALUE) {
        info = L"Não consegui listar os arquivos da Área de Trabalho.";
        return false;
    }
    int moved = 0, skipped = 0, failed = 0;
    do {
        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
        if (fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) continue;
        std::wstring name = fd.cFileName;
        size_t dot = name.find_last_of(L'.');
        if (dot == std::wstring::npos || dot == 0) { ++skipped; continue; }
        std::wstring ext = Lower(name.substr(dot));
        const wchar_t* category = nullptr;
        for (const auto& c : categories) {
            std::wstring list = c.exts;
            if (list.find(L"|" + ext + L"|") != std::wstring::npos) {
                category = c.folder;
                break;
            }
        }
        if (!category) { ++skipped; continue; }
        std::wstring destDir = desktop + L"\\" + category;
        if (!CreateDirectoryW(destDir.c_str(), nullptr) && GetLastError() != ERROR_ALREADY_EXISTS) {
            ++failed; continue;
        }
        std::wstring dest = destDir + L"\\" + name;
        if (GetFileAttributesW(dest.c_str()) != INVALID_FILE_ATTRIBUTES) {
            // Não sobrescreve arquivos já existentes.
            ++skipped; continue;
        }
        if (MoveFileExW((desktop + L"\\" + name).c_str(), dest.c_str(), MOVEFILE_COPY_ALLOWED))
            ++moved;
        else
            ++failed;
    } while (FindNextFileW(h, &fd));
    FindClose(h);
    info = L"Organização concluída. Arquivos movidos: " + std::to_wstring(moved) +
           L"; ignorados (tipo desconhecido ou nome duplicado): " + std::to_wstring(skipped) +
           L"; falhas: " + std::to_wstring(failed) +
           L". Nenhum arquivo foi excluído ou sobrescrito.";
    return failed == 0;
}

bool ControlMedia(const std::wstring& raw, std::wstring& info) {
    std::wstring cmd = Lower(Trim(raw));
    DWORD appCommand = 0;
    if (cmd == L"next" || cmd == L"next_track" || cmd == L"próxima" ||
        cmd == L"proxima" || cmd == L"avançar" || cmd == L"avancar")
        appCommand = APPCOMMAND_MEDIA_NEXTTRACK;
    else if (cmd == L"previous" || cmd == L"previous_track" || cmd == L"anterior" ||
             cmd == L"voltar")
        appCommand = APPCOMMAND_MEDIA_PREVIOUSTRACK;
    else if (cmd == L"play_pause" || cmd == L"playpause" || cmd == L"pausar" ||
             cmd == L"continuar" || cmd == L"play" || cmd == L"pause")
        appCommand = APPCOMMAND_MEDIA_PLAY_PAUSE;
    else if (cmd == L"stop" || cmd == L"parar")
        appCommand = APPCOMMAND_MEDIA_STOP;
    else {
        info = L"Comando de mídia não reconhecido. Use next, previous, play_pause ou stop.";
        return false;
    }
    WORD mediaKey = VK_MEDIA_PLAY_PAUSE;
    if (appCommand == APPCOMMAND_MEDIA_NEXTTRACK) mediaKey = VK_MEDIA_NEXT_TRACK;
    else if (appCommand == APPCOMMAND_MEDIA_PREVIOUSTRACK) mediaKey = VK_MEDIA_PREV_TRACK;
    else if (appCommand == APPCOMMAND_MEDIA_STOP) mediaKey = VK_MEDIA_STOP;
    INPUT keys[2] = {};
    keys[0].type = INPUT_KEYBOARD;
    keys[0].ki.wVk = mediaKey;
    keys[1].type = INPUT_KEYBOARD;
    keys[1].ki.wVk = mediaKey;
    keys[1].ki.dwFlags = KEYEVENTF_KEYUP;
    UINT sent = SendInput(2, keys, sizeof(INPUT));
    if (sent != 2) {
        info = L"Não consegui enviar a tecla multimídia ao Windows.";
        return false;
    }
    info = L"Comando multimídia enviado: " + cmd +
           L". O aplicativo de música precisa aceitar teclas multimídia globais.";
    return true;
}

