        return false;
    }
    const wchar_t bom = 0xFEFF;
    BOOL scriptOk = WriteFile(sf, &bom, sizeof(bom), &written, nullptr);
    DWORD bytesWanted = static_cast<DWORD>(ps.size() * sizeof(wchar_t));
    DWORD bodyWritten = 0;
    if (scriptOk) scriptOk = WriteFile(sf, ps.data(), bytesWanted, &bodyWritten, nullptr) && bodyWritten == bytesWanted;
    CloseHandle(sf);
    if (!scriptOk) {
        DeleteFileW(psPath.c_str()); DeleteFileW(topicPath); DeleteFileW(statusPath);
        info = L"Não consegui gravar o script de criação da apresentação.";
        return false;
    }

    std::wstring commandLine = L"powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File \"" + psPath + L"\"";
    std::vector<wchar_t> mutableCommand(commandLine.begin(), commandLine.end());
    mutableCommand.push_back(L'\0');
    STARTUPINFOW si = {};
    si.cb = sizeof(si);
    PROCESS_INFORMATION pi = {};
    BOOL launched = CreateProcessW(nullptr, mutableCommand.data(), nullptr, nullptr, FALSE,
                                   CREATE_NO_WINDOW, nullptr, nullptr, &si, &pi);
    if (!launched) {
        DeleteFileW(topicPath); DeleteFileW(psPath.c_str()); DeleteFileW(statusPath);
        info = L"Não consegui iniciar o PowerShell para gerar o arquivo.";
        return false;
    }
    DWORD waitResult = WaitForSingleObject(pi.hProcess, 120000);
    DWORD exitCode = 1;
    if (waitResult == WAIT_OBJECT_0) GetExitCodeProcess(pi.hProcess, &exitCode);
    else TerminateProcess(pi.hProcess, 1);
    CloseHandle(pi.hThread);
    CloseHandle(pi.hProcess);
    DeleteFileW(topicPath);
    DeleteFileW(psPath.c_str());

    if (waitResult != WAIT_OBJECT_0) {
        DeleteFileW(statusPath);
        DeleteFileW(outputPath.c_str());
        info = L"A criação demorou mais de 2 minutos e foi interrompida. Verifique se o PowerPoint está instalado e tente novamente.";
        return false;
    }

    std::string status;
    HANDLE statusFile = CreateFileW(statusPath, GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
                                    FILE_ATTRIBUTE_NORMAL, nullptr);
    if (statusFile != INVALID_HANDLE_VALUE) {
        LARGE_INTEGER size{};
        if (GetFileSizeEx(statusFile, &size) && size.QuadPart > 0 && size.QuadPart < 8192) {
            status.resize(static_cast<size_t>(size.QuadPart));
            DWORD read = 0;
            if (!ReadFile(statusFile, &status[0], static_cast<DWORD>(status.size()), &read, nullptr)) status.clear();
            else status.resize(read);
        }
        CloseHandle(statusFile);
    }
    DeleteFileW(statusPath);
    if (status.size() >= 3 && static_cast<unsigned char>(status[0]) == 0xEF &&
        static_cast<unsigned char>(status[1]) == 0xBB && static_cast<unsigned char>(status[2]) == 0xBF)
        status.erase(0, 3);

    WIN32_FILE_ATTRIBUTE_DATA fileData{};
    bool fileExists = GetFileAttributesExW(outputPath.c_str(), GetFileExInfoStandard, &fileData) &&
                      !(fileData.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) &&
                      (fileData.nFileSizeHigh != 0 || fileData.nFileSizeLow > 0);
    if (exitCode != 0 || status.rfind("OK", 0) != 0 || !fileExists) {
        // Esta chamada escolheu um nome livre; se a confirmação falhou, remove somente
        // o arquivo parcial que ela própria tentou produzir.
        DeleteFileW(outputPath.c_str());
        std::wstring detail = FromUtf8(status);
        if (detail.rfind(L"ERROR:", 0) == 0) detail.erase(0, 6);
        info = L"Não consegui confirmar a criação da apresentação. " +
               (detail.empty() ? L"Verifique se o Microsoft PowerPoint está instalado e tente novamente." : detail);
        return false;
    }

    const bool usedNativeFallback = status.rfind("OK_NATIVE", 0) == 0;
    // Guarda o caminho confirmado para comandos como "me mostre o slide".
    g_lastPresentationPath = outputPath;
    // Abra somente o arquivo pedido. Não abra o Canva automaticamente: isso era uma ação lateral e não importava o arquivo.
    const bool openedPpt = ShellOpen(outputPath);
    if (!openedPpt) {
        info = L"A apresentação foi criada e verificada em: " + outputPath + L", mas não consegui abri-la automaticamente.";
        return false;
    }
    info = (usedNativeFallback
        ? L"Apresentação .pptx criada por geração nativa (o PowerPoint COM não estava disponível), arquivo verificado e aberto pelo aplicativo padrão: "
        : L"Apresentação criada, verificada e aberta pelo aplicativo padrão: ") + outputPath + L".";
    return true;
}

