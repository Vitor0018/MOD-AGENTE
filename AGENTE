bool ExecuteActions(const std::vector<Action>& acts) {
    const bool createsPresentationInThisBatch = std::any_of(acts.begin(), acts.end(), [](const Action& a) { return a.type == L"create_presentation"; });
    std::vector<Action> list;
    for (const auto& a : acts) {
        if (createsPresentationInThisBatch && a.type == L"open_latest_presentation") {
            AppendHistoryLog(L"AÇÃO IGNORADA", L"A criação da apresentação já abre o arquivo gerado; a abertura duplicada foi ignorada.");
            continue;
        }
        const bool isWinM = a.type == L"mouse_control" && Lower(Trim(a.arg)) == L"key" && Lower(Trim(a.detail)) == L"win+m";
        if (isWinM && g_desktopInspectionChainActive && g_desktopWindowsAlreadyMinimized) {
            AppendHistoryLog(L"AÇÃO IGNORADA", L"WIN+M foi ignorado porque as janelas já foram minimizadas para a inspeção atual da Área de Trabalho.");
            continue;
        }
        if (a.type == L"run_command" && !g_cfg.allowRunCommand) {
            AppendHistoryLog(L"AÇÃO BLOQUEADA", Describe(a) + L" — execução de comandos desativada nas configurações.");
            ++g_actionFailureCount;
            g_actionResultNotes.push_back(L"O comando do Windows foi bloqueado porque essa opção está desativada.");
            continue;
        }
        list.push_back(a);
    }
    if (list.empty()) return false;

    for (const auto& a : list) AppendHistoryLog(L"AÇÃO SOLICITADA", Describe(a));

    bool confirm = g_cfg.confirmActions && !g_actionChainAuthorized;
    for (const auto& a : list) {
        if (a.type == L"run_command") confirm = true;
    }

    if (confirm) {
        std::wstring msg = L"A IA quer executar este conjunto de ações:\n\n";
        for (const auto& a : list) msg += L"\u2022 " + Describe(a) + L"\n";
        msg += L"\nPermitir a execução?";
        if (ModalBox(msg, L"Confirmar ações", MB_YESNO | MB_ICONQUESTION) != IDYES) {
            g_actionChainCancelled = true;
            AppendHistoryLog(L"AÇÃO CANCELADA", L"O usuário recusou a confirmação; as ações listadas não foram executadas.");
            g_actionResultNotes.push_back(L"A execução foi cancelada antes de realizar estas ações.");
            return false;
        }
    }
    g_actionChainAuthorized = true;

    for (const auto& a : list) {
        if (a.type == L"ask_user") {
            int answer = ModalBox(a.arg +
                L"\n\nFaça essa etapa na janela do aplicativo e clique em OK para continuar. "
                L"Clique em Cancelar para interromper a tarefa.",
                L"Intervenção necessária", MB_OKCANCEL | MB_ICONINFORMATION);
            if (answer != IDOK) {
                g_actionChainCancelled = true;
                g_actionResultNotes.push_back(L"A tarefa foi pausada a pedido do usuário.");
                return false;
            }
            g_actionResultNotes.push_back(L"O usuário confirmou a etapa manual; isso não comprova que o objetivo final foi concluído. É necessário verificar o resultado.");
            if (g_cfg.screenVision) {
                ScheduleScreenReview(
                    L"O usuário confirmou ter executado a etapa manual, mas isso NÃO prova que o objetivo final foi concluído. Examine a captura atual e verifique especificamente o resultado solicitado. Se não houver evidência visual suficiente, não declare sucesso: informe que não foi possível verificar. Continue apenas com etapas necessárias ainda não concluídas. Agrupe ações seguras e não repita ações já executadas.",
                    500);
                return true;
            }
            ++g_actionFailureCount;
            g_actionResultNotes.push_back(L"Não concluído: a etapa manual foi confirmada, mas a Visão da tela está desativada e não consigo verificar o resultado.");
            return false;
        }

        std::wstring info;
        bool ok = RunAction(a, info);
        if (a.type == L"inspect_screen") {
            if (ok) return true; // pausa o lote até a IA analisar a nova captura
            ++g_actionFailureCount;
            g_actionResultNotes.push_back(info);
            continue;
        }
        if (ok) {
            if (g_desktopInspectionChainActive && a.type == L"mouse_control" && Lower(Trim(a.arg)) == L"key" && Lower(Trim(a.detail)) == L"win+m")
                g_desktopWindowsAlreadyMinimized = true;
            ++g_actionSuccessCount;
            if (!info.empty() && g_actionResultNotes.size() < 8) g_actionResultNotes.push_back(info);
        } else {
            ++g_actionFailureCount;
            if (!info.empty() && g_actionResultNotes.size() < 8) g_actionResultNotes.push_back(L"Não concluído: " + info);
        }

        // Busca em site pode agendar uma leitura da própria página. Não execute ações
        // posteriores com coordenadas antigas enquanto a IA analisa a página aberta.
        if (g_pendingSiteReview || g_pendingScreenReview) return true;
    }
    return false;
}

struct SpeakJob {
    std::wstring text;
    std::wstring gender;
};

DWORD WINAPI SpeakWorker(LPVOID raw) {
    std::unique_ptr<SpeakJob> job(reinterpret_cast<SpeakJob*>(raw));
    HRESULT hr = CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
    ISpVoice* voice = nullptr;
    if (SUCCEEDED(CoCreateInstance(CLSID_SpVoice, nullptr, CLSCTX_ALL,
                                   IID_ISpVoice, reinterpret_cast<void**>(&voice)))) {
        // Tenta selecionar uma voz SAPI pelo atributo Gender. Se não houver
        // correspondência, mantém a voz padrão configurada no Windows.
        if (job->gender == L"male" || job->gender == L"female") {
            ISpObjectTokenCategory* category = nullptr;
            IEnumSpObjectTokens* tokens = nullptr;
            HRESULT categoryHr = CoCreateInstance(CLSID_SpObjectTokenCategory, nullptr,
                CLSCTX_INPROC_SERVER, IID_ISpObjectTokenCategory,
                reinterpret_cast<void**>(&category));
            if (SUCCEEDED(categoryHr) && category &&
                SUCCEEDED(category->SetId(SPCAT_VOICES, FALSE)) &&
                SUCCEEDED(category->EnumTokens(nullptr, nullptr, &tokens)) && tokens) {
                ISpObjectToken* token = nullptr;
                while (tokens->Next(1, &token, nullptr) == S_OK && token) {
                    WCHAR* gender = nullptr;
                    bool match = false;
                    if (SUCCEEDED(token->GetStringValue(L"Gender", &gender)) && gender) {
                        std::wstring g = Lower(gender);
                        match = (job->gender == L"male" && g == L"male") ||
                                (job->gender == L"female" && g == L"female");
                        CoTaskMemFree(gender);
                    }
                    if (match) {
                        voice->SetVoice(token);
                        token->Release();
                        token = nullptr;
                        break;
                    }
                    token->Release();
                    token = nullptr;
                }
            }
            if (tokens) tokens->Release();
            if (category) category->Release();
        }
        voice->Speak(job->text.c_str(), SPF_IS_NOT_XML, nullptr);
        voice->Release();
    }
    if (SUCCEEDED(hr)) CoUninitialize();
    g_speaking.store(false);
    if (HWND b = g_hBubble.load()) PostMessageW(b, WM_APP + 3, 0, 0);
    return 0;
}

void SpeakReply(const std::wstring& text) {
    if (!g_cfg.voiceReplies || text.empty()) return;
    g_speaking.store(true);
    if (HWND b = g_hBubble.load()) InvalidateRect(b, nullptr, FALSE);
    auto* job = new SpeakJob{text, g_cfg.voiceGender};
    HANDLE th = CreateThread(nullptr, 0, SpeakWorker, job, 0, nullptr);
    if (th) CloseHandle(th);
    else { delete job; g_speaking.store(false); if (HWND b = g_hBubble.load()) InvalidateRect(b, nullptr, FALSE); }
}

std::wstring BuildLocalActionSummary() {
    if (g_actionChainCancelled) return L"**Tarefa pausada.**";

    // Translate successful low-level action notes into a clean user-facing result.
    // Never expose temp file paths, keyboard scan details, or internal status text.
    if (g_actionFailureCount == 0 && g_actionSuccessCount > 0) {
        for (const auto& note : g_actionResultNotes) {
            if (note.find(L"Rolagem para baixo enviada; a verificação visual está desativada") != std::wstring::npos)
                return L"Enviei a rolagem para baixo, mas a verificação visual está desativada.";
            if (note.find(L"Rolagem para cima enviada; a verificação visual está desativada") != std::wstring::npos)
                return L"Enviei a rolagem para cima, mas a verificação visual está desativada.";
            if (note.find(L"Rolagem enviada, mas a captura anterior falhou") != std::wstring::npos ||
                note.find(L"Rolagem enviada, mas não consegui agendar a verificação visual") != std::wstring::npos)
                return L"Enviei a rolagem, mas não consegui confirmar visualmente a mudança.";
            if (note.find(L"Papel de parede aplicado e confirmado pelo Windows") != std::wstring::npos) {
                return L"**Pronto! O novo papel de parede foi aplicado.**";
            }
            if (note.find(L"Papel de parede girado com sucesso") != std::wstring::npos ||
                note.find(L"Girei o papel de parede") != std::wstring::npos ||
                note.find(L"a cópia girada foi salva") != std::wstring::npos) {
                return L"**Pronto! O papel de parede foi girado.**";
            }
            if (note.find(L"Apresentação .pptx criada por geração nativa") != std::wstring::npos ||
                note.find(L"Apresentação criada, verificada e aberta pelo aplicativo padrão") != std::wstring::npos) {
                return L"**Pronto! Criei e abri a apresentação.**";
            }
            if (note.find(L"Atalho de teclado enviado: WIN+M") != std::wstring::npos) {
                return L"**Pronto! Minimizei as janelas abertas.**";
            }
            if (note.find(L"Atalho de teclado enviado: WIN+D") != std::wstring::npos) {
                return L"**Pronto! Mostrei a Área de Trabalho.**";
            }
        }
        if (g_actionSuccessCount == 1) return L"**Pronto! Concluído.**";
        return L"**Pronto! Tarefa concluída.**";
    }

    if (g_actionSuccessCount == 0 && g_actionFailureCount > 0) {
        for (const auto& note : g_actionResultNotes) {
            if (note.find(L"Não concluído:") == 0) {
                std::wstring reason = note.substr(wcslen(L"Não concluído:"));
                reason = Trim(reason);
                // Keep the explanation short; paths and low-level diagnostics stay hidden.
                size_t path = reason.find(L" em C:\\");
                if (path != std::wstring::npos) reason.erase(path);
                if (reason.size() > 110) reason = reason.substr(0, 107) + L"...";
                return L"**Não consegui concluir.** " + reason;
            }
        }
        return L"**Não consegui concluir a tarefa.**";
    }
    if (g_actionFailureCount > 0)
        return L"**Concluí parte da tarefa, mas uma etapa falhou.**";
    return L"**Tarefa encerrada.**";
}

void ResetActionChain() {
    g_actionChainActive = false;
    g_actionChainAuthorized = false;
    g_desktopInspectionChainActive = false;
    g_desktopWindowsAlreadyMinimized = false;
    g_scrollVerificationChainActive = false;
    g_scrollVerificationDirection = 0;
    g_scrollVerificationPending = false;
    g_scrollBeforeScreenshot.clear();
    g_actionChainCancelled = false;
    g_actionSuccessCount = 0;
    g_actionFailureCount = 0;
    g_actionResultNotes.clear();
}

void FinishActionChain(const std::wstring& finalReply = L"") {
    std::wstring finalText = Trim(finalReply);
    // For deterministic local actions, use a purpose-written confirmation even if
    // a model continuation returned a verbose report with file paths or low-level details.
    if (g_actionFailureCount == 0 && g_actionSuccessCount > 0) {
        bool conciseLocalResult = false;
        for (const auto& note : g_actionResultNotes) {
            if (note.find(L"Papel de parede girado com sucesso") != std::wstring::npos ||
                note.find(L"Girei o papel de parede") != std::wstring::npos ||
                note.find(L"Atalho de teclado enviado: WIN+M") != std::wstring::npos ||
                note.find(L"Atalho de teclado enviado: WIN+D") != std::wstring::npos) {
                conciseLocalResult = true;
                break;
            }
        }
        if ((conciseLocalResult && !g_desktopInspectionChainActive) || finalText.empty())
            finalText = BuildLocalActionSummary();
    } else if (finalText.empty()) {
        finalText = BuildLocalActionSummary();
    }
    if (finalText.empty()) finalText = L"**Tarefa encerrada.**";
    std::wstring actionReport = L"Resultado: " + finalText + L"\r\nAções concluídas: " + std::to_wstring(g_actionSuccessCount) + L"; falhas: " + std::to_wstring(g_actionFailureCount) + L".";
    for (const auto& note : g_actionResultNotes) actionReport += L"\r\n- " + note;
    AppendHistoryLog(L"RESULTADO DA TAREFA", actionReport);
    AppendAssistantReply(finalText);
    SpeakReply(StripMarkdownForSpeech(finalText));
    ResetActionChain();
}

