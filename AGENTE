void SendFromInput() {
    if (g_pendingSiteReview) {
        g_pendingSiteReview = false;
        if (g_bubble) KillTimer(g_bubble, 3);
    }
    if (g_pendingScreenReview) {
        g_pendingScreenReview = false;
        g_pendingScreenInstruction.clear();
        if (g_bubble) KillTimer(g_bubble, 4);
    }
    g_listening = false;
    if (g_bubble) KillTimer(g_bubble, 2);
    if (g_bubble) InvalidateRect(g_bubble, nullptr, FALSE);
    if (g_busy || !g_input) return;
    int len = GetWindowTextLengthW(g_input);
    if (len <= 0 && g_pendingAttachments.empty()) return;
    std::wstring text(static_cast<size_t>(len) + 1, L'\0');
    GetWindowTextW(g_input, &text[0], len + 1);
    text.resize(static_cast<size_t>(len));
    text = Trim(text);
    if (text.empty() && g_pendingAttachments.empty()) return;
    if (text.empty() && !g_pendingAttachments.empty()) text = L"Analise os arquivos anexados e me ajude com eles.";
    // For an explicitly selected text-only model, only retry with another provider
    // after the user approves this exact visual task.
    if (g_pendingVisionFallbackConsent && g_pendingAttachments.empty()) {
        const std::wstring decision = Lower(Trim(text));
        const bool yes = decision == L"sim" || decision == L"s" || decision == L"yes" ||
            decision == L"pode" || decision == L"pode tentar" || decision == L"autorizo" ||
            decision == L"tente outro modelo" || decision == L"pode usar outro modelo";
        const bool no = decision == L"não" || decision == L"nao" || decision == L"n" ||
            decision == L"não, obrigado" || decision == L"nao obrigado" || decision == L"cancele" || decision == L"cancelar";
        if (!yes && !no) {
            AppendText(L"[Visão] Responda sim para autorizar outro modelo ou não para cancelar.\r\n\r\n");
            SetWindowTextW(g_input, text.c_str());
            return;
        }
        AppendText(L"Você: " + ToCRLF(text) + L"\r\n");
        SetWindowTextW(g_input, L"");
        g_pendingVisionFallbackConsent = false;
        if (no) {
            g_pendingVisionFallbackMessage = Msg{};
            const std::wstring reply = L"Tudo bem. Não troquei de modelo, então não consegui analisar a tela nesta tarefa.";
            if (g_actionChainActive) FinishActionChain(reply);
            else { AppendAssistantReply(reply); SpeakReply(StripMarkdownForSpeech(reply)); }
            return;
        }
        for (auto& oldMsg : g_hist) { oldMsg.imageBase64.clear(); oldMsg.attachedImageBase64.clear(); }
        g_hist.push_back(g_pendingVisionFallbackMessage);
        g_pendingVisionFallbackMessage = Msg{};
        Settings retryCfg = g_cfg;
        retryCfg.provider = Provider::Auto;  // one-time retry after explicit consent
        retryCfg.model.clear();
        retryCfg.apiKey.clear();
        EnsureAppIndex();
        auto* job = new Job{g_panel, retryCfg, BuildSystemPrompt(retryCfg, g_apps), g_hist};
        g_busy = true;
        InvalidateRect(g_panel, nullptr, FALSE);
        InvalidateRect(g_bubble, nullptr, FALSE);
        HANDLE t = CreateThread(nullptr, 0, AiThread, job, 0, nullptr);
        if (!t) {
            delete job;
            g_busy = false;
            if (!g_hist.empty() && g_hist.back().user) g_hist.pop_back();
            const std::wstring reply = L"Autorizei a troca, mas não consegui iniciar a tentativa com outro modelo.";
            if (g_actionChainActive) FinishActionChain(reply);
            else { AppendAssistantReply(reply); SpeakReply(StripMarkdownForSpeech(reply)); }
            InvalidateRect(g_panel, nullptr, FALSE);
            InvalidateRect(g_bubble, nullptr, FALSE);
            return;
        }
        CloseHandle(t);
        return;
    }

    {
        std::wstring avatarReply;
        if (TryConfigureAvatarFolderRequest(text, avatarReply)) {
            AppendText(L"Você: " + ToCRLF(text) + L"\r\n");
            SetWindowTextW(g_input, L"");
            g_hist.push_back({true, ToUtf8(text), ""});
            g_hist.push_back({false, ToUtf8(avatarReply)});
            AppendAssistantReply(avatarReply);
            SpeakReply(StripMarkdownForSpeech(avatarReply));
            g_pendingAttachments.clear();
            return;
        }
    }

    std::wstring pastedCode = ExtractCodeCandidate(text);
    if (!pastedCode.empty()) g_lastSourceCandidate = std::move(pastedCode);
    if (IsSourceReplacementRequest(text)) {
        AppendText(L"Você: " + ToCRLF(text) + L"\r\n");
        SetWindowTextW(g_input, L"");
        std::wstring result;
        bool saved = ReplaceConfiguredSource(g_lastSourceCandidate, result);
        const std::wstring reply = saved
            ? L"**Pronto! O código-fonte foi substituído.** Você pode compilar no Windhawk."
            : L"**Não substituí o código-fonte.** " + result;
        AppendAssistantReply(reply);
        SpeakReply(StripMarkdownForSpeech(reply));
        g_hist.push_back({true, ToUtf8(text), ""});
        g_hist.push_back({false, ToUtf8(reply)});
        g_pendingAttachments.clear();
        return;
    }
    const bool hasQueuedAttachments = !g_pendingAttachments.empty();
    const int directScrollDirection = hasQueuedAttachments ? 0 : GetDirectScrollDirection(text);
    const bool localScrollIntent = directScrollDirection != 0;
    const bool desktopInspection = !hasQueuedAttachments && IsDesktopInspectionRequest(text);
    const bool wallpaperSearchIntent = !hasQueuedAttachments && IsNewWallpaperSearchRequest(text);
    const bool wallpaperApplyIntent = !hasQueuedAttachments && IsApplyWallpaperRequest(text);
    const std::wstring wallpaperApplyPath = wallpaperApplyIntent ? ExtractExistingImagePathFromText(text) : L"";
    const bool wallpaperOrientationReport = !hasQueuedAttachments && IsWallpaperOrientationReport(text);
    const bool screenshotSaveFollowup = !hasQueuedAttachments && IsScreenshotSaveFollowup(text);
    const bool localScreenshotIntent = !hasQueuedAttachments && IsScreenshotSaveRequest(text);
    const bool localFindScreenshotIntent = !hasQueuedAttachments && !localScreenshotIntent && !screenshotSaveFollowup && IsFindScreenshotRequest(text);
    const bool localOpenLastScreenshotIntent = !hasQueuedAttachments && !localScreenshotIntent && !screenshotSaveFollowup && !localFindScreenshotIntent && IsOpenLastScreenshotRequest(text);
    const bool localDesktopIntent = !hasQueuedAttachments && (IsExplicitWallpaperRotateRequest(text) || wallpaperSearchIntent || wallpaperApplyIntent || IsMinimizeAllWindowsRequest(text) || wallpaperOrientationReport || desktopInspection || localScrollIntent);
    // O contexto de "salve" vale apenas para a tarefa de captura atual, não para conversas futuras.
    if (!localScreenshotIntent && !screenshotSaveFollowup && !localFindScreenshotIntent && !localOpenLastScreenshotIntent)
        g_screenshotContextActive = false;

    if (g_actionChainActive) {
        const std::wstring lowText = Lower(text);
        const bool isContinuation =
            lowText == L"continue" || lowText == L"continuar" ||
            lowText.find(L"continue de onde parou") != std::wstring::npos ||
            lowText.find(L"continuar de onde parou") != std::wstring::npos ||
            lowText.find(L"veja de novo") != std::wstring::npos ||
            lowText.find(L"olhe de novo") != std::wstring::npos ||
            lowText.find(L"tente novamente") != std::wstring::npos ||
            lowText.find(L"retome a tarefa") != std::wstring::npos;
        if (!isContinuation) ResetActionChain();
    }

    if (!localDesktopIntent && !localScreenshotIntent && !screenshotSaveFollowup && !localFindScreenshotIntent && !localOpenLastScreenshotIntent && g_cfg.apiKey.empty() && g_cfg.provider != Provider::Custom && g_cfg.provider != Provider::Auto) {
        AppendText(L"[Aviso] Informe a chave de API de " +
                   std::wstring(InfoFor(g_cfg.provider).label) +
                   L" nas configurações do mod (Windhawk).\r\n\r\n");
        return;
    }

    AppendText(L"Você: " + ToCRLF(text) + L"\r\n");
    for (const auto& attachment : g_pendingAttachments)
        AppendText(L"[Anexo] " + attachment.name + L"\r\n");
    SetWindowTextW(g_input, L"");
    for (auto& oldMsg : g_hist) { oldMsg.imageBase64.clear(); oldMsg.attachedImageBase64.clear(); }

    // Handle these concrete desktop actions locally: no API call and no screenshot are needed.
    if (localDesktopIntent || localScreenshotIntent || screenshotSaveFollowup || localFindScreenshotIntent || localOpenLastScreenshotIntent) {
        g_hist.push_back({true, ToUtf8(text), ""});
        while (!g_hist.empty() && !g_hist.front().user) g_hist.erase(g_hist.begin());

        if (localScreenshotIntent) {
            const std::string capture = CaptureScreenJpegBase64();
            std::wstring savedFile, savedFolder;
            if (!capture.empty() && SaveScreenshotJpegBase64(capture, &savedFile, &savedFolder)) {
                g_lastScreenshotPath = savedFile;
                g_lastScreenshotFolder = savedFolder;
                g_screenshotContextActive = true;
                const bool requestedShow = WantsScreenshotShown(text);
                const bool shown = !requestedShow || ShellOpen(savedFile);
                std::wstring reply;
                std::wstring spoken;
                if (requestedShow && shown) {
                    reply = L"Pronto! **Tirei e abri o print da sua área de trabalho.**";
                    spoken = L"Pronto! Tirei e abri o print da sua área de trabalho.";
                } else if (requestedShow) {
                    reply = L"**Salvei o print, mas não consegui abri-lo automaticamente.**\r\nEle está salvo em:\r\n**" + savedFile + L"**";
                    spoken = L"Salvei o print, mas não consegui abri-lo automaticamente.";
                } else {
                    reply = L"Pronto! **Salvei o print.**";
                    spoken = L"Pronto! Salvei o print.";
                }
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(spoken);
            } else {
                g_screenshotContextActive = false;
                const std::wstring reply = L"**Não consegui salvar o print.** Verifique se a pasta de imagens está acessível.";
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(StripMarkdownForSpeech(reply));
            }
            return;
        }

        if (screenshotSaveFollowup) {
            if (!g_lastScreenshotPath.empty() && GetFileAttributesW(g_lastScreenshotPath.c_str()) != INVALID_FILE_ATTRIBUTES) {
                const std::wstring reply = L"O print já está salvo em:\r\n**" + g_lastScreenshotPath + L"**";
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(L"O print já está salvo na pasta de capturas de tela.");
            } else {
                const std::string capture = CaptureScreenJpegBase64();
                std::wstring savedFile, savedFolder;
                if (!capture.empty() && SaveScreenshotJpegBase64(capture, &savedFile, &savedFolder)) {
                    g_lastScreenshotPath = savedFile;
                    g_lastScreenshotFolder = savedFolder;
                    g_screenshotContextActive = true;
                    const std::wstring reply = L"Pronto! **Salvei o print em:**\r\n**" + savedFile + L"**";
                    g_hist.push_back({false, ToUtf8(reply)});
                    AppendAssistantReply(reply);
                    SpeakReply(L"Pronto! Salvei o print na pasta de capturas de tela.");
                } else {
                    const std::wstring reply = L"**Não consegui salvar o print.**";
                    g_hist.push_back({false, ToUtf8(reply)});
                    AppendAssistantReply(reply);
                    SpeakReply(StripMarkdownForSpeech(reply));
                }
            }
            return;
        }

        if (localFindScreenshotIntent) {
            if (!g_lastScreenshotPath.empty() && GetFileAttributesW(g_lastScreenshotPath.c_str()) != INVALID_FILE_ATTRIBUTES) {
                const std::wstring pathReply = L"O print está salvo em:\r\n**" + g_lastScreenshotPath + L"**";
                const bool locationAsked = IsScreenshotLocationQuestion(text);
                bool opened = true;
                if (!locationAsked) opened = !g_lastScreenshotFolder.empty() && ShellOpen(g_lastScreenshotFolder);
                const std::wstring reply = locationAsked
                    ? pathReply
                    : (opened ? L"Abri a pasta do print. Ele está em:\r\n**" + g_lastScreenshotPath + L"**"
                              : pathReply);
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(locationAsked ? L"O print está salvo na pasta de capturas de tela."
                                         : L"Abri a pasta do print.");
            } else {
                const std::wstring reply = L"Ainda não salvei nenhum print nesta sessão.";
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(StripMarkdownForSpeech(reply));
            }
            return;
        }

        if (localOpenLastScreenshotIntent) {
            const std::wstring lowText = Lower(text);
            const bool explicitlyWantsFolder = lowText.find(L"pasta") != std::wstring::npos ||
                lowText.find(L"diretório") != std::wstring::npos ||
                lowText.find(L"diretorio") != std::wstring::npos ||
                lowText.find(L"folder") != std::wstring::npos;
            const std::wstring target = explicitlyWantsFolder ? g_lastScreenshotFolder : g_lastScreenshotPath;
            const DWORD attr = target.empty() ? INVALID_FILE_ATTRIBUTES : GetFileAttributesW(target.c_str());
            if (attr != INVALID_FILE_ATTRIBUTES && ShellOpen(target)) {
                const std::wstring reply = explicitlyWantsFolder
                    ? L"Pronto! **Abri a pasta do print.**"
                    : L"Pronto! **Abri o print.**";
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(StripMarkdownForSpeech(reply));
            } else {
                const std::wstring reply = explicitlyWantsFolder
                    ? L"Não consegui abrir a pasta do print."
                    : L"Não consegui abrir a imagem do print.";
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(StripMarkdownForSpeech(reply));
            }
            return;
        }

        if (localScrollIntent) {
            // The user explicitly asked for one simple scroll. Use the cursor's current
            // screen position so the wheel event targets the page/document under it.
            // MouseControl temporarily hides the topmost agent overlay while dispatching.
            POINT cursor{};
            if (!GetCursorPos(&cursor)) {
                const std::wstring reply = L"Não consegui determinar a posição do cursor para rolar a página.";
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(StripMarkdownForSpeech(reply));
                return;
            }
            const int left = GetSystemMetrics(SM_XVIRTUALSCREEN);
            const int top = GetSystemMetrics(SM_YVIRTUALSCREEN);
            const int width = GetSystemMetrics(SM_CXVIRTUALSCREEN);
            const int height = GetSystemMetrics(SM_CYVIRTUALSCREEN);
            if (width <= 1 || height <= 1) {
                const std::wstring reply = L"Não consegui determinar a área de trabalho para rolar a página.";
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(StripMarkdownForSpeech(reply));
                return;
            }
            Action scroll{};
            scroll.type = L"mouse_control";
            scroll.arg = directScrollDirection < 0 ? L"scroll_down" : L"scroll_up";
            scroll.x = std::clamp(MulDiv(cursor.x - left, 1000, width - 1), 0, 1000);
            scroll.y = std::clamp(MulDiv(cursor.y - top, 1000, height - 1), 0, 1000);
            g_actionChainActive = true;
            g_actionChainAuthorized = true; // explicit user command; no redundant confirmation
            g_actionChainCancelled = false;
            g_desktopInspectionChainActive = false;
            g_actionSuccessCount = 0;
            g_actionFailureCount = 0;
            g_actionResultNotes.clear();
            g_scrollVerificationChainActive = g_cfg.screenVision;
            g_scrollVerificationDirection = directScrollDirection;
            const bool deferred = ExecuteActions(std::vector<Action>{scroll});
            if (!deferred) FinishActionChain();
            return;
        }

        if (wallpaperApplyIntent) {
            if (wallpaperApplyPath.empty()) {
                const std::wstring reply = L"Ainda não apliquei o wallpaper: não identifiquei um arquivo de imagem baixado no computador. Abra o pin desejado no Pinterest, baixe a imagem e envie o caminho completo do arquivo (por exemplo, C:\\Users\\Peter\\Pictures\\wallpaper.jpg). Só vou confirmar a troca depois que o Windows aceitar e eu verificar a imagem ativa.";
                g_hist.push_back({false, ToUtf8(reply)});
                AppendAssistantReply(reply);
                SpeakReply(StripMarkdownForSpeech(reply));
                g_actionChainActive = false;
                return;
            }
            g_actionChainActive = true;
            g_actionChainAuthorized = false;
            g_actionChainCancelled = false;
            g_desktopInspectionChainActive = false;
            g_actionSuccessCount = 0; g_actionFailureCount = 0; g_actionResultNotes.clear();
            Action set{}; set.type = L"wallpaper_set"; set.arg = wallpaperApplyPath;
            bool deferred = ExecuteActions(std::vector<Action>{set});
            if (!deferred) FinishActionChain();
            return;
        }

        if (wallpaperOrientationReport) {
            const std::wstring question = L"Você quer girar somente a imagem do papel de parede ou corrigir a orientação da tela inteira?";
            g_hist.push_back({false, ToUtf8(question)});
            AppendText(L"IA: " + question + L"\r\n\r\n");
            SpeakReply(question);
            return;
        }

        if (desktopInspection && !g_cfg.screenVision) {
            const std::wstring reply = L"Ative a opção Visão da tela nas configurações do mod para eu poder analisar a área de trabalho.";
            g_hist.push_back({false, ToUtf8(reply)});
            AppendAssistantReply(reply);
            SpeakReply(StripMarkdownForSpeech(reply));
            return;
        }

        g_actionChainActive = true;
        g_actionChainAuthorized = false;
        g_actionChainCancelled = false;
        g_desktopInspectionChainActive = desktopInspection;
        g_actionSuccessCount = 0;
        g_actionFailureCount = 0;
        g_actionResultNotes.clear();

        std::vector<Action> directActions;
        if (IsExplicitWallpaperRotateRequest(text)) {
            directActions.push_back({L"wallpaper_rotate", L"clockwise"});
        } else if (wallpaperSearchIntent) {
            // Deterministic override: a request for a new wallpaper means search for
            // alternatives on Pinterest, not rotate the current image. This local
            // route prevents unrelated model actions (e.g. open a PowerPoint) from
            // being executed for this request.
            Action search;
            search.type = L"site_search";
            search.arg = L"Pinterest";
            search.detail = BuildWallpaperSearchQuery();
            directActions.push_back(search);
        } else {
            Action minimizeAll;
            minimizeAll.type = L"mouse_control";
            minimizeAll.arg = L"key";
            minimizeAll.detail = L"WIN+M";
            directActions.push_back(minimizeAll);
            if (desktopInspection) {
                g_pendingScreenInstruction = L"O usuário pediu para ver a área de trabalho. As janelas foram minimizadas para revelar o desktop. Analise a captura atual; descreva os ícones, a organização e o papel de parede que estiverem realmente visíveis. Não diga que não tem acesso à área de trabalho quando a imagem estiver anexada. Não invente itens que não aparecem na captura.";
                Action inspect;
                inspect.type = L"inspect_screen";
                inspect.arg = L"current";
                directActions.push_back(inspect);
            }
        }
        bool deferred = ExecuteActions(directActions);
        if (!deferred) {
            g_pendingScreenInstruction.clear();
            const std::wstring localSummary = BuildLocalActionSummary();
            g_hist.push_back({false, ToUtf8(localSummary)});
            FinishActionChain(localSummary);
        }
        return;
    }

    const bool hadPendingAttachments = !g_pendingAttachments.empty();
    const bool hasPendingImageAttachment = std::any_of(g_pendingAttachments.begin(), g_pendingAttachments.end(),
        [](const FileAttachment& attachment) { return !attachment.imageBase64.empty(); });
    const bool attachmentContinuesCropTask = hasPendingImageAttachment && MostRecentUserTurnWasImageCropRequest(g_hist);
    const bool explicitWallpaperInspection = IsWallpaperInspectionRequest(text);
    const bool wallpaperFollowUp = !hadPendingAttachments &&
        g_wallpaperInspectionContextActive && IsVisualChallengeFollowUp(text);
    const bool wallpaperInspection = explicitWallpaperInspection || wallpaperFollowUp;
    if (!wallpaperInspection) g_wallpaperInspectionContextActive = false;
    std::wstring aiPrompt = text;
    if (attachmentContinuesCropTask) {
        aiPrompt += L"\r\n\r\n[CONTEXTO: este anexo dá continuidade ao pedido imediatamente anterior do usuário para recortar e salvar cada rosto. Use o arquivo anexado agora como origem. Você precisa emitir a ação executável crop_image com o caminho local exato e uma caixa por rosto; não responda somente com 'analisando imagem' ou 'salvando recortes'.]";
    }
    if (wallpaperFollowUp) {
        aiPrompt += L"\r\n\r\n[REAVALIAÇÃO VISUAL OBRIGATÓRIA: o usuário está contestando ou confirmando a análise anterior do wallpaper. Uma NOVA imagem do arquivo de papel de parede está sendo anexada agora. Examine essa imagem do zero; não repita automaticamente sua descrição anterior e não concorde automaticamente com o usuário. Use detalhes visíveis específicos para sustentar a descrição. Se não conseguir identificar o conteúdo com confiança, diga que não consegue confirmar, em vez de inventar objetos, estrelas, padrões ou cores.]";
    }
    std::vector<std::string> attachedImages;
    for (const auto& attachment : g_pendingAttachments) {
        aiPrompt += L"\r\n\r\n[ARQUIVO ANEXADO: " + attachment.name + L"; caminho local: " + attachment.path + L"; tipo: " + attachment.mimeType + L"; tamanho: " + std::to_wstring(attachment.size) + L" bytes]\r\n";
        if (!attachment.textContent.empty()) {
            aiPrompt += L"Conteúdo extraído do arquivo (UTF-8):\r\n" + FromUtf8(attachment.textContent) + L"\r\n[FIM DO ARQUIVO]";
        } else if (!attachment.imageBase64.empty()) {
            aiPrompt += L"Imagem anexada à mensagem para análise visual.";
            attachedImages.push_back(attachment.imageBase64);
        } else {
            aiPrompt += L"O arquivo foi anexado por nome e metadados, mas o host não conseguiu extrair seu conteúdo binário. Não invente o conteúdo; explique a limitação e, se possível, peça que o usuário exporte o arquivo para um formato de texto/imagem legível.";
        }
    }
    std::string screenshot;
    bool capturedWallpaperFile = false;
    const bool needsScreen = g_cfg.screenVision &&
        (wallpaperInspection || ShouldAttachScreenToMessage(text)) &&
        (!hadPendingAttachments || ExplicitlyRequestsCurrentScreen(text));
    if (needsScreen) {
        if (wallpaperInspection) {
            screenshot = CaptureCurrentWallpaperJpegBase64();
            if (!screenshot.empty()) {
                capturedWallpaperFile = true;
                aiPrompt += L"\r\n\r\n[CONTEXTO VISUAL: a imagem anexada é o arquivo de papel de parede atualmente configurado pelo Windows, não uma captura das janelas abertas. Avalie somente a imagem fornecida. Descreva apenas características realmente visíveis e distinguíveis na imagem; não invente objetos ou padrões.]";
                AppendText(L"[Visão] A imagem do papel de parede atual foi anexada para análise.\r\n");
            }
        }
        if (screenshot.empty()) {
            screenshot = CaptureScreenForVisionJpegBase64();
            if (!screenshot.empty()) {
                if (wallpaperInspection) aiPrompt += L"\r\n\r\n[CONTEXTO VISUAL: a imagem anexada é uma captura da tela atual. Se o papel de parede estiver coberto por janelas, diga que não consegue avaliá-lo a partir desta captura.]";
                AppendText(L"[Visão] Esta tarefa exige análise visual; a captura atual foi gerada para esta mensagem.\r\n");
            }
        }
        if (screenshot.empty()) {
            AppendText(L"[Visão] Não consegui capturar uma imagem válida. Não enviei esta solicitação à IA para evitar uma resposta fingindo que viu a tela. Tente novamente.\r\n\r\n");
            SetWindowTextW(g_input, text.c_str());
            return;
        }
    }
    if (wallpaperInspection) {
        // Keep visual context only when the wallpaper image file itself was attached.
        // A later short challenge can then trigger a fresh capture of that same source.
        g_wallpaperInspectionContextActive = capturedWallpaperFile;
    }
    g_pendingAttachments.clear();
    // Only the current turn should carry image bytes. Old assistant/user text remains
    // in the conversation, but stale screenshots are not resent with every new message.
    for (size_t i = 0; i < g_hist.size(); ++i) {
        g_hist[i].imageBase64.clear();
        g_hist[i].attachedImageBase64.clear();
    }
    g_hist.push_back({true, ToUtf8(aiPrompt), screenshot, std::move(attachedImages)});
    while (g_hist.size() > 32) g_hist.erase(g_hist.begin());
    while (!g_hist.empty() && !g_hist.front().user) g_hist.erase(g_hist.begin());

    EnsureAppIndex();
    auto* job = new Job{g_panel, g_cfg, BuildSystemPrompt(g_cfg, g_apps), g_hist};
    g_busy = true;
    InvalidateRect(g_panel, nullptr, FALSE);
    InvalidateRect(g_bubble, nullptr, FALSE);

    HANDLE t = CreateThread(nullptr, 0, AiThread, job, 0, nullptr);
    if (!t) {
        delete job;
        g_busy = false;
        g_hist.pop_back();
        AppendText(L"[Erro] Não consegui iniciar a requisição.\r\n\r\n");
        return;
    }
    CloseHandle(t);
}

void StartSiteSearchReview() {
    if (!g_pendingSiteReview || g_busy) return;
    const std::wstring site = g_pendingSiteName;
    const std::wstring query = g_pendingSiteQuery;
    g_pendingSiteReview = false;
    if (!g_cfg.screenVision) {
        const std::wstring m = L"A busca foi aberta, mas a leitura dos resultados não ocorreu porque a Visão da tela está desativada.";
        if (g_actionChainActive) FinishActionChain(m); else AppendText(L"[Busca] " + m + L"\r\n\r\n");
        return;
    }
    std::string screenshot = CaptureScreenForVisionJpegBase64();
    if (screenshot.empty()) {
        const std::wstring m = L"Abri a busca em " + site + L", mas não consegui capturar a página para ler os resultados.";
        if (g_actionChainActive) FinishActionChain(m); else AppendText(L"[Busca] " + m + L"\r\n\r\n");
        return;
    }
    if (g_cfg.apiKey.empty() && g_cfg.provider != Provider::Custom && g_cfg.provider != Provider::Auto) {
        const std::wstring m = L"Abri a busca em " + site + L", mas falta configurar a chave de API para analisar os resultados.";
        if (g_actionChainActive) FinishActionChain(m); else AppendText(L"[Busca] " + m + L"\r\n\r\n");
        return;
    }
    for (auto& oldMsg : g_hist) { oldMsg.imageBase64.clear(); oldMsg.attachedImageBase64.clear(); }
    std::wstring instruction = L"CONTINUAÇÃO AUTOMÁTICA DA BUSCA NO SITE " + site +
        L". Termo pesquisado: \"" + query +
        L"\". Analise a captura de tela anexada, feita depois de abrir a busca no próprio site. Resuma apenas os resultados, títulos, imagens ou conteúdos realmente visíveis; se houver login, CAPTCHA, bloqueio, página vazia ou erro, diga isso claramente e peça a intervenção do usuário. A captura anexada já é a imagem da tela: NÃO peça ao usuário para enviar outra captura se esta estiver legível. Se a página ainda estiver carregando, diga que a análise ficou inconclusiva e aguarde uma nova confirmação do usuário, sem inventar resultados. Não use busca externa. Não clique em resultados nesta etapa. Responda em português de forma concisa, sem narrar passos futuros.";
    g_hist.push_back({true, ToUtf8(instruction), screenshot});
    while (!g_hist.empty() && !g_hist.front().user) g_hist.erase(g_hist.begin());
    EnsureAppIndex();
    auto* job = new Job{g_panel, g_cfg, BuildSystemPrompt(g_cfg, g_apps), g_hist};
    g_busy = true;
    if (!g_actionChainActive) AppendText(L"[Busca] A página de " + site + L" foi aberta. Estou lendo os resultados visíveis...\r\n");
    InvalidateRect(g_panel, nullptr, FALSE);
    InvalidateRect(g_bubble, nullptr, FALSE);
    HANDLE t = CreateThread(nullptr, 0, AiThread, job, 0, nullptr);
    if (!t) {
        delete job;
        g_busy = false;
        if (!g_hist.empty() && g_hist.back().user) g_hist.pop_back();
        if (g_actionChainActive) FinishActionChain(L"A busca foi aberta, mas não consegui iniciar a análise visual dos resultados.");
        else AppendText(L"[Busca] Não consegui iniciar a análise dos resultados.\r\n\r\n");
        InvalidateRect(g_panel, nullptr, FALSE);
        InvalidateRect(g_bubble, nullptr, FALSE);
        return;
    }
    CloseHandle(t);
}

void StartScreenReview() {
    if (!g_pendingScreenReview || g_busy) return;
    std::wstring instruction = g_pendingScreenInstruction;
    g_pendingScreenReview = false;
    g_pendingScreenInstruction.clear();
    if (!g_cfg.screenVision) {
        const std::wstring m = L"Não consegui verificar a etapa final porque a Visão da tela está desativada.";
        if (g_actionChainActive) FinishActionChain(m); else AppendText(L"[Visão] " + m + L"\r\n\r\n");
        return;
    }
    std::string screenshot = CaptureScreenForVisionJpegBase64();
    if (screenshot.empty()) {
        const std::wstring m = L"Não consegui capturar a tela para verificar a última ação.";
        if (g_actionChainActive) FinishActionChain(m); else AppendText(L"[Visão] " + m + L"\r\n\r\n");
        return;
    }
    if (g_cfg.apiKey.empty() && g_cfg.provider != Provider::Custom && g_cfg.provider != Provider::Auto) {
        const std::wstring m = L"A captura foi feita, mas falta configurar a chave de API para verificar a ação.";
        if (g_actionChainActive) FinishActionChain(m); else AppendText(L"[Visão] " + m + L"\r\n\r\n");
        return;
    }
    const bool compareScrollFrames = g_scrollVerificationPending && !g_scrollBeforeScreenshot.empty();
    std::string beforeScroll = compareScrollFrames ? g_scrollBeforeScreenshot : std::string();
    g_scrollBeforeScreenshot.clear();
    g_scrollVerificationPending = false;
    for (auto& oldMsg : g_hist) { oldMsg.imageBase64.clear(); oldMsg.attachedImageBase64.clear(); }
    if (instruction.empty()) instruction = L"Analise a tela atualizada e diga o que está visível.";
    if (compareScrollFrames) {
        instruction += L" Esta mensagem contém duas imagens na seguinte ordem: primeira, captura ANTES da rolagem; segunda, captura DEPOIS da rolagem. Compare o conteúdo da página/posição do documento e só confirme o sucesso se houver mudança visual compatível. Se não houver evidência de mudança, diga que não foi possível confirmar; não repita a rolagem automaticamente.";
        g_hist.push_back({true, ToUtf8(instruction), beforeScroll, {screenshot}});
    } else {
        instruction += L" Esta é uma captura nova, feita depois da ação anterior. Compare-a com a tarefa original e com as ações já tentadas. Se a tarefa continuar, retorne um lote com várias ações seguras e previsíveis. Use inspect_screen somente após uma mudança importante da interface ou na verificação final, nunca após cada clique ou movimento do cursor. Não repita ações que já foram executadas. Se for necessário login, CAPTCHA ou permissão, peça a intervenção do usuário. A resposta falada deve ser apenas a conclusão factual quando não houver mais ações; não narre o que pretende fazer.";
        g_hist.push_back({true, ToUtf8(instruction), screenshot});
    }
    while (!g_hist.empty() && !g_hist.front().user) g_hist.erase(g_hist.begin());
    EnsureAppIndex();
    auto* job = new Job{g_panel, g_cfg, BuildSystemPrompt(g_cfg, g_apps), g_hist};
    g_busy = true;
    if (!g_actionChainActive) AppendText(L"[Visão] Captura atualizada. Estou verificando a tela e a próxima etapa...\r\n");
    InvalidateRect(g_panel, nullptr, FALSE);
    InvalidateRect(g_bubble, nullptr, FALSE);
    HANDLE t = CreateThread(nullptr, 0, AiThread, job, 0, nullptr);
    if (!t) {
        delete job;
        g_busy = false;
        if (!g_hist.empty() && g_hist.back().user) g_hist.pop_back();
        if (g_actionChainActive) FinishActionChain(L"Executei as ações anteriores, mas não consegui iniciar a verificação visual final.");
        else AppendText(L"[Visão] Não consegui iniciar a análise da tela.\r\n\r\n");
        InvalidateRect(g_panel, nullptr, FALSE);
        InvalidateRect(g_bubble, nullptr, FALSE);
        return;
    }
    CloseHandle(t);
}

int ClampInt(int v, int lo, int hi) { return std::clamp(v, lo, std::max(lo, hi)); }

void PositionPanel() {
    RECT b;
    GetWindowRect(g_bubble, &b);
    HMONITOR mon = MonitorFromRect(&b, MONITOR_DEFAULTTONEAREST);
    MONITORINFO mi = {sizeof(mi)};
    GetMonitorInfoW(mon, &mi);
    int gap = S(10);
    int x = b.right - g_panelW;
    int y = b.top - g_panelH - gap;
    if (y < mi.rcWork.top) y = b.bottom + gap;
    x = ClampInt(x, mi.rcWork.left, mi.rcWork.right - g_panelW);
    y = ClampInt(y, mi.rcWork.top, mi.rcWork.bottom - g_panelH);
    SetWindowPos(g_panel, HWND_TOPMOST, x, y, g_panelW, g_panelH, SWP_NOACTIVATE);
}

void ShowPanel() {
    PositionPanel();
    ShowWindow(g_panel, SW_SHOW);
    SetForegroundWindow(g_panel);
    SetFocus(g_input);
    InvalidateRect(g_bubble, nullptr, FALSE);
}

void HidePanel() {
    ShowWindow(g_panel, SW_HIDE);
    InvalidateRect(g_bubble, nullptr, FALSE);
}

void TogglePanel() {
    if (IsWindowVisible(g_panel)) HidePanel();
    else ShowPanel();
}

// ---- Painel ----

void PaintPanel(HWND h) {
    PAINTSTRUCT ps;
    HDC dc = BeginPaint(h, &ps);
    RECT rc;
    GetClientRect(h, &rc);
    int W = rc.right, H = rc.bottom;
    Layout l = MakeLayout(W, H);

    HDC mem = CreateCompatibleDC(dc);
    HBITMAP bmp = CreateCompatibleBitmap(dc, W, H);
    HGDIOBJ old = SelectObject(mem, bmp);

    FillSolid(mem, rc, kBg);
    FillSolid(mem, l.header, kHeader);
    SetBkMode(mem, TRANSPARENT);

    RECT avatarRect = {S(10), S(7), S(40), S(37)};
    RoundFill(mem, avatarRect, S(15), kAccent);
    if (!DrawAvatar(mem, avatarRect, true)) {
        SelectObject(mem, g_fontTitle);
        SetTextColor(mem, RGB(255, 255, 255));
        RECT face = avatarRect;
        DrawTextW(mem, L"✦", -1, &face, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
    } else {
        HPEN avatarPen = CreatePen(PS_SOLID, std::max(1, S(1)), kAccent);
        HGDIOBJ oldAvatarPen = SelectObject(mem, avatarPen);
        HGDIOBJ oldAvatarBrush = SelectObject(mem, GetStockObject(NULL_BRUSH));
        Ellipse(mem, avatarRect.left, avatarRect.top, avatarRect.right, avatarRect.bottom);
        SelectObject(mem, oldAvatarBrush);
        SelectObject(mem, oldAvatarPen);
        DeleteObject(avatarPen);
    }
    SelectObject(mem, g_fontTitle);
    SetTextColor(mem, kText);
    RECT t = {S(48), S(5), l.clearBtn.left - S(6), S(27)};
    DrawTextW(mem, L"Assistente IA", -1, &t,
              DT_LEFT | DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS);

    SelectObject(mem, g_fontSmall);
    SetTextColor(mem, g_busy ? RGB(245, 158, 11) : kSub);
    std::wstring sub = g_busy ? L"Pensando..."
                              : std::wstring(InfoFor(g_cfg.provider).label) + L" \u2022 " +
                                    EffectiveModel(g_cfg);
    RECT st = {S(48), S(25), l.clearBtn.left - S(6), S(42)};
    DrawTextW(mem, sub.c_str(), -1, &st,
              DT_LEFT | DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS);

    SetTextColor(mem, kSub);
    RECT cb = l.clearBtn;
    DrawTextW(mem, L"Limpar", -1, &cb, DT_CENTER | DT_SINGLELINE | DT_VCENTER);

    // X de fechar
    HPEN pen = CreatePen(PS_SOLID, std::max(1, S(2)), kSub);
    HGDIOBJ op = SelectObject(mem, pen);
    int cx = (l.closeBtn.left + l.closeBtn.right) / 2;
    int cy = (l.closeBtn.top + l.closeBtn.bottom) / 2;
    int d = S(6);
    MoveToEx(mem, cx - d, cy - d, nullptr);
    LineTo(mem, cx + d, cy + d);
    MoveToEx(mem, cx + d, cy - d, nullptr);
    LineTo(mem, cx - d, cy + d);
    SelectObject(mem, op);
    DeleteObject(pen);

    RoundFill(mem, l.histCard, S(10), kHistBg);
    RoundFill(mem, l.inputCard, S(10), kInputBg);
    RoundFill(mem, l.sendBtn, S(10), g_busy ? RGB(70, 74, 90) : kAccent);
    SelectObject(mem, g_fontBody);
    SetTextColor(mem, RGB(255, 255, 255));
    RECT sb = l.sendBtn;
    DrawTextW(mem, g_busy ? L"..." : L"Enviar", -1, &sb,
              DT_CENTER | DT_SINGLELINE | DT_VCENTER);

    BitBlt(dc, 0, 0, W, H, mem, 0, 0, SRCCOPY);
    SelectObject(mem, old);
    DeleteObject(bmp);
    DeleteDC(mem);
    EndPaint(h, &ps);
}

void LayoutPanelChildren(HWND h) {
    RECT rc;
    GetClientRect(h, &rc);
    Layout l = MakeLayout(rc.right, rc.bottom);
    SetWindowPos(g_history, nullptr, l.histEdit.left, l.histEdit.top,
                 l.histEdit.right - l.histEdit.left, l.histEdit.bottom - l.histEdit.top,
                 SWP_NOZORDER | SWP_NOACTIVATE);
    SetWindowPos(g_input, nullptr, l.inputEdit.left, l.inputEdit.top,
                 l.inputEdit.right - l.inputEdit.left, l.inputEdit.bottom - l.inputEdit.top,
                 SWP_NOZORDER | SWP_NOACTIVATE);
}

LRESULT CALLBACK AttachmentDropSubclassProc(HWND hwnd, UINT message, WPARAM wParam, LPARAM lParam,
                                            UINT_PTR subclassId, DWORD_PTR refData) {
    if (message == WM_DROPFILES) {
        AddDroppedFilesFromHdrop(reinterpret_cast<HDROP>(wParam));
        return 0;
    }
    if (message == WM_NCDESTROY) RemoveWindowSubclass(hwnd, AttachmentDropSubclassProc, subclassId);
    return DefSubclassProc(hwnd, message, wParam, lParam);
}

LRESULT CALLBACK PanelProc(HWND h, UINT m, WPARAM w, LPARAM l) {
    switch (m) {
        case WM_CREATE: {
            DragAcceptFiles(h, TRUE);
            HINSTANCE inst = GetModuleHandleW(nullptr);
            // Load RichEdit so the chat can render Markdown emphasis as real bold text.
            // Keep the module loaded for the lifetime of this Windhawk mod.
            LoadLibraryW(L"Msftedit.dll");
            g_history = CreateWindowExW(
                0, L"RICHEDIT50W", L"",
                WS_CHILD | WS_VISIBLE | WS_VSCROLL | ES_MULTILINE | ES_READONLY |
                    ES_AUTOVSCROLL,
                0, 0, 10, 10, h, reinterpret_cast<HMENU>(static_cast<INT_PTR>(ID_HISTORY)),
                inst, nullptr);
            g_input = CreateWindowExW(
                0, L"RICHEDIT50W", L"", WS_CHILD | WS_VISIBLE | WS_VSCROLL | ES_MULTILINE | ES_AUTOVSCROLL,
                0, 0, 10, 10, h, reinterpret_cast<HMENU>(static_cast<INT_PTR>(ID_INPUT)),
                inst, nullptr);
            SendMessageW(g_history, WM_SETFONT, reinterpret_cast<WPARAM>(g_fontBody), TRUE);
            SendMessageW(g_input, WM_SETFONT, reinterpret_cast<WPARAM>(g_fontBody), TRUE);
            SendMessageW(g_history, EM_EXLIMITTEXT, 0, static_cast<LPARAM>(0x7FFFFFFE));
            SendMessageW(g_input, EM_EXLIMITTEXT, 0, static_cast<LPARAM>(0x7FFFFFFE));
            DragAcceptFiles(g_history, TRUE);
            DragAcceptFiles(g_input, TRUE);
            SetWindowSubclass(g_history, AttachmentDropSubclassProc, 101, 0);
            SetWindowSubclass(g_input, AttachmentDropSubclassProc, 102, 0);
            SetWindowTheme(g_history, L"DarkMode_Explorer", nullptr);
            SetWindowTheme(g_input, L"DarkMode_Explorer", nullptr);
            LayoutPanelChildren(h);
            SetWindowRgn(h, CreateRoundRectRgn(0, 0, g_panelW + 1, g_panelH + 1, S(18), S(18)),
                         TRUE);
            AppendText(g_greeting);
            return 0;
        }
        case WM_ERASEBKGND:
            return 1;
        case WM_PAINT:
            PaintPanel(h);
            return 0;
        case WM_CTLCOLOREDIT:
        case WM_CTLCOLORSTATIC: {
            HDC dc = reinterpret_cast<HDC>(w);
            bool hist = reinterpret_cast<HWND>(l) == g_history;
            SetTextColor(dc, kText);
            SetBkColor(dc, hist ? kHistBg : kInputBg);
            return reinterpret_cast<LRESULT>(hist ? g_brHist : g_brInput);
        }
        case WM_NCHITTEST: {
            POINT pt = {GET_X_LPARAM(l), GET_Y_LPARAM(l)};
            ScreenToClient(h, &pt);
            RECT rc;
            GetClientRect(h, &rc);
            Layout lay = MakeLayout(rc.right, rc.bottom);
            if (InRect(lay.header, pt.x, pt.y) && !InRect(lay.closeBtn, pt.x, pt.y) &&
                !InRect(lay.clearBtn, pt.x, pt.y))
                return HTCAPTION;
            return HTCLIENT;
        }
        case WM_LBUTTONDOWN: {
            int x = GET_X_LPARAM(l), y = GET_Y_LPARAM(l);
            RECT rc;
            GetClientRect(h, &rc);
            Layout lay = MakeLayout(rc.right, rc.bottom);
            if (InRect(lay.closeBtn, x, y)) HidePanel();
            else if (InRect(lay.clearBtn, x, y)) { if (!g_busy) ResetChat(); }
            else if (InRect(lay.sendBtn, x, y)) SendFromInput();
            return 0;
        }
        case WM_ACTIVATE:
            if (LOWORD(w) == WA_INACTIVE && g_cfg.closeWhenFocusLost && !g_inModal &&
                IsWindowVisible(h))
                HidePanel();
            return 0;
        case WM_DROPFILES:
            AddDroppedFilesFromHdrop(reinterpret_cast<HDROP>(w));
            return 0;
        case WM_APP_AI_RESULT: {
            std::unique_ptr<AiResult> r(reinterpret_cast<AiResult*>(l));
            if (r) OnAiResult(*r);
            return 0;
        }
    }
    return DefWindowProcW(h, m, w, l);
}

