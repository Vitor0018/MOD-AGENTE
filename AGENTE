std::string ImageFileToJpegBase64(const std::wstring& path) {
    if (!g_uiGdipReady) return {};
    std::unique_ptr<Gdiplus::Image> image(Gdiplus::Image::FromFile(path.c_str(), FALSE));
    if (!image || image->GetLastStatus() != Gdiplus::Ok) return {};
    CLSID encoder{};
    if (!GetJpegEncoder(&encoder)) return {};
    IStream* stream = nullptr;
    if (FAILED(CreateStreamOnHGlobal(nullptr, TRUE, &stream)) || !stream) return {};
    std::string result;
    if (image->Save(stream, &encoder, nullptr) == Gdiplus::Ok) {
        STATSTG st{};
        if (SUCCEEDED(stream->Stat(&st, STATFLAG_NONAME)) && st.cbSize.QuadPart > 0 && st.cbSize.QuadPart <= 20 * 1024 * 1024) {
            HGLOBAL hg = nullptr;
            if (SUCCEEDED(GetHGlobalFromStream(stream, &hg)) && hg) {
                void* bytes = GlobalLock(hg);
                if (bytes) {
                    result = Base64Encode(static_cast<const unsigned char*>(bytes), static_cast<size_t>(st.cbSize.QuadPart));
                    GlobalUnlock(hg);
                }
            }
        }
    }
    stream->Release();
    return result;
}

std::string DecodeTextFileBytes(const std::vector<unsigned char>& bytes) {
    if (bytes.empty()) return {};
    if (bytes.size() >= 2 && bytes[0] == 0xFF && bytes[1] == 0xFE) {
        const wchar_t* w = reinterpret_cast<const wchar_t*>(bytes.data() + 2);
        size_t chars = (bytes.size() - 2) / sizeof(wchar_t);
        return ToUtf8(std::wstring(w, chars));
    }
    size_t offset = (bytes.size() >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF) ? 3 : 0;
    bool hasNull = false;
    size_t controls = 0;
    for (size_t i = offset; i < bytes.size(); ++i) {
        if (bytes[i] == 0) hasNull = true;
        if (bytes[i] < 9 || (bytes[i] > 13 && bytes[i] < 32)) ++controls;
    }
    if (hasNull || controls > bytes.size() / 100 + 2) return {};
    std::string raw(reinterpret_cast<const char*>(bytes.data() + offset), bytes.size() - offset);
    if (!raw.empty() && MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, raw.data(), static_cast<int>(raw.size()), nullptr, 0) > 0)
        return raw;
    int n = MultiByteToWideChar(CP_ACP, 0, raw.data(), static_cast<int>(raw.size()), nullptr, 0);
    if (n <= 0) return {};
    std::wstring wide(static_cast<size_t>(n), L'\0');
    MultiByteToWideChar(CP_ACP, 0, raw.data(), static_cast<int>(raw.size()), wide.data(), n);
    return ToUtf8(wide);
}

FileAttachment InspectAttachment(const std::wstring& path) {
    FileAttachment a;
    a.path = path;
    a.name = FileNameOnly(path);
    const std::wstring ext = FileExtensionLower(path);
    HANDLE h = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                           nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (h == INVALID_HANDLE_VALUE) return a;
    LARGE_INTEGER size{};
    if (!GetFileSizeEx(h, &size) || size.QuadPart < 0) { CloseHandle(h); return a; }
    a.size = static_cast<ULONGLONG>(size.QuadPart);
    constexpr ULONGLONG kMaxReadBytes = 32ull * 1024 * 1024;
    std::vector<unsigned char> bytes;
    if (a.size > 0 && a.size <= kMaxReadBytes) {
        bytes.resize(static_cast<size_t>(a.size));
        DWORD total = 0;
        while (total < bytes.size()) {
            DWORD chunk = static_cast<DWORD>(std::min<size_t>(bytes.size() - total, 1024 * 1024));
            DWORD got = 0;
            if (!ReadFile(h, bytes.data() + total, chunk, &got, nullptr) || got == 0) break;
            total += got;
        }
        bytes.resize(total);
    }
    CloseHandle(h);
    if (IsImageExtension(ext)) {
        a.mimeType = L"image/jpeg";
        a.imageBase64 = ImageFileToJpegBase64(path);
        a.textExtracted = !a.imageBase64.empty();
        return a;
    }
    const bool opaqueBinary = ext == L".pdf" || ext == L".doc" || ext == L".docx" || ext == L".xls" ||
        ext == L".xlsx" || ext == L".ppt" || ext == L".pptx" || ext == L".zip" || ext == L".rar" ||
        ext == L".7z" || ext == L".exe" || ext == L".dll" || ext == L".msi" || ext == L".mp4" ||
        ext == L".mkv" || ext == L".mov" || ext == L".mp3" || ext == L".wav" || ext == L".flac" ||
        ext == L".psd" || ext == L".blend";
    if (!bytes.empty() && !opaqueBinary) {
        std::string decoded = DecodeTextFileBytes(bytes);
        if (!decoded.empty()) {
            constexpr size_t kMaxExtractedChars = 2 * 1024 * 1024;
            if (decoded.size() > kMaxExtractedChars) decoded.resize(kMaxExtractedChars);
            a.textContent = std::move(decoded);
            a.textExtracted = true;
            a.mimeType = L"text/plain";
        }
    }
    if (a.mimeType.empty()) {
        if (ext == L".pdf") a.mimeType = L"application/pdf";
        else if (ext == L".docx") a.mimeType = L"application/vnd.openxmlformats-officedocument.wordprocessingml.document";
        else if (ext == L".xlsx") a.mimeType = L"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
        else if (ext == L".pptx") a.mimeType = L"application/vnd.openxmlformats-officedocument.presentationml.presentation";
        else a.mimeType = L"application/octet-stream";
    }
    return a;
}

bool LooksLikeSourceCode(const std::wstring& value) {
    if (value.size() < 20) return false;
    const std::wstring s = Lower(value);
    return s.find(L"#include") != std::wstring::npos || s.find(L"int main(") != std::wstring::npos ||
           s.find(L"void whtool_modinit") != std::wstring::npos || s.find(L"windhawkmod") != std::wstring::npos ||
           s.find(L"namespace {") != std::wstring::npos || s.find(L"<script") != std::wstring::npos ||
           s.find(L"def ") != std::wstring::npos || s.find(L"function ") != std::wstring::npos;
}

std::wstring ExtractCodeCandidate(const std::wstring& raw) {
    size_t fence = raw.find(L"```");
    if (fence != std::wstring::npos) {
        size_t codeStart = raw.find(L'\n', fence + 3);
        if (codeStart != std::wstring::npos) {
            ++codeStart;
            size_t codeEnd = raw.find(L"```", codeStart);
            if (codeEnd != std::wstring::npos) {
                std::wstring code = Trim(raw.substr(codeStart, codeEnd - codeStart));
                if (LooksLikeSourceCode(code)) return code + L"\r\n";
            }
        }
    }
    if (LooksLikeSourceCode(raw)) return raw;
    return {};
}

bool IsSourceReplacementRequest(const std::wstring& raw) {
    const std::wstring s = Lower(raw);
    const bool source = s.find(L"código-fonte") != std::wstring::npos ||
        s.find(L"codigo-fonte") != std::wstring::npos || s.find(L"código fonte") != std::wstring::npos ||
        s.find(L"codigo fonte") != std::wstring::npos || s.find(L"fonte do mod") != std::wstring::npos ||
        s.find(L"source code") != std::wstring::npos || s.find(L"arquivo do mod") != std::wstring::npos ||
        s.find(L"código do agente") != std::wstring::npos || s.find(L"codigo do agente") != std::wstring::npos ||
        s.find(L"código do mod") != std::wstring::npos || s.find(L"codigo do mod") != std::wstring::npos ||
        s.find(L"fonte dele") != std::wstring::npos || s.find(L"fonte do agente") != std::wstring::npos ||
        s.find(L".cpp") != std::wstring::npos;
    const bool replace = s.find(L"substitu") != std::wstring::npos || s.find(L"troque") != std::wstring::npos ||
        s.find(L"coloque") != std::wstring::npos || s.find(L"aplique") != std::wstring::npos ||
        s.find(L"atualize") != std::wstring::npos || s.find(L"salve") != std::wstring::npos ||
        s.find(L"replace") != std::wstring::npos || s.find(L"gravar") != std::wstring::npos;
    return source && replace;
}

bool ReplaceConfiguredSource(const std::wstring& candidate, std::wstring& info) {
    std::wstring target = Trim(ExpandEnvironment(g_cfg.sourceCodePath));
    if (target.empty()) {
        info = L"Configure o caminho completo do arquivo .cpp em Configurações do mod > Caminho do código-fonte antes de pedir a substituição.";
        return false;
    }
    if (FileExtensionLower(target) != L".cpp") {
        info = L"O caminho configurado precisa apontar para um arquivo .cpp.";
        return false;
    }
    if (candidate.empty() || !LooksLikeSourceCode(candidate)) {
        info = L"Não encontrei código-fonte completo para aplicar. Anexe um .cpp ou envie o código em um bloco ```cpp antes de pedir a substituição.";
        return false;
    }
    DWORD attrs = GetFileAttributesW(target.c_str());
    bool exists = attrs != INVALID_FILE_ATTRIBUTES && !(attrs & FILE_ATTRIBUTE_DIRECTORY);
    if (!exists) {
        info = L"O arquivo .cpp configurado não foi encontrado. Confira o caminho completo nas configurações; nada foi gravado.";
        return false;
    }
    std::wstring prompt = L"Substituir o código-fonte configurado por esta versão?\n\nO arquivo atual será copiado para um backup. Você ainda precisará compilar e testar no Windhawk.\n\nArquivo: " + target;
    g_inModal = true;
    const int answer = MessageBoxW(g_panel, prompt.c_str(), L"AI Agent Bubble — confirmar substituição", MB_YESNO | MB_ICONWARNING | MB_DEFBUTTON2);
    g_inModal = false;
    if (answer != IDYES) {
        info = L"A substituição do código-fonte foi cancelada.";
        return false;
    }
    SYSTEMTIME st{}; GetLocalTime(&st);
    wchar_t stamp[64]{};
    swprintf_s(stamp, L".backup_%04u%02u%02u_%02u%02u%02u", st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond);
    std::wstring backup = target + stamp;
    if (exists && !CopyFileW(target.c_str(), backup.c_str(), TRUE)) {
        info = L"Não consegui criar o backup do código-fonte; nada foi substituído.";
        return false;
    }
    const std::string utf8 = ToUtf8(candidate);
    std::wstring temp = target + L".agent_tmp";
    HANDLE out = CreateFileW(temp.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (out == INVALID_HANDLE_VALUE) {
        info = L"Não consegui criar o arquivo temporário do código-fonte.";
        return false;
    }
    size_t offset = 0; bool writeOk = true;
    while (offset < utf8.size()) {
        DWORD chunk = static_cast<DWORD>(std::min<size_t>(utf8.size() - offset, 1024 * 1024));
        DWORD written = 0;
        if (!WriteFile(out, utf8.data() + offset, chunk, &written, nullptr) || written != chunk) { writeOk = false; break; }
        offset += written;
    }
    if (writeOk) writeOk = FlushFileBuffers(out) != FALSE;
    CloseHandle(out);
    if (!writeOk || !MoveFileExW(temp.c_str(), target.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
        DeleteFileW(temp.c_str());
        info = L"Não consegui concluir a substituição. O arquivo original foi preservado; verifique permissões e caminho.";
        return false;
    }
    info = L"Pronto! O código-fonte foi substituído. Você pode compilá-lo no Windhawk. Backup: " + backup;
    return true;
}

void AddDroppedFile(const std::wstring& path) {
    if (path.empty()) return;
    DWORD attr = GetFileAttributesW(path.c_str());
    if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY)) {
        AppendText(L"[Anexo] Não consegui abrir o arquivo: " + FileNameOnly(path) + L"\r\n");
        return;
    }
    for (const auto& pending : g_pendingAttachments) if (_wcsicmp(pending.path.c_str(), path.c_str()) == 0) return;
    FileAttachment a = InspectAttachment(path);
    if (a.name.empty()) return;
    const std::wstring ext = FileExtensionLower(path);
    if (!a.textContent.empty() && a.size <= 2ull * 1024 * 1024 &&
        (ext == L".cpp" || ext == L".h" || ext == L".hpp" || ext == L".c" || ext == L".ino"))
        g_lastSourceCandidate = FromUtf8(a.textContent);
    g_pendingAttachments.push_back(std::move(a));
    const FileAttachment& added = g_pendingAttachments.back();
    std::wstring note = L"[Anexo preparado] " + added.name + L" (" + std::to_wstring(added.size / 1024) + L" KB)";
    if (!added.textExtracted && added.imageBase64.empty()) note += L" — arquivo reconhecido, mas o conteúdo não pôde ser extraído automaticamente";
    AppendText(note + L"\r\n");
    if (IsWindow(g_panel)) {
        if (!IsWindowVisible(g_panel)) ShowPanel();
        SetForegroundWindow(g_panel);
        SetFocus(g_input);
    }
}

void AddDroppedFilesFromHdrop(HDROP drop) {
    if (!drop) return;
    UINT count = DragQueryFileW(drop, 0xFFFFFFFF, nullptr, 0);
    for (UINT i = 0; i < count; ++i) {
        UINT n = DragQueryFileW(drop, i, nullptr, 0);
        if (!n) continue;
        std::wstring path(static_cast<size_t>(n) + 1, L'\0');
        DragQueryFileW(drop, i, &path[0], n + 1);
        path.resize(n);
        AddDroppedFile(path);
    }
    DragFinish(drop);
}

void OpenAttachmentDialog() {
    wchar_t buffer[32768] = {};
    OPENFILENAMEW ofn{};
    ofn.lStructSize = sizeof(ofn);
    ofn.hwndOwner = g_panel;
    ofn.lpstrFilter = L"Todos os arquivos (*.*)\0*.*\0\0";
    ofn.lpstrFile = buffer;
    ofn.nMaxFile = static_cast<DWORD>(sizeof(buffer) / sizeof(buffer[0]));
    ofn.Flags = OFN_EXPLORER | OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST | OFN_ALLOWMULTISELECT | OFN_HIDEREADONLY;
    ofn.lpstrTitle = L"Anexar arquivos ao AI Agent Bubble";
    g_inModal = true;
    const BOOL chosen = GetOpenFileNameW(&ofn);
    g_inModal = false;
    if (!chosen) return;
    std::wstring first(buffer);
    const wchar_t* next = buffer + first.size() + 1;
    if (*next == L'\0') {
        AddDroppedFile(first);
        return;
    }
    const std::wstring directory = first;
    while (*next) {
        std::wstring name(next);
        AddDroppedFile(directory + L"\\" + name);
        next += name.size() + 1;
    }
}


